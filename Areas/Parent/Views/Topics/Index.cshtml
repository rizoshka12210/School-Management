@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Lesson>

@{
    ViewData["Title"] = "Topics";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Topics Covered</h1>
        <p class="text-muted mb-0">@ViewBag.StudentName's group - topics already covered</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No topics recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Topic</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lesson in Model)
                            {
                                <tr>
                                    <td>@lesson.StartTime.ToString("dd.MM.yyyy")</td>
                                    <td>@lesson.Subject.Name</td>
                                    <td>@lesson.Topic</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
