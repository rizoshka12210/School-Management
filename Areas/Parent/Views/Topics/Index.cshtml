@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Lesson>

@{
    ViewData["Title"] = Localizer["Topics"];

    var totalTopics = Model.Count();
    var subjectsCount = Model.Select(l => l.SubjectId).Distinct().Count();
    var latestLesson = Model.OrderByDescending(l => l.StartTime).FirstOrDefault();
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Localizer["Topics Covered"]</h1>
        <p class="page-subtitle">@Localizer["Topics already covered by {0}'s group", ViewBag.StudentName]</p>
    </div>
    <div class="teacher-count-label">@Localizer["{0} topic(s)", totalTopics]</div>
</div>

<div class="parent-topic-stats">
    <div class="parent-topic-stat">
        <div class="parent-topic-stat-icon parent-topic-total"><i class="bi bi-book-half"></i></div>
        <div><span>@Localizer["Topics Covered"]</span><strong>@totalTopics</strong></div>
    </div>

    <div class="parent-topic-stat">
        <div class="parent-topic-stat-icon parent-topic-subject"><i class="bi bi-book-fill"></i></div>
        <div><span>@Localizer["Subjects"]</span><strong>@subjectsCount</strong></div>
    </div>

    <div class="parent-topic-stat parent-topic-latest">
        <div class="parent-topic-stat-icon parent-topic-date"><i class="bi bi-calendar3"></i></div>
        <div>
            <span>@Localizer["Latest Topic"]</span>
            <strong class="parent-topic-latest-text">
                @if (latestLesson != null)
                {
                    @latestLesson.StartTime.ToString("dd MMM yyyy")
                }
                else
                {
                    <text>—</text>
                }
            </strong>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Learning History"]</h5>
                <p class="section-subtitle">@Localizer["Topics recorded by teachers after lessons"]</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="parent-empty">
                <div class="parent-empty-icon"><i class="bi bi-book-half"></i></div>
                <h5>@Localizer["No topics recorded"]</h5>
                <p>@Localizer["Topics will appear here after teachers add them to lessons."]</p>
            </div>
        }
        else
        {
            <div class="parent-topic-timeline">
                @foreach (var lesson in Model.OrderByDescending(l => l.StartTime))
                {
                    <div class="parent-topic-row">
                        <div class="parent-topic-date-box">
                            <strong>@lesson.StartTime.ToString("dd")</strong>
                            <span>@lesson.StartTime.ToString("MMM")</span>
                        </div>

                        <div class="parent-topic-line"><div class="parent-topic-dot"></div></div>

                        <div class="parent-topic-content">
                            <div class="parent-topic-content-header">
                                <span class="subject-badge">@lesson.Subject.Name</span>
                                <span class="parent-topic-full-date">@lesson.StartTime.ToString("dd MMM yyyy")</span>
                            </div>
                            <h5>@lesson.Topic</h5>
                            <span class="parent-topic-time">@Localizer["Lesson at {0}", lesson.StartTime.ToString("HH:mm")]</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>