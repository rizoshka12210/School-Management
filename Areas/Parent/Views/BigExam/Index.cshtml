@model List<SchoolManagementSystem.Web.Services.BigExamRankingEntry>

@{
    ViewData["Title"] = Localizer["Big Exam"];
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Localizer["Big Exam"]</h1>
        <p class="page-subtitle">@Localizer["{0}'s results in the periodic school-wide exam", ViewBag.StudentName]</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="parent-empty">
                <div class="parent-empty-icon"><i class="bi bi-award"></i></div>
                <h5>@Localizer["No Big Exam results yet"]</h5>
                <p>@Localizer["Big Exam scores will appear here once graded."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Title"]</th>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Score"]</th>
                            <th>@Localizer["Group Rank"]</th>
                            <th>@Localizer["Overall Rank"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.OrderByDescending(e => e.BigExamDate))
                        {
                            <tr>
                                <td><strong>@entry.BigExamTitle</strong></td>
                                <td><div class="record-date">@entry.BigExamDate.ToString("dd MMM yyyy")</div></td>
                                <td>
                                    <span class="grade-badge @(entry.Score >= 90 ? "grade-high" : entry.Score >= 75 ? "grade-good" : "grade-low")">
                                        @entry.Score.ToString("0.##")
                                    </span>
                                </td>
                                <td><span class="status-badge status-present">#@entry.GroupRank @Localizer["of {0}", entry.GroupSize]</span> <span class="text-muted">(@entry.GroupName)</span></td>
                                <td><span class="status-badge status-present">#@entry.OverallRank @Localizer["of {0}", entry.OverallSize]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
