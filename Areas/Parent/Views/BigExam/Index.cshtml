@model List<SchoolManagementSystem.Web.Services.BigExamRankingEntry>
@using SchoolManagementSystem.Web.Models.Entities

@{
    ViewData["Title"] = Localizer["Big Exam"];

    var allExams = ViewBag.Exams as List<BigExam> ?? new List<BigExam>();
    var byExam = Model
        .GroupBy(e => e.BigExamId)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Localizer["Big Exam"]</h1>
        <p class="page-subtitle">@Localizer["{0}'s results in the periodic school-wide exam", ViewBag.StudentName]</p>
    </div>
</div>

@if (!allExams.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="parent-empty">
                <div class="parent-empty-icon"><i class="bi bi-award"></i></div>
                <h5>@Localizer["No Big Exam results yet"]</h5>
                <p>@Localizer["Big Exam scores will appear here once graded."]</p>
            </div>
        </div>
    </div>
}
else
{
    @foreach (var exam in allExams.OrderByDescending(e => e.Date))
    {
        var entries = byExam.TryGetValue(exam.Id, out var list) ? list : new List<SchoolManagementSystem.Web.Services.BigExamRankingEntry>();

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title">@exam.Title</h5>
                        <p class="section-subtitle">@exam.Date.ToString("dd MMM yyyy")</p>
                    </div>
                    <a asp-action="Rankings" asp-route-examId="@exam.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-bar-chart-fill"></i>
                        @Localizer["View all students' rankings"]
                    </a>
                </div>

                @if (!entries.Any())
                {
                    <p class="text-muted small mb-0">@Localizer["No score for {0} in this Big Exam yet.", ViewBag.StudentName]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover management-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Subject"]</th>
                                    <th>@Localizer["Score"]</th>
                                    <th>@Localizer["Group Rank"]</th>
                                    <th>@Localizer["Overall Rank"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in entries.OrderBy(e => e.SubjectId == null).ThenBy(e => e.SubjectName))
                                {
                                    <tr class="@(entry.SubjectId == null ? "fw-bold" : "")">
                                        <td>
                                            @if (entry.SubjectId == null)
                                            {
                                                <span class="status-badge status-present">@Localizer["Overall Total"]</span>
                                            }
                                            else
                                            {
                                                <span class="subject-badge">@entry.SubjectName</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="grade-badge @(entry.Score >= 90 ? "grade-high" : entry.Score >= 75 ? "grade-good" : "grade-low")">
                                                @entry.Score.ToString("0.##")
                                            </span>
                                        </td>
                                        <td><span class="status-badge status-present">#@entry.GroupRank @Localizer["of {0}", entry.GroupSize]</span></td>
                                        <td><span class="status-badge status-present">#@entry.OverallRank @Localizer["of {0}", entry.OverallSize]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}
