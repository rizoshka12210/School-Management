@model List<SchoolManagementSystem.Web.ViewModels.Parent.SubjectWithTeachers>

@{
    ViewData["Title"] = "Subjects";

    var teachersCount = Model
        .SelectMany(s => s.TeacherNames)
        .Distinct()
        .Count();
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Subjects
        </h1>

        <p class="page-subtitle">
            @ViewBag.StudentName's subjects and teachers
        </p>

    </div>

    <div class="teacher-count-label">
        @Model.Count subject(s)
    </div>

</div>

<div class="parent-subject-summary">

    <div>

        <div class="parent-subject-summary-icon">
            SB
        </div>

        <div>

            <span>
                Total Subjects
            </span>

            <strong>
                @Model.Count
            </strong>

        </div>

    </div>

    <div>

        <div class="parent-subject-summary-icon parent-subject-teacher-icon">
            TR
        </div>

        <div>

            <span>
                Teachers
            </span>

            <strong>
                @teachersCount
            </strong>

        </div>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">

        <div class="parent-empty">

            <div class="parent-empty-icon">
                SB
            </div>

            <h5>
                No subjects yet
            </h5>

            <p>
                Subjects will appear here when the schedule is created.
            </p>

        </div>

    </div>
}
else
{
    <div class="parent-subject-grid">

        @foreach (var subject in Model)
        {
            <div class="parent-subject-card">

                <div class="parent-subject-card-top">

                    <div class="parent-subject-card-icon">
                        SB
                    </div>

                    <div class="parent-subject-card-badge">
                        Subject
                    </div>

                </div>

                <h4>
                    @subject.SubjectName
                </h4>

                <p>
                    @subject.TeacherNames.Count teacher(s)
                </p>

                <div class="parent-subject-teachers">

                    <div class="parent-subject-teachers-title">
                        Teachers
                    </div>

                    @if (!subject.TeacherNames.Any())
                    {
                        <div class="text-muted small">
                            No teachers assigned
                        </div>
                    }
                    else
                    {
                        @foreach (var teacher in subject.TeacherNames)
                        {
                            <div class="parent-subject-teacher">

                                <div class="mini-avatar">

                                    @(string.IsNullOrWhiteSpace(teacher)
                                        ? "T"
                                        : teacher.Substring(0, 1).ToUpper())

                                </div>

                                <span>
                                    @teacher
                                </span>

                            </div>
                        }
                    }

                </div>

            </div>
        }

    </div>
}