@using System.Globalization
@model SchoolManagementSystem.Web.ViewModels.Parent.GroupComparisonChartViewModel

@{
    var inv = CultureInfo.InvariantCulture;

    const int width = 640;
    const int height = 220;
    const int padTop = 16;
    const int padBottom = 30;
    const int padLeft = 30;
    const int padRight = 16;

    const double minValue = 0.0;
    const double maxValue = 100.0;
    const double gridStep = 20.0;

    var count = Model.PointLabels.Count;

    var plotWidth = width - padLeft - padRight;
    var plotHeight = height - padTop - padBottom;

    string X(int i) => (count <= 1
        ? padLeft
        : padLeft + i * plotWidth / (double)(count - 1))
        .ToString("0.##", inv);

    string Y(double value)
    {
        var clamped = Math.Max(minValue, Math.Min(maxValue, value));

        var y = padTop + plotHeight -
            (clamped - minValue) / (maxValue - minValue) * plotHeight;

        return y.ToString("0.##", inv);
    }

    string BuildPolyline(List<double?> values)
    {
        var points = new List<string>();

        for (var i = 0; i < count; i++)
        {
            var value = i < values.Count ? values[i] : null;

            if (value.HasValue)
            {
                points.Add($"{X(i)},{Y(value.Value)}");
            }
        }

        return string.Join(" ", points);
    }

    // Every student gets its own color (cycling through a fixed palette)
    // so each classmate's line and legend entry are individually
    // identifiable, matching the group journal chart students already
    // see in the register app - the child still gets a bolder line.
    string ColorClass(int index, bool isChild) => isChild
        ? "line-chart-color-child"
        : $"line-chart-color-{index % 8}";

    var classmates = Model.Series.Where(s => !s.IsChild).ToList();
    var child = Model.Series.FirstOrDefault(s => s.IsChild);

    var legendOrder = Model.Series
        .OrderByDescending(s => s.AverageValue ?? -1)
        .ToList();
}

<div class="line-chart-wrap">

    <div class="line-chart-legend">
        @foreach (var entry in legendOrder)
        {
            var index = classmates.IndexOf(entry);

            <span class="line-chart-legend-item @(entry.IsChild ? "is-child" : "")">
                <span class="line-chart-legend-swatch @ColorClass(index, entry.IsChild)"></span>
                @entry.StudentName@(entry.AverageValue.HasValue ? $" - {entry.AverageValue.Value.ToString("0", inv)}" : "")
                @if (entry.IsChild)
                {
                    <text>(@Localizer["Your child"])</text>
                }
            </span>
        }
    </div>

    <svg viewBox="0 0 @width @height"
         class="line-chart"
         xmlns="http://www.w3.org/2000/svg"
         preserveAspectRatio="xMidYMid meet">

        @for (var grid = minValue; grid <= maxValue; grid += gridStep)
        {
            <line x1="@padLeft.ToString(inv)"
                  y1="@Y(grid)"
                  x2="@((width - padRight).ToString(inv))"
                  y2="@Y(grid)"
                  class="line-chart-grid" />

            @Html.Raw(
                $"<text x=\"4\" y=\"{Y(grid)}\" class=\"line-chart-axis-label\">{grid:0}</text>")
        }

        @for (var i = 0; i < classmates.Count; i++)
        {
            var classmate = classmates[i];
            var points = BuildPolyline(classmate.Values);

            if (!string.IsNullOrEmpty(points))
            {
                <polyline points="@points"
                          class="line-chart-series @ColorClass(i, false)"
                          fill="none">
                    <title>@classmate.StudentName</title>
                </polyline>
            }
        }

        @if (child != null)
        {
            var childPoints = BuildPolyline(child.Values);

            if (!string.IsNullOrEmpty(childPoints))
            {
                <polyline points="@childPoints"
                          class="line-chart-series line-chart-series-child line-chart-color-child"
                          fill="none">
                    <title>@child.StudentName</title>
                </polyline>
            }
        }

        @for (var i = 0; i < classmates.Count; i++)
        {
            var classmate = classmates[i];

            for (var p = 0; p < count; p++)
            {
                var value = p < classmate.Values.Count ? classmate.Values[p] : null;

                if (value.HasValue)
                {
                    <circle cx="@X(p)"
                            cy="@Y(value.Value)"
                            r="3"
                            class="line-chart-dot @ColorClass(i, false)">
                        <title>@classmate.StudentName</title>
                    </circle>
                }
            }
        }

        @if (child != null)
        {
            for (var i = 0; i < count; i++)
            {
                var value = i < child.Values.Count ? child.Values[i] : null;

                if (value.HasValue)
                {
                    <circle cx="@X(i)"
                            cy="@Y(value.Value)"
                            r="4"
                            class="line-chart-dot line-chart-dot-child line-chart-color-child" />
                }
            }
        }

        @for (var i = 0; i < count; i++)
        {
            var xLabel = System.Net.WebUtility.HtmlEncode(Model.PointLabels[i]);

            @Html.Raw(
                $"<text x=\"{X(i)}\" y=\"{(height - 6).ToString(inv)}\" class=\"line-chart-x-label\">{xLabel}</text>")
        }

    </svg>

</div>
