@model SchoolManagementSystem.Web.Models.Entities.Student

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h1>
            <p class="text-muted mb-0">
                Group: @(Model.Group?.Name ?? "-") &middot;
                Date of birth: @Model.DateOfBirth.ToString("dd.MM.yyyy")
            </p>
        </div>
        <a asp-area="Parent" asp-controller="Dashboard" asp-action="Index"
           class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Attendance</h6>
                    <h3 class="fw-bold">@ViewBag.AttendanceRate%</h3>
                    <p class="text-muted small mb-0">
                        @ViewBag.PresentCount / @ViewBag.TotalLessons lessons
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Average Grade</h6>
                    <h3 class="fw-bold">@ViewBag.AverageGrade</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Parent" asp-controller="Schedule" asp-action="Index"
           asp-route-studentId="@Model.Id" class="btn btn-outline-primary">Schedule</a>
        <a asp-area="Parent" asp-controller="Grades" asp-action="Index"
           asp-route-studentId="@Model.Id" class="btn btn-outline-primary">Grades</a>
        <a asp-area="Parent" asp-controller="Attendance" asp-action="Index"
           asp-route-studentId="@Model.Id" class="btn btn-outline-primary">Attendance</a>
        <a asp-area="Parent" asp-controller="Subjects" asp-action="Index"
           asp-route-studentId="@Model.Id" class="btn btn-outline-primary">Subjects</a>
        <a asp-area="Parent" asp-controller="Topics" asp-action="Index"
           asp-route-studentId="@Model.Id" class="btn btn-outline-primary">Topics</a>
    </div>

</div>
