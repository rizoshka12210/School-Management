@model SchoolManagementSystem.Web.Models.Entities.Student

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";

    double attendanceRate = Convert.ToDouble(ViewBag.AttendanceRate);
    double averageGrade = Convert.ToDouble(ViewBag.AverageGrade);
    int presentCount = Convert.ToInt32(ViewBag.PresentCount);
    int totalLessons = Convert.ToInt32(ViewBag.TotalLessons);

    var age = DateTime.UtcNow.Year - Model.DateOfBirth.Year;
    if (Model.DateOfBirth.Date > DateTime.UtcNow.AddYears(-age).Date)
    {
        age--;
    }
}

<div class="parent-child-details-header">
    <a asp-area="Parent" asp-controller="Dashboard" asp-action="Index" class="back-link">← @Localizer["Dashboard"]</a>

    <div class="parent-student-profile">
        <div class="parent-student-avatar">
            @(string.IsNullOrWhiteSpace(Model.FirstName)
                ? "S"
                : Model.FirstName.Substring(0, 1).ToUpper())
        </div>

        <div>
            <h1 class="page-title mb-1">@Model.FirstName @Model.LastName</h1>
            <div class="parent-student-meta">
                @if (Model.Group != null)
                {
                    <span class="group-badge">@Model.Group.Name</span>
                }
                <span>@Localizer["Student #{0}", Model.Id]</span>
            </div>
        </div>
    </div>
</div>

<div class="parent-student-stats">
    <div class="parent-student-stat">
        <div class="parent-student-stat-icon parent-attendance-icon">AT</div>
        <div>
            <span>@Localizer["Attendance"]</span>
            <strong>@attendanceRate.ToString("0.#")%</strong>
            <small>@Localizer["{0} of {1} present", presentCount, totalLessons]</small>
        </div>
    </div>

    <div class="parent-student-stat">
        <div class="parent-student-stat-icon parent-grade-icon">GD</div>
        <div>
            <span>@Localizer["Average Grade"]</span>
            <strong>@averageGrade.ToString("0.##")</strong>
            <small>@Localizer["Overall Average"]</small>
        </div>
    </div>

    <div class="parent-student-stat">
        <div class="parent-student-stat-icon parent-lessons-icon">LS</div>
        <div>
            <span>@Localizer["Lessons"]</span>
            <strong>@totalLessons</strong>
            <small>@Localizer["Attendance records"]</small>
        </div>
    </div>

    <div class="parent-student-stat">
        <div class="parent-student-stat-icon parent-age-icon">AG</div>
        <div>
            <span>@Localizer["Age"]</span>
            <strong>@age</strong>
            <small>@Localizer["years old"]</small>
        </div>
    </div>
</div>

<div class="form-card mb-4">
    <div class="form-card-header">
        <h5>@Localizer["Achievements"]</h5>
    </div>

    <div class="form-card-body">
        <partial name="_AchievementBadges" model="ViewBag.Achievements" />
    </div>
</div>

<div class="parent-details-grid">
    <div class="form-card">
        <div class="form-card-header">
            <h5>@Localizer["Student Information"]</h5>
            <p>@Localizer["General information about your child"]</p>
        </div>

        <div class="form-card-body">
            <div class="parent-info-row">
                <span>@Localizer["Full Name"]</span>
                <strong>@Model.FirstName @Model.LastName</strong>
            </div>

            <div class="parent-info-row">
                <span>@Localizer["Group"]</span>
                <strong>@(Model.Group != null ? Model.Group.Name : Localizer["No group"].Value)</strong>
            </div>

            <div class="parent-info-row">
                <span>@Localizer["Date of Birth"]</span>
                <strong>@Model.DateOfBirth.ToString("dd MMMM yyyy")</strong>
            </div>

            <div class="parent-info-row">
                <span>@Localizer["Student ID"]</span>
                <strong>#@Model.Id</strong>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-header">
            <h5>@Localizer["Academic Access"]</h5>
            <p>@Localizer["Quickly open your child's school information"]</p>
        </div>

        <div class="form-card-body">
            <div class="parent-access-grid">
                <a asp-area="Parent" asp-controller="Schedule" asp-action="Index" asp-route-studentId="@Model.Id" class="parent-access-card">
                    <div class="parent-access-icon parent-action-schedule">SC</div>
                    <div><strong>@Localizer["Schedule"]</strong><span>@Localizer["Weekly timetable"]</span></div>
                    <div class="parent-access-arrow">→</div>
                </a>

                <a asp-area="Parent" asp-controller="Grades" asp-action="Index" asp-route-studentId="@Model.Id" class="parent-access-card">
                    <div class="parent-access-icon parent-action-grades">GD</div>
                    <div><strong>@Localizer["Grades"]</strong><span>@Localizer["Grade History"]</span></div>
                    <div class="parent-access-arrow">→</div>
                </a>

                <a asp-area="Parent" asp-controller="Attendance" asp-action="Index" asp-route-studentId="@Model.Id" class="parent-access-card">
                    <div class="parent-access-icon parent-action-attendance">AT</div>
                    <div><strong>@Localizer["Attendance"]</strong><span>@Localizer["Attendance History"]</span></div>
                    <div class="parent-access-arrow">→</div>
                </a>

                <a asp-area="Parent" asp-controller="Subjects" asp-action="Index" asp-route-studentId="@Model.Id" class="parent-access-card">
                    <div class="parent-access-icon parent-action-subject">SB</div>
                    <div><strong>@Localizer["Subjects"]</strong><span>@Localizer["School subjects"]</span></div>
                    <div class="parent-access-arrow">→</div>
                </a>

                <a asp-area="Parent" asp-controller="Topics" asp-action="Index" asp-route-studentId="@Model.Id" class="parent-access-card">
                    <div class="parent-access-icon parent-action-topic">TP</div>
                    <div><strong>@Localizer["Topics"]</strong><span>@Localizer["Lesson Topics"]</span></div>
                    <div class="parent-access-arrow">→</div>
                </a>

                <a asp-area="Parent" asp-controller="Progress" asp-action="Index" asp-route-studentId="@Model.Id" class="parent-access-card">
                    <div class="parent-access-icon parent-action-progress">PR</div>
                    <div><strong>@Localizer["Progress"]</strong><span>@Localizer["Overall performance"]</span></div>
                    <div class="parent-access-arrow">→</div>
                </a>
            </div>
        </div>
    </div>
</div>