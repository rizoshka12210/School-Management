@model List<SchoolManagementSystem.Web.ViewModels.Shared.ExamRankingEntry>
@using SchoolManagementSystem.Web.Models.Entities

@{
    var subjects = ViewBag.Subjects as List<Subject> ?? new List<Subject>();
    int? subjectId = ViewBag.SubjectId;
    ViewData["Title"] = subjects.FirstOrDefault(s => s.Id == subjectId)?.Name;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link">← @Localizer["Grades"]</a>
        <h1 class="page-title mt-2">@Localizer["Rankings"]</h1>
        <p class="page-subtitle">@Localizer["Student's place by group and across the whole center"]</p>
    </div>
</div>

<div class="teacher-grade-subject-tabs mb-4">
    @foreach (var subject in subjects)
    {
        <a asp-action="Rankings" asp-route-subjectId="@subject.Id" class="teacher-grade-subject-tab @(subjectId == subject.Id ? "active" : "")">
            @subject.Name
        </a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <partial name="_ExamRankingsSections" model="Model" />
    </div>
</div>
