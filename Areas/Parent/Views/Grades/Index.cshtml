@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Grade>

@{
    ViewData["Title"] = "Grades";
    var averages = ViewBag.AverageBySubject as Dictionary<string, double> ?? new();
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Grades</h1>
        <p class="text-muted mb-0">@ViewBag.StudentName's grade history</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Overall Average</h6>
                    <h2 class="fw-bold">@ViewBag.OverallAverage</h2>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Average by Subject</h6>
                    @if (!averages.Any())
                    {
                        <span class="text-muted">No grades yet</span>
                    }
                    else
                    {
                        @foreach (var pair in averages)
                        {
                            <span class="badge bg-primary-subtle text-primary-emphasis me-1 mb-1">
                                @pair.Key: @pair.Value
                            </span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No grades recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Teacher</th>
                                <th>Grade</th>
                                <th>Comment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grade in Model)
                            {
                                <tr>
                                    <td>@grade.Date.ToString("dd.MM.yyyy")</td>
                                    <td>@grade.Subject.Name</td>
                                    <td>@grade.Teacher.ApplicationUser.FullName</td>
                                    <td><span class="badge bg-primary">@grade.Value</span></td>
                                    <td>@grade.Comment</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
