@model SchoolManagementSystem.Web.ViewModels.Parent.ParentDashboardViewModel

@{
    ViewData["Title"] = "Parent Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Parent Dashboard</h1>
        <p class="text-muted">Overview of your children</p>
    </div>

    @if (!Model.Children.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No children linked to your account yet</h5>
                <p class="text-muted mb-0">
                    Contact the school administration if this looks wrong.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var child in Model.Children)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h4 class="fw-bold mb-0">@child.FullName</h4>
                                    <span class="text-muted">Group: @child.GroupName</span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <h6 class="text-muted mb-0">Attendance</h6>
                                    <h3 class="fw-bold">@child.AttendanceRate%</h3>
                                </div>
                                <div class="col-6">
                                    <h6 class="text-muted mb-0">Average Grade</h6>
                                    <h3 class="fw-bold">@child.AverageGrade</h3>
                                </div>
                            </div>

                            @if (child.RecentGrades.Any())
                            {
                                <h6 class="text-muted">Recent Grades</h6>
                                <ul class="list-group list-group-flush mb-3">
                                    @foreach (var grade in child.RecentGrades)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span>@grade.SubjectName &middot; @grade.Date.ToString("dd.MM.yyyy")</span>
                                            <span class="badge bg-primary">@grade.Value</span>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="d-flex flex-wrap gap-2">
                                <a asp-area="Parent" asp-controller="Child" asp-action="Details"
                                   asp-route-studentId="@child.StudentId"
                                   class="btn btn-sm btn-outline-primary">Profile</a>
                                <a asp-area="Parent" asp-controller="Schedule" asp-action="Index"
                                   asp-route-studentId="@child.StudentId"
                                   class="btn btn-sm btn-outline-secondary">Schedule</a>
                                <a asp-area="Parent" asp-controller="Grades" asp-action="Index"
                                   asp-route-studentId="@child.StudentId"
                                   class="btn btn-sm btn-outline-secondary">Grades</a>
                                <a asp-area="Parent" asp-controller="Attendance" asp-action="Index"
                                   asp-route-studentId="@child.StudentId"
                                   class="btn btn-sm btn-outline-secondary">Attendance</a>
                                <a asp-area="Parent" asp-controller="Subjects" asp-action="Index"
                                   asp-route-studentId="@child.StudentId"
                                   class="btn btn-sm btn-outline-secondary">Subjects</a>
                                <a asp-area="Parent" asp-controller="Topics" asp-action="Index"
                                   asp-route-studentId="@child.StudentId"
                                   class="btn btn-sm btn-outline-secondary">Topics</a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
