@model SchoolManagementSystem.Web.ViewModels.Parent.ParentDashboardViewModel

@{
    ViewData["Title"] = Localizer["Parent Dashboard"];
}

<div class="parent-dashboard-header">

    <div>
        <div class="parent-welcome-label">
            @Localizer["Family Portal"]
        </div>

        <h1 class="page-title">
            @Localizer["Parent Dashboard"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Follow your children's academic progress and attendance"]
        </p>
    </div>

    <div class="dashboard-date">
        <i class="bi bi-calendar3 me-2"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </div>

</div>

@if (!Model.Children.Any())
{
    <div class="card border-0 shadow-sm">

        <div class="parent-empty">

            <div class="parent-empty-icon">
                <i class="bi bi-person-hearts"></i>
            </div>

            <h5>
                @Localizer["No children linked"]
            </h5>

            <p>
                @Localizer["No students are currently connected to your parent account."]
            </p>

        </div>

    </div>
}
else
{
    <div class="parent-summary-bar">

        <div>

            <span>
                <i class="bi bi-people-fill me-1"></i>@Localizer["Children"]
            </span>

            <strong>
                @Model.Children.Count
            </strong>

        </div>

        <div>

            <span>
                <i class="bi bi-clipboard2-check-fill me-1"></i>@Localizer["Average Attendance"]
            </span>

            <strong>
                @Model.Children.Average(c => c.AttendanceRate).ToString("0.#")%
            </strong>

        </div>

        <div>

            <span>
                <i class="bi bi-award-fill me-1"></i>@Localizer["Average Grade"]
            </span>

            <strong>
                @Model.Children.Average(c => c.AverageGrade).ToString("0.##")
            </strong>

        </div>

    </div>

    <div class="parent-children-grid">

        @foreach (var child in Model.Children)
        {
            <div class="parent-child-card">

                <div class="parent-child-header">

                    <div class="parent-child-profile">

                        <div class="parent-child-avatar">

                            @(string.IsNullOrWhiteSpace(child.FullName)
                                ? "S"
                                : child.FullName.Substring(0, 1).ToUpper())

                        </div>

                        <div>

                            <h4>
                                @child.FullName
                            </h4>

                            <span>
                                @child.GroupName
                            </span>

                        </div>

                    </div>

                    <a asp-area="Parent"
                       asp-controller="Child"
                       asp-action="Details"
                       asp-route-studentId="@child.StudentId"
                       class="parent-profile-link">
                        @Localizer["View Profile →"]
                    </a>

                </div>

                <div class="parent-child-stats">

                    <div class="parent-child-stat">

                        <div class="parent-child-stat-icon parent-attendance-icon">
                            <i class="bi bi-clipboard2-check-fill"></i>
                        </div>

                        <div>

                            <span>
                                @Localizer["Attendance"]
                            </span>

                            <strong>
                                @child.AttendanceRate.ToString("0.#")%
                            </strong>

                        </div>

                    </div>

                    <div class="parent-child-stat">

                        <div class="parent-child-stat-icon parent-grade-icon">
                            <i class="bi bi-journal-check"></i>
                        </div>

                        <div>

                            <span>
                                @Localizer["Average Grade"]
                            </span>

                            <strong>
                                @child.AverageGrade.ToString("0.##")
                            </strong>

                        </div>

                    </div>

                    <div class="parent-child-stat">

                        <div class="parent-child-stat-icon parent-lessons-icon">
                            <i class="bi bi-easel2-fill"></i>
                        </div>

                        <div>

                            <span>
                                @Localizer["Lessons Today"]
                            </span>

                            <strong>
                                @child.LessonsTodayCount
                            </strong>

                        </div>

                    </div>

                </div>

                @if (child.RecentMissedLesson != null)
                {
                    <div class="parent-missed-alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @Localizer["Missed {0} — {1}", child.RecentMissedLesson.SubjectName, child.RecentMissedLesson.Date.ToString("dd MMM")]
                    </div>
                }

                <div class="parent-card-section">

                    <div class="parent-card-section-header">

                        <span>
                            @Localizer["Recent Grades"]
                        </span>

                        <a asp-area="Parent"
                           asp-controller="Grades"
                           asp-action="Index"
                           asp-route-studentId="@child.StudentId">
                            @Localizer["View All"]
                        </a>

                    </div>

                    @if (!child.RecentGrades.Any())
                    {
                        <div class="parent-no-grades">
                            @Localizer["No grades recorded yet."]
                        </div>
                    }
                    else
                    {
                        <div class="parent-recent-grades">

                            @foreach (var grade in child.RecentGrades)
                            {
                                <div class="parent-recent-grade">

                                    <div>

                                        <strong>
                                            @grade.SubjectName
                                        </strong>

                                        <span>
                                            @grade.Date.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                    @if (grade.Value >= 90)
                                    {
                                        <span class="grade-badge grade-high">
                                            @grade.Value
                                        </span>
                                    }
                                    else if (grade.Value >= 75)
                                    {
                                        <span class="grade-badge grade-good">
                                            @grade.Value
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grade-badge grade-low">
                                            @grade.Value
                                        </span>
                                    }

                                </div>
                            }

                        </div>
                    }

                </div>

                <div class="parent-child-actions">

                    <a asp-area="Parent"
                       asp-controller="Schedule"
                       asp-action="Index"
                       asp-route-studentId="@child.StudentId"
                       class="parent-child-action">
                        <span class="parent-action-icon parent-action-schedule">
                            <i class="bi bi-calendar3-week-fill"></i>
                        </span>
                        @Localizer["Schedule"]
                    </a>

                    <a asp-area="Parent"
                       asp-controller="Grades"
                       asp-action="Index"
                       asp-route-studentId="@child.StudentId"
                       class="parent-child-action">
                        <span class="parent-action-icon parent-action-grades">
                            <i class="bi bi-journal-check"></i>
                        </span>
                        @Localizer["Grades"]
                    </a>

                    <a asp-area="Parent"
                       asp-controller="Attendance"
                       asp-action="Index"
                       asp-route-studentId="@child.StudentId"
                       class="parent-child-action">
                        <span class="parent-action-icon parent-action-attendance">
                            <i class="bi bi-clipboard2-check-fill"></i>
                        </span>
                        @Localizer["Attendance"]
                    </a>

                    <a asp-area="Parent"
                       asp-controller="Progress"
                       asp-action="Index"
                       asp-route-studentId="@child.StudentId"
                       class="parent-child-action">
                        <span class="parent-action-icon parent-action-progress">
                            <i class="bi bi-graph-up-arrow"></i>
                        </span>
                        @Localizer["Progress"]
                    </a>

                </div>

            </div>
        }

    </div>
}

<div class="card border-0 shadow-sm mt-4">

    <div class="card-body">

        <div class="section-header">

            <div>
                <h5 class="section-title"><i class="bi bi-calendar-event-fill section-title-icon"></i>@Localizer["Upcoming Events"]</h5>
                <p class="section-subtitle">@Localizer["From the school calendar"]</p>
            </div>

            <a asp-area="Parent"
               asp-controller="Calendar"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                @Localizer["View All"]
            </a>

        </div>

        @if (!Model.UpcomingEvents.Any())
        {
            <div class="dashboard-empty"><p>@Localizer["No upcoming events."]</p></div>
        }
        else
        {
            <div class="performance-list">
                @foreach (var evt in Model.UpcomingEvents)
                {
                    <div class="performance-item">
                        <span class="performance-rank">@evt.Date.ToString("dd MMM")</span>
                        <div class="performance-main">
                            <strong>@evt.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(evt.Description))
                            {
                                <small>@evt.Description</small>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>

</div>
