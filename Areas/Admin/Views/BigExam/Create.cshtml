@model SchoolManagementSystem.Web.ViewModels.Admin.BigExamFormViewModel

@{
    ViewData["Title"] = Localizer["New Big Exam"];
}

<div class="form-page-header">
    <a asp-action="Index" class="back-link">← @Localizer["Big Exam"]</a>
    <h1 class="page-title mt-2">@Localizer["New Big Exam"]</h1>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light">@Localizer["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
