@model SchoolManagementSystem.Web.Models.Entities.BigExam

@{
    ViewData["Title"] = Localizer["Delete Big Exam"];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h2 class="text-danger fw-bold">@Localizer["Delete Big Exam"]</h2>

                    <p class="mt-3">@Localizer["Are you sure you want to delete this Big Exam? All grades and history for it will be deleted too."]</p>

                    <hr />

                    <p><strong>@Localizer["Title"]:</strong> @Model.Title</p>
                    <p><strong>@Localizer["Date"]:</strong> @Model.Date.ToString("dd MMMM yyyy")</p>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">@Localizer["Yes, Delete"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
