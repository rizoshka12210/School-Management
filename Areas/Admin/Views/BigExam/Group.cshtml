@model SchoolManagementSystem.Web.ViewModels.Shared.BigExamGroupSheetViewModel
@using System.Globalization

@{
    ViewData["Title"] = Model.BigExamTitle;

    string GradeClass(decimal? value, decimal max) => value switch
    {
        null => string.Empty,
        _ when max > 0 && value >= max * 0.9m => "grade-high",
        _ when max > 0 && value >= max * 0.75m => "grade-good",
        _ => "grade-low"
    };
}

<div class="page-header">
    <div>
        <a asp-action="Groups" asp-route-examId="@Model.BigExamId" class="back-link">← @Model.BigExamTitle</a>
        <h1 class="page-title mt-2">@Model.GroupName</h1>
        <p class="page-subtitle">@Localizer["Big Exam scores - every subject for this group"]</p>
    </div>

    <a asp-action="Rankings" asp-route-examId="@Model.BigExamId" class="btn btn-outline-primary">
        <i class="bi bi-bar-chart-fill"></i>
        @Localizer["Rankings"]
    </a>
</div>

@if (User.IsInRole("Admin"))
{
<form asp-action="Group" method="post" id="bigExamSheetForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BigExamId" value="@Model.BigExamId" />
    <input type="hidden" name="GroupId" value="@Model.GroupId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (!Model.Rows.Any())
            {
                <div class="teacher-empty">
                    <div class="teacher-empty-icon"><i class="bi bi-people-fill"></i></div>
                    <h5>@Localizer["No students"]</h5>
                    <p>@Localizer["This group does not have any students."]</p>
                </div>
            }
            else if (!Model.Subjects.Any())
            {
                <div class="teacher-empty">
                    <div class="teacher-empty-icon"><i class="bi bi-book"></i></div>
                    <h5>@Localizer["No subjects yet"]</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover management-table exam-grades-table big-exam-sheet-table">
                        <thead>
                            <tr>
                                <th rowspan="2">@Localizer["Student"]</th>
                                @foreach (var subject in Model.Subjects)
                                {
                                    <th colspan="2" class="text-center">@subject.SubjectName</th>
                                }
                                <th rowspan="2">@Localizer["Total Score"]</th>
                            </tr>
                            <tr>
                                @foreach (var subject in Model.Subjects)
                                {
                                    <th class="text-center small text-muted">@Localizer["Raw"] / @subject.MaxRawScore.ToString("0.##")</th>
                                    <th class="text-center small text-muted">@Localizer["Score"] / @subject.MaxWeightedScore.ToString("0.##")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];

                                <tr data-row="@i">
                                    <td>
                                        <input type="hidden" name="Rows[@i].StudentId" value="@row.StudentId" />
                                        <div class="teacher-attendance-student">
                                            <div class="person-avatar">
                                                @(string.IsNullOrWhiteSpace(row.StudentName) ? "S" : row.StudentName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div><strong>@row.StudentName</strong></div>
                                        </div>
                                    </td>
                                    @for (var j = 0; j < row.Cells.Count; j++)
                                    {
                                        var cell = row.Cells[j];

                                        <td>
                                            <input type="hidden" name="Rows[@i].Cells[@j].SubjectId" value="@cell.SubjectId" />
                                            <input type="text"
                                                   inputmode="decimal"
                                                   name="Rows[@i].Cells[@j].RawScore"
                                                   class="form-control big-exam-raw-input"
                                                   data-row="@i"
                                                   data-max-raw="@cell.MaxRawScore.ToString(CultureInfo.InvariantCulture)"
                                                   data-max-weighted="@cell.MaxWeightedScore.ToString(CultureInfo.InvariantCulture)"
                                                   placeholder="0-@cell.MaxRawScore.ToString("0.##")"
                                                   value="@(cell.RawScore?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                                        </td>
                                        <td>
                                            <strong class="big-exam-weighted" data-row="@i">
                                                @(cell.WeightedScore?.ToString("0.###", CultureInfo.InvariantCulture) ?? "—")
                                            </strong>
                                        </td>
                                    }
                                    <td>
                                        <strong class="big-exam-total" data-row="@i">
                                            @row.TotalWeightedScore.ToString("0.###", CultureInfo.InvariantCulture)
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        @Localizer["Save Grades"]
                    </button>
                </div>
            }
        </div>
    </div>
</form>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table management-table big-exam-sheet-table">
                    <thead>
                        <tr>
                            <th rowspan="2">@Localizer["Student"]</th>
                            @foreach (var subject in Model.Subjects)
                            {
                                <th colspan="2" class="text-center">@subject.SubjectName</th>
                            }
                            <th rowspan="2">@Localizer["Total Score"]</th>
                        </tr>
                        <tr>
                            @foreach (var subject in Model.Subjects)
                            {
                                <th class="text-center small text-muted">@Localizer["Raw"] / @subject.MaxRawScore.ToString("0.##")</th>
                                <th class="text-center small text-muted">@Localizer["Score"] / @subject.MaxWeightedScore.ToString("0.##")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.StudentName</td>
                                @foreach (var cell in row.Cells)
                                {
                                    <td>@(cell.RawScore?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                    <td><span class="grade-badge @GradeClass(cell.WeightedScore, cell.MaxWeightedScore)">@(cell.WeightedScore?.ToString("0.###", CultureInfo.InvariantCulture) ?? "—")</span></td>
                                }
                                <td><strong>@row.TotalWeightedScore.ToString("0.###", CultureInfo.InvariantCulture)</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Score History"]</h5>
                <p class="section-subtitle">@Localizer["Every score ever saved for this group in this Big Exam, kept permanently. The current result for each student and subject is highlighted."]</p>
            </div>
            <span class="entity-panel-count">@Model.History.Count</span>
        </div>

        @if (!Model.History.Any())
        {
            <div class="teacher-empty">
                <div class="teacher-empty-icon"><i class="bi bi-journal-x"></i></div>
                <h5>@Localizer["No history yet"]</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Raw"]</th>
                            <th>@Localizer["Score"]</th>
                            <th>@Localizer["Graded By"]</th>
                            <th>@Localizer["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.History)
                        {
                            <tr class="@(entry.IsCurrent ? "" : "text-muted")">
                                <td>@entry.UpdatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@entry.StudentName</td>
                                <td><span class="subject-badge">@entry.SubjectName</span></td>
                                <td>@(entry.RawScore?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>@(entry.WeightedScore?.ToString("0.###", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>@entry.GradedBy</td>
                                <td>
                                    @if (entry.IsCurrent)
                                    {
                                        <span class="badge bg-success">@Localizer["Current"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["History"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const parse = value => {
                if (!value) return null;
                const normalized = value.trim().replace(",", ".");
                const number = Number(normalized);
                return Number.isNaN(number) ? null : number;
            };

            const refreshRow = row => {
                const inputs = document.querySelectorAll(`.big-exam-raw-input[data-row="${row}"]`);
                const weightedCells = document.querySelectorAll(`.big-exam-weighted[data-row="${row}"]`);
                let total = 0;
                let any = false;

                inputs.forEach((input, index) => {
                    const raw = parse(input.value);
                    const maxRaw = parseFloat(input.dataset.maxRaw);
                    const maxWeighted = parseFloat(input.dataset.maxWeighted);
                    const target = weightedCells[index];
                    if (!target) return;

                    if (raw === null || !maxRaw) {
                        target.textContent = "—";
                        return;
                    }

                    const weighted = Math.round((raw / maxRaw) * maxWeighted * 1000) / 1000;
                    target.textContent = weighted.toString();
                    total += weighted;
                    any = true;
                });

                const totalTarget = document.querySelector(`.big-exam-total[data-row="${row}"]`);
                if (totalTarget) {
                    totalTarget.textContent = any ? (Math.round(total * 1000) / 1000).toString() : "0";
                }
            };

            document.querySelectorAll(".big-exam-raw-input").forEach(input => {
                input.addEventListener("input", () => refreshRow(input.dataset.row));
            });
        })();
    </script>
}
