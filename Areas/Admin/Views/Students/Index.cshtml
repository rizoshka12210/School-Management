@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Students</h1>
            <p class="text-muted mb-0">
                Manage school students
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Students"
           asp-action="Create"
           class="btn btn-primary">
            + Add Student
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No students yet</h5>

                    <p class="text-muted">
                        Add your first student.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Student
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Date of Birth</th>
                                <th>Group</th>
                                <th>Parents</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var student in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @student.FirstName @student.LastName
                                </td>

                                <td>
                                    @student.DateOfBirth.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @if (student.Group != null)
                                    {
                                        <span class="badge bg-primary">
                                            @student.Group.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No group
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (student.Parents.Any())
                                    {
                                        @string.Join(
                                            ", ",
                                            student.Parents.Select(
                                                p => p.ApplicationUser.FullName))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No parent
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@student.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>