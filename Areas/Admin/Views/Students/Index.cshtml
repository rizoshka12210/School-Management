@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Student>

@{
    ViewData["Title"] = Localizer["Students"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Students"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage students and their school information"]
        </p>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-area="Admin"
           asp-controller="Accounting"
           asp-action="Index"
           class="btn btn-light">
            <i class="bi bi-wallet2 me-1"></i> @Localizer["Accounting"]
        </a>

        @if (User.IsInRole("Admin"))
        {
            <a asp-area="Admin"
               asp-controller="Students"
               asp-action="Create"
               class="btn btn-primary">
                + @Localizer["Add Student"]
            </a>
        }
    </div>

</div>

<div class="analytics-grid mb-4">
    <a asp-action="Index" class="analytics-card text-decoration-none text-reset">
        <div class="analytics-icon"><i class="bi bi-people-fill"></i></div>
        <div>
            <span>@Localizer["Total"]</span>
            <strong>@ViewBag.TotalCount</strong>
        </div>
    </a>
    <a asp-action="Index" class="analytics-card text-decoration-none text-reset">
        <div class="analytics-icon"><i class="bi bi-person-check-fill"></i></div>
        <div>
            <span>@Localizer["Active"]</span>
            <strong>@ViewBag.ActiveCount</strong>
        </div>
    </a>
    <a asp-action="Deleted" class="analytics-card analytics-danger text-decoration-none text-reset">
        <div class="analytics-icon"><i class="bi bi-person-x-fill"></i></div>
        <div>
            <span>@Localizer["Deleted"]</span>
            <strong>@ViewBag.DeletedCount</strong>
        </div>
    </a>
</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <!-- SEARCH -->

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search student or group..."]" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Search"]
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    @Localizer["Clear"]
                </a>
            }

        </form>


        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon"><i class="bi bi-people-fill"></i></div>

                <h5>
                    @Localizer["No students found"]
                </h5>

                <p>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                    {
                        @Localizer["Try changing your search."]
                    }
                    else
                    {
                        @Localizer["Add your first student to get started."]
                    }
                </p>

                @if (string.IsNullOrWhiteSpace(ViewBag.Search as string) && User.IsInRole("Admin"))
                {
                    <a asp-action="Create"
                       class="btn btn-primary">
                        + @Localizer["Add Student"]
                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>

                        <tr>
                            <th class="text-center" style="width: 48px;">№</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Group"]</th>
                            <th>@Localizer["Date of Birth"]</th>
                            <th>@Localizer["Parents"]</th>
                            <th class="text-end">
                                @Localizer["Actions"]
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @{ var rowNumber = 0; }

                        @foreach (var student in Model)
                        {
                            rowNumber++;

                            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = student.Id })">

                                <!-- ROW NUMBER -->

                                <td class="text-center text-muted">
                                    @rowNumber
                                </td>

                                <!-- STUDENT -->

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar">

                                            @student.FirstName.Substring(0, 1).ToUpper()

                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @student.FirstName
                                                @student.LastName
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Student #{0}", student.Id]
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- GROUP -->

                                <td>

                                    @if (student.Group != null)
                                    {
                                        <span class="group-badge">
                                            @student.Group.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No group"]
                                        </span>
                                    }

                                </td>


                                <!-- DOB -->

                                <td>
                                    @student.DateOfBirth.ToString("dd.MM.yyyy")
                                </td>


                                <!-- PARENTS -->

                                <td>

                                    @if (student.Parents.Any())
                                    {
                                        @foreach (var parent in student.Parents.Take(2))
                                        {
                                            <div class="small">
                                                @parent.ApplicationUser.FullName
                                            </div>
                                        }

                                        @if (student.Parents.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                @Localizer["+{0} more", student.Parents.Count - 2]
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No parent assigned"]
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="action-buttons">

                                            <a asp-action="Edit"
                                               asp-route-id="@student.Id"
                                               class="action-btn action-edit"
                                               title="@Localizer["Edit"]">
                                                @Localizer["Edit"]
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@student.Id"
                                               class="action-btn action-delete"
                                               title="@Localizer["Delete"]">
                                                @Localizer["Delete"]
                                            </a>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">

                <span>
                    @Localizer["Showing {0} student(s)", Model.Count()]
                </span>

            </div>
        }

    </div>

</div>
