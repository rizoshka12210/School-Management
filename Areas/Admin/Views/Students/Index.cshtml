@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Student>

@{
    ViewData["Title"] = Localizer["Students"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Students"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage students and their school information"]
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Students"
       asp-action="Create"
       class="btn btn-primary">

        + @Localizer["Add Student"]

    </a>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body">

        <!-- SEARCH -->

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search student or group..."]" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Search"]
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    @Localizer["Clear"]
                </a>
            }

        </form>


        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    ST
                </div>

                <h5>
                    @Localizer["No students found"]
                </h5>

                <p>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                    {
                        @Localizer["Try changing your search."]
                    }
                    else
                    {
                        @Localizer["Add your first student to get started."]
                    }
                </p>

                @if (string.IsNullOrWhiteSpace(ViewBag.Search as string))
                {
                    <a asp-action="Create"
                       class="btn btn-primary">
                        + @Localizer["Add Student"]
                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>

                        <tr>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Group"]</th>
                            <th>@Localizer["Date of Birth"]</th>
                            <th>@Localizer["Parents"]</th>
                            <th class="text-end">
                                @Localizer["Actions"]
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var student in Model)
                        {
                            <tr>

                                <!-- STUDENT -->

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar">

                                            @student.FirstName.Substring(0, 1).ToUpper()

                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @student.FirstName
                                                @student.LastName
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Student #{0}", student.Id]
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- GROUP -->

                                <td>

                                    @if (student.Group != null)
                                    {
                                        <span class="group-badge">
                                            @student.Group.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No group"]
                                        </span>
                                    }

                                </td>


                                <!-- DOB -->

                                <td>
                                    @student.DateOfBirth.ToString("dd.MM.yyyy")
                                </td>


                                <!-- PARENTS -->

                                <td>

                                    @if (student.Parents.Any())
                                    {
                                        @foreach (var parent in student.Parents.Take(2))
                                        {
                                            <div class="small">
                                                @parent.ApplicationUser.FullName
                                            </div>
                                        }

                                        @if (student.Parents.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                @Localizer["+{0} more", student.Parents.Count - 2]
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No parent assigned"]
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@student.Id"
                                           class="action-btn action-details"
                                           title="@Localizer["Details"]">
                                            @Localizer["View"]
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="action-btn action-edit"
                                           title="@Localizer["Edit"]">
                                            @Localizer["Edit"]
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@student.Id"
                                           class="action-btn action-delete"
                                           title="@Localizer["Delete"]">
                                            @Localizer["Delete"]
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">

                <span>
                    @Localizer["Showing {0} student(s)", Model.Count()]
                </span>

            </div>
        }

    </div>

</div>
