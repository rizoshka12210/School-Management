@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            Students
        </h1>

        <p class="page-subtitle">
            Manage students and their school information
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Students"
       asp-action="Create"
       class="btn btn-primary">

        + Add Student

    </a>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body">

        <!-- SEARCH -->

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search student or group..." />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    Clear
                </a>
            }

        </form>


        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    ST
                </div>

                <h5>
                    No students found
                </h5>

                <p>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                    {
                        <text>
                            Try changing your search.
                        </text>
                    }
                    else
                    {
                        <text>
                            Add your first student to get started.
                        </text>
                    }
                </p>

                @if (string.IsNullOrWhiteSpace(ViewBag.Search as string))
                {
                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Add Student
                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th>Group</th>
                            <th>Date of Birth</th>
                            <th>Parents</th>
                            <th class="text-end">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var student in Model)
                        {
                            <tr>

                                <!-- STUDENT -->

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar">

                                            @student.FirstName.Substring(0, 1).ToUpper()

                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @student.FirstName
                                                @student.LastName
                                            </div>

                                            <div class="person-id">
                                                Student #@student.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- GROUP -->

                                <td>

                                    @if (student.Group != null)
                                    {
                                        <span class="group-badge">
                                            @student.Group.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No group
                                        </span>
                                    }

                                </td>


                                <!-- DOB -->

                                <td>
                                    @student.DateOfBirth.ToString("dd.MM.yyyy")
                                </td>


                                <!-- PARENTS -->

                                <td>

                                    @if (student.Parents.Any())
                                    {
                                        @foreach (var parent in student.Parents.Take(2))
                                        {
                                            <div class="small">
                                                @parent.ApplicationUser.FullName
                                            </div>
                                        }

                                        @if (student.Parents.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                +@(student.Parents.Count - 2) more
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No parent assigned
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@student.Id"
                                           class="action-btn action-details"
                                           title="Details">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@student.Id"
                                           class="action-btn action-edit"
                                           title="Edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@student.Id"
                                           class="action-btn action-delete"
                                           title="Delete">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">

                <span>
                    Showing @Model.Count() student(s)
                </span>

            </div>
        }

    </div>

</div>