@model SchoolManagementSystem.Web.Models.Entities.Student

@{
    ViewData["Title"] = Localizer["Student Details"];
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        @Model.FirstName @Model.LastName
                    </h2>

                    <hr />

                    <p>
                        <strong>@Localizer["Date of Birth"]:</strong>
                        @Model.DateOfBirth.ToString("dd.MM.yyyy")
                    </p>

                    <p>
                        <strong>@Localizer["Group"]:</strong>

                        @(Model.Group?.Name ?? Localizer["No group"].Value)
                    </p>

                    <div class="mb-4">

                        <strong>@Localizer["Parents"]:</strong>

                        @if (Model.Parents.Any())
                        {
                            <ul class="mt-2">

                                @foreach (var parent in Model.Parents)
                                {
                                    <li>
                                        @parent.ApplicationUser.FullName
                                        -
                                        @parent.ApplicationUser.Email
                                    </li>
                                }

                            </ul>
                        }
                        else
                        {
                            <span>@Localizer["No parents assigned."]</span>
                        }

                    </div>

                    <div class="mb-4">
                        <strong>@Localizer["Achievements"]</strong>
                        <partial name="_AchievementBadges" model="ViewBag.Achievements" />
                    </div>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        @Localizer["Edit"]
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        @Localizer["Back"]
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
