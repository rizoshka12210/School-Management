@using SchoolManagementSystem.Web.Models.Enums
@model SchoolManagementSystem.Web.ViewModels.Admin.StudentProfile360ViewModel

@{
    ViewData["Title"] = Localizer["Student Profile 360°"];
    var student = Model.Student;

    string GradeClass(decimal? value) => value switch
    {
        null => string.Empty,
        >= 90 => "grade-high",
        >= 75 => "grade-good",
        _ => "grade-low"
    };
}

<div class="profile360-header">
    <div class="profile360-identity">
        <div class="profile360-avatar">
            @(string.IsNullOrWhiteSpace(student.FirstName) ? "S" : student.FirstName.Substring(0, 1).ToUpper())
        </div>
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="page-title mb-0">@student.FirstName @student.LastName</h1>
                <span class="risk-badge @Model.Risk.CssClass"><i class="bi @Model.Risk.IconClass"></i> @Localizer[Model.Risk.Label]</span>
            </div>
            <p class="page-subtitle mb-0">@Localizer["Student Profile 360°"] · @(student.Group?.Name ?? Localizer["No group"].Value)</p>
        </div>
    </div>

    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-primary">@Localizer["Edit profile"]</a>
        }
        <a asp-action="Index" class="btn btn-light">@Localizer["Back"]</a>
    </div>
</div>

<div class="profile360-kpis">
    <div class="profile360-kpi">
        <span>@Localizer["Average Grade"]</span>
        <strong>@Model.AverageGrade.ToString("0.00")</strong>
        <small>@Localizer["Across {0} grade(s)", student.Grades.Count]</small>
    </div>
    <div class="profile360-kpi">
        <span>@Localizer["Attendance"]</span>
        <strong>@Model.AttendanceRate.ToString("0.0")%</strong>
        <small>@Localizer["{0} attendance record(s)", student.Attendances.Count]</small>
    </div>
    <div class="profile360-kpi">
        <span>@Localizer["Group"]</span>
        <strong>@(student.Group?.Name ?? "—")</strong>
        <small>@Localizer["Current school group"]</small>
    </div>
    <div class="profile360-kpi">
        <span>@Localizer["Parents"]</span>
        <strong>@student.Parents.Count</strong>
        <small>@Localizer["Connected parent account(s)"]</small>
    </div>
</div>

<div class="form-card mb-4">
    <div class="form-card-header">
        <h5>@Localizer["Achievements"]</h5>
        <p>@Localizer["Earned and upcoming student badges"]</p>
    </div>
    <div class="form-card-body">
        <partial name="_AchievementBadges" model="ViewBag.Achievements" />
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title">@Localizer["Early Warning System"]</h5>
                        <p class="section-subtitle">@Localizer["Automatic risk status from grades + attendance"]</p>
                    </div>
                </div>

                <div class="risk-profile-card @Model.Risk.CssClass">
                    <div class="risk-profile-status"><i class="bi @Model.Risk.IconClass"></i> @Localizer[Model.Risk.Label]</div>
                    <div class="risk-profile-metrics">
                        <div><span>@Localizer["Average Grade"]</span><strong>@Model.Risk.AverageGrade.ToString("0.00")</strong></div>
                        <div><span>@Localizer["Attendance"]</span><strong>@Model.Risk.AttendanceRate.ToString("0.0")%</strong></div>
                    </div>
                    @if (Model.Risk.Reasons.Any())
                    {
                        <div class="risk-profile-reasons">
                            <strong>@Localizer["Reasons"]</strong>
                            <ul>
                                @foreach (var reason in Model.Risk.Reasons)
                                {
                                    <li>@Localizer[reason]</li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <p class="mb-0">@Localizer["No active risk signals detected."]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title">@Localizer["Student Information"]</h5>
                        <p class="section-subtitle">@Localizer["Personal and family information"]</p>
                    </div>
                </div>
                <div class="profile-info-grid">
                    <div><span>@Localizer["Student ID"]</span><strong>#@student.Id</strong></div>
                    <div><span>@Localizer["Date of Birth"]</span><strong>@student.DateOfBirth.ToString("dd MMMM yyyy")</strong></div>
                    <div><span>@Localizer["Group"]</span><strong>@(student.Group?.Name ?? Localizer["No group"].Value)</strong></div>
                    <div>
                        <span>@Localizer["Parent"]</span>
                        <strong>
                            @if (student.Parents.Any())
                            {
                                @string.Join(", ", student.Parents.Select(p => p.ApplicationUser.FullName))
                            }
                            else
                            {
                                <text>@Localizer["Not assigned"]</text>
                            }
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title">@Localizer["Recent Grades"]</h5>
                        <p class="section-subtitle">@Localizer["Latest academic results"]</p>
                    </div>
                </div>

                @if (!Model.RecentGrades.Any())
                {
                    <div class="dashboard-empty"><p>@Localizer["No grades recorded yet."]</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle management-table">
                            <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Teacher"]</th><th>@Localizer["Grade"]</th></tr></thead>
                            <tbody>
                                @foreach (var grade in Model.RecentGrades)
                                {
                                    <tr>
                                        <td>@grade.Date.ToString("dd MMM")</td>
                                        <td><span class="subject-badge">@grade.Subject.Name</span></td>
                                        <td>@grade.Teacher.ApplicationUser.FullName</td>
                                        <td><span class="grade-badge @(grade.Value >= 90 ? "grade-high" : grade.Value >= 75 ? "grade-good" : "grade-low")">@grade.Value.ToString("0.##")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title">@Localizer["Attendance Calendar"]</h5>
                        <p class="section-subtitle">@Localizer["Last {0} attendance records", Model.RecentAttendance.Count]</p>
                    </div>
                </div>

                @if (!Model.RecentAttendance.Any())
                {
                    <div class="dashboard-empty"><p>@Localizer["No attendance data yet."]</p></div>
                }
                else
                {
                    <div class="attendance-calendar">
                        @foreach (var item in Model.RecentAttendance.OrderBy(a => a.Lesson.StartTime))
                        {
                            var dotClass = item.Status switch
                            {
                                AttendanceStatus.Present => "calendar-dot-present",
                                AttendanceStatus.Absent => "calendar-dot-absent",
                                AttendanceStatus.Late => "calendar-dot-late",
                                AttendanceStatus.Excused => "calendar-dot-excused",
                                _ => "calendar-dot-unknown"
                            };
                            <div class="attendance-calendar-day" title="@item.Lesson.StartTime.ToString("dd MMM") · @item.Lesson.Subject.Name · @Localizer[item.Status.ToString()]">
                                <span class="calendar-dot @dotClass"></span>
                                <small>@item.Lesson.StartTime.ToString("dd")</small>
                            </div>
                        }
                    </div>
                    <div class="attendance-legend mt-3">
                        <span><span class="calendar-dot calendar-dot-present"></span>@Localizer["Present"]</span><span><span class="calendar-dot calendar-dot-late"></span>@Localizer["Late"]</span><span><span class="calendar-dot calendar-dot-absent"></span>@Localizer["Absent"]</span><span><span class="calendar-dot calendar-dot-excused"></span>@Localizer["Excused"]</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Teacher Comments"]</h5>
                <p class="section-subtitle">@Localizer["Comments attached to recent grades"]</p>
            </div>
        </div>

        @if (!Model.TeacherComments.Any())
        {
            <div class="dashboard-empty"><p>@Localizer["No teacher comments yet."]</p></div>
        }
        else
        {
            <div class="teacher-comments-list">
                @foreach (var comment in Model.TeacherComments)
                {
                    <div class="teacher-comment-card">
                        <div class="teacher-comment-head">
                            <strong>@comment.TeacherName</strong>
                            <span>@comment.SubjectName · @comment.Date.ToString("dd MMM yyyy")</span>
                        </div>
                        <p>@comment.Comment</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Exam Grade History"]</h5>
                <p class="section-subtitle">@Localizer["Every exam result ever saved for this student, kept permanently. The current result for each subject is highlighted."]</p>
            </div>
        </div>

        @if (!Model.ExamGradeHistory.Any())
        {
            <div class="dashboard-empty"><p>@Localizer["This student does not have any exam grades recorded yet."]</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Teacher"]</th>
                            <th>@Localizer["Exam 1"]</th>
                            <th>@Localizer["Exam 2"]</th>
                            <th>@Localizer["Average"]</th>
                            <th>@Localizer["Comment"]</th>
                            <th>@Localizer["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.ExamGradeHistory)
                        {
                            bool isCurrent = Model.CurrentExamGradeIds.Contains(exam.Id);
                            <tr class="@(isCurrent ? "" : "text-muted")">
                                <td>@exam.UpdatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="subject-badge">@exam.Subject.Name</span></td>
                                <td>@exam.Teacher.ApplicationUser.FullName</td>
                                <td>@(exam.Exam1?.ToString("0.##") ?? "—")</td>
                                <td>@(exam.Exam2?.ToString("0.##") ?? "—")</td>
                                <td><span class="grade-badge @GradeClass(exam.Average)">@(exam.Average?.ToString("0.##") ?? "—")</span></td>
                                <td>@(string.IsNullOrWhiteSpace(exam.Comment) ? "—" : exam.Comment)</td>
                                <td>
                                    @if (isCurrent)
                                    {
                                        <span class="badge bg-success">@Localizer["Current"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["History"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
