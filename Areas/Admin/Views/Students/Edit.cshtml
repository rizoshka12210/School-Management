@model SchoolManagementSystem.Web.ViewModels.Admin.StudentFormViewModel

@{
    ViewData["Title"] = Localizer["Edit Student"];
}

<div class="form-page-header">

    <div>

        <a asp-action="Index"
           class="back-link">
            ← @Localizer["Students"]
        </a>

        <h1 class="page-title mt-2">
            @Localizer["Edit Student"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Update student information and relationships"]
        </p>

    </div>

</div>


<form asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id"
           type="hidden" />

    <partial name="_Form"
             model="Model" />

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            @Localizer["Cancel"]
        </a>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["Save Changes"]
        </button>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
