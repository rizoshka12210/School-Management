@model SchoolManagementSystem.Web.ViewModels.Admin.StudentFormViewModel

@{
    ViewData["Title"] = Localizer["Add Student"];
}

<div class="form-page-header">

    <div>

        <a asp-action="Index"
           class="back-link">
            ← @Localizer["Students"]
        </a>

        <h1 class="page-title mt-2">
            @Localizer["Add Student"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Create a new student and assign group and parents"]
        </p>

    </div>

</div>


<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <partial name="_Form"
             model="Model" />

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            @Localizer["Cancel"]
        </a>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["Create Student"]
        </button>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
