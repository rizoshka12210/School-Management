@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Parent>

@{
    ViewData["Title"] = "Parents";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Parents</h1>

            <p class="text-muted mb-0">
                Manage parent accounts
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Parent
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No parents found</h5>

                    <a asp-action="Create"
                       class="btn btn-primary mt-2">
                        Add Parent
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Children</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var parent in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @parent.ApplicationUser.FullName
                                </td>

                                <td>
                                    @parent.ApplicationUser.Email
                                </td>

                                <td>
                                    @if (parent.Students.Any())
                                    {
                                        @string.Join(
                                            ", ",
                                            parent.Students.Select(
                                                s => s.FirstName + " " + s.LastName))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No children
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@parent.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@parent.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@parent.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>