@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Parent>

@{
    ViewData["Title"] = Localizer["Parents"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Parents"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage parent accounts and connected students"]
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + @Localizer["Add Parent"]
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search parent or email..."]" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Search"]
            </button>

            @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    @Localizer["Clear"]
                </a>
            }

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    PA
                </div>

                <h5>
                    @Localizer["No parents found"]
                </h5>

                <p>
                    @Localizer["Add a parent account or change your search."]
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + @Localizer["Add Parent"]
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>@Localizer["Parent"]</th>
                            <th>@Localizer["Children"]</th>
                            <th>@Localizer["Groups"]</th>
                            <th class="text-end">
                                @Localizer["Actions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var parent in Model)
                        {
                            <tr>

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar parent-avatar">

                                            @(string.IsNullOrWhiteSpace(
                                                parent.ApplicationUser.FullName)
                                                ? "P"
                                                : parent.ApplicationUser.FullName
                                                    .Substring(0, 1)
                                                    .ToUpper())

                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @parent.ApplicationUser.FullName
                                            </div>

                                            <div class="person-id">
                                                @parent.ApplicationUser.Email
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (parent.Students.Any())
                                    {
                                        @foreach (var student in
                                            parent.Students.Take(3))
                                        {
                                            <div class="student-mini">
                                                @student.FirstName
                                                @student.LastName
                                            </div>
                                        }

                                        @if (parent.Students.Count > 3)
                                        {
                                            <div class="text-muted small">
                                                @Localizer["+{0} more", parent.Students.Count - 3]
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No children assigned"]
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (parent.Students.Any(
                                        s => s.Group != null))
                                    {
                                        @foreach (var group in
                                            parent.Students
                                                .Where(s => s.Group != null)
                                                .Select(s => s.Group!)
                                                .DistinctBy(g => g.Id)
                                                .Take(3))
                                        {
                                            <span class="group-badge me-1">
                                                @group.Name
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No groups"]
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@parent.Id"
                                           class="action-btn action-details">
                                            @Localizer["View"]
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@parent.Id"
                                           class="action-btn action-edit">
                                            @Localizer["Edit"]
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@parent.Id"
                                           class="action-btn action-delete">
                                            @Localizer["Delete"]
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                @Localizer["Showing {0} parent(s)", Model.Count()]
            </div>
        }

    </div>

</div>
