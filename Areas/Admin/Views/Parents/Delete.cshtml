@model SchoolManagementSystem.Web.Models.Entities.Parent

@{
    ViewData["Title"] = Localizer["Delete Parent"];
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        @Localizer["Delete Parent"]
                    </h2>

                    <p class="mt-3">
                        @Localizer["Are you sure you want to delete"]
                        <strong>
                            @Model.ApplicationUser.FullName
                        </strong>?
                    </p>

                    <p>
                        @Model.ApplicationUser.Email
                    </p>

                    <p>
                        @Localizer["Children"]:
                        <strong>
                            @Model.Students.Count
                        </strong>
                    </p>

                    <p class="text-muted">
                        @Localizer["The Parent login account will also be deleted."]
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Yes, Delete"]
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>
