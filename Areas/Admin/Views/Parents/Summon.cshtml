@model SchoolManagementSystem.Web.ViewModels.Admin.ParentSummonFormViewModel

@{
    ViewData["Title"] = Localizer["Summon Parent"];
}

<div class="form-page-header">

    <a asp-action="Details"
       asp-route-id="@Model.ParentId"
       class="back-link">
        ← @Model.ParentName
    </a>

    <h1 class="page-title mt-2">
        @Localizer["Summon Parent"]
    </h1>

    <p class="page-subtitle">
        @Localizer["Ask {0} to come to school at a specific time.", Model.ParentName]
    </p>

</div>

<form asp-action="Summon"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="ParentId"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="form-card">

        <div class="form-card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="ScheduledAt"
                           class="form-label">
                        @Localizer["Date and time"]
                    </label>

                    <input asp-for="ScheduledAt"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           type="datetime-local"
                           step="60"
                           class="form-control" />

                    <span asp-validation-for="ScheduledAt"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="Message"
                           class="form-label">
                        @Localizer["Message (optional)"]
                    </label>

                    <textarea asp-for="Message"
                              rows="3"
                              class="form-control"
                              placeholder="@Localizer["Example: Discuss attendance"]"></textarea>

                    <span asp-validation-for="Message"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div class="form-actions">

        <a asp-action="Details"
           asp-route-id="@Model.ParentId"
           class="btn btn-light">
            @Localizer["Cancel"]
        </a>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["Summon"]
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
