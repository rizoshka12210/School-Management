@model SchoolManagementSystem.Web.Models.Entities.ParentSummon

@{
    ViewData["Title"] = Localizer["Delete Summon"];
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        @Localizer["Delete Summon"]
                    </h2>

                    <p class="mt-3">
                        @Localizer["Are you sure you want to delete this scheduled visit?"]
                    </p>

                    <hr />

                    <p>
                        <strong>@Localizer["Parent"]:</strong>
                        @Model.Parent.ApplicationUser.FullName
                    </p>

                    <p>
                        <strong>@Localizer["Date and time"]:</strong>
                        @Model.ScheduledAt.ToString("g")
                    </p>

                    <p>
                        <strong>@Localizer["Message"]:</strong>
                        @(string.IsNullOrWhiteSpace(Model.Message) ? Localizer["No message"].Value : Model.Message)
                    </p>

                    <form asp-action="DeleteSummon"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Yes, Delete"]
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.ParentId"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
