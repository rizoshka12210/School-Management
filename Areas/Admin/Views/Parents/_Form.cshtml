@model SchoolManagementSystem.Web.ViewModels.Admin.ParentFormViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>

<div class="parent-form-grid">

    <div class="form-card">

        <div class="form-card-header">

            <h5>
                @Localizer["Parent Information"]
            </h5>

            <p>
                @Localizer["Account information for the parent"]
            </p>

        </div>

        <div class="form-card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="FullName"
                           class="form-label">
                        @Localizer["Full Name"]
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="@Localizer["Example: Michael Smith"]" />

                    <span asp-validation-for="FullName"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Email"
                           class="form-label">

                        @Localizer["Email"]

                        <span class="text-muted fw-normal">
                            (@Localizer["optional"])
                        </span>

                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="parent@school.com"
                           autocomplete="off" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="PhoneNumber"
                           class="form-label">
                        @Localizer["Phone Number"]
                    </label>

                    <input asp-for="PhoneNumber"
                           type="tel"
                           class="form-control"
                           placeholder="+992 00 000 0000" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Password"
                           class="form-label">

                        @Localizer["Password"]

                        @if (Model.Id != 0)
                        {
                            <span class="text-muted fw-normal">
                                (@Localizer["optional"])
                            </span>
                        }

                    </label>

                    <div class="password-field">
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="@Localizer["Enter password"]"
                               autocomplete="new-password" />

                        <partial name="_PasswordToggle" />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>

                    @if (Model.Id != 0)
                    {
                        <div class="form-hint">
                            @Localizer["Leave empty to keep the current password."]
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <div class="form-card">

        <div class="form-card-header">

            <h5>
                @Localizer["Children"]
            </h5>

            <p>
                @Localizer["Select students connected to this parent"]
            </p>

        </div>

        <div class="form-card-body">

            @if (ViewBag.Students != null)
            {
                <div class="relation-selector">

                    @foreach (var student in ViewBag.Students)
                    {
                        var selected =
                            Model.StudentIds != null &&
                            Model.StudentIds.Contains(
                                student.Id);

                        <label class="relation-option">

                            <input type="checkbox"
                                   name="StudentIds"
                                   value="@student.Id"
                                   checked="@selected" />

                            <div class="relation-icon student-relation-icon">

                                @(string.IsNullOrWhiteSpace(
                                    student.FirstName)
                                    ? "S"
                                    : student.FirstName
                                        .Substring(0, 1)
                                        .ToUpper())

                            </div>

                            <div class="relation-info">

                                <strong>
                                    @student.FirstName
                                    @student.LastName
                                </strong>

                                <span>
                                    @(student.Group?.Name ?? Localizer["No group"].Value)
                                </span>

                            </div>

                        </label>
                    }

                </div>
            }

        </div>

    </div>

</div>
