@model SchoolManagementSystem.Web.Models.Entities.Parent

@{
    ViewData["Title"] = Localizer["Parent Details"];
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        @Model.ApplicationUser.FullName
                    </h2>

                    <p class="text-muted">
                        @Model.ApplicationUser.Email
                    </p>

                    <hr />

                    <h5>@Localizer["Children"]</h5>

                    @if (Model.Students.Any())
                    {
                        <ul>

                            @foreach (var student in Model.Students)
                            {
                                <li>
                                    @student.FirstName
                                    @student.LastName

                                    @if (student.Group != null)
                                    {
                                        <span class="text-muted">
                                            - @student.Group.Name
                                        </span>
                                    }
                                </li>
                            }

                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">
                            @Localizer["No children assigned."]
                        </p>
                    }

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        @Localizer["Edit"]
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        @Localizer["Back"]
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
