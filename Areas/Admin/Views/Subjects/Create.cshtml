@model SchoolManagementSystem.Web.ViewModels.Admin.SubjectFormViewModel

@{
    ViewData["Title"] = Localizer["Add Subject"];
}

<div class="form-page-header">

    <a asp-action="Index"
       class="back-link">
        ← @Localizer["Subjects"]
    </a>

    <h1 class="page-title mt-2">
        @Localizer["Add Subject"]
    </h1>

    <p class="page-subtitle">
        @Localizer["Create a subject and assign teachers"]
    </p>

</div>

<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <partial name="_Form"
             model="Model" />

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            @Localizer["Cancel"]
        </a>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["Create Subject"]
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
