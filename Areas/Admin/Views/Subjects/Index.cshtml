@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Subject>

@{
    ViewData["Title"] = Localizer["Subjects"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Subjects"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage school subjects and assigned teachers"]
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + @Localizer["Add Subject"]
        </a>
    }

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search subject..."]" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Search"]
            </button>

            @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    @Localizer["Clear"]
                </a>
            }

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    SB
                </div>

                <h5>
                    @Localizer["No subjects found"]
                </h5>

                <p>
                    @Localizer["Create a subject to get started."]
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create"
                       class="btn btn-primary">
                        + @Localizer["Add Subject"]
                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Teachers"]</th>
                            <th class="text-end">
                                @Localizer["Actions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var subject in Model)
                        {
                            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = subject.Id })">

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar subject-avatar">
                                            SB
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @subject.Name
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Subject #{0}", subject.Id]
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (subject.Teachers.Any())
                                    {
                                        @foreach (var teacher in
                                            subject.Teachers.Take(3))
                                        {
                                            <span class="teacher-badge me-1">
                                                @teacher.ApplicationUser.FullName
                                            </span>
                                        }

                                        @if (subject.Teachers.Count > 3)
                                        {
                                            <span class="text-muted small">
                                                +@(subject.Teachers.Count - 3)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No teachers"]
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="action-buttons">

                                            <a asp-action="Edit"
                                               asp-route-id="@subject.Id"
                                               class="action-btn action-edit">
                                                @Localizer["Edit"]
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@subject.Id"
                                               class="action-btn action-delete">
                                                @Localizer["Delete"]
                                            </a>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                @Localizer["Showing {0} subject(s)", Model.Count()]
            </div>
        }

    </div>

</div>
