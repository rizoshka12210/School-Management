@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Subject>

@{
    ViewData["Title"] = "Subjects";
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            Subjects
        </h1>

        <p class="page-subtitle">
            Manage school subjects and assigned teachers
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Subject
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search subject..." />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    Clear
                </a>
            }

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    SB
                </div>

                <h5>
                    No subjects found
                </h5>

                <p>
                    Create a subject to get started.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add Subject
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Teachers</th>
                            <th class="text-end">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var subject in Model)
                        {
                            <tr>

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar subject-avatar">
                                            SB
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @subject.Name
                                            </div>

                                            <div class="person-id">
                                                Subject #@subject.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (subject.Teachers.Any())
                                    {
                                        @foreach (var teacher in
                                            subject.Teachers.Take(3))
                                        {
                                            <span class="teacher-badge me-1">
                                                @teacher.ApplicationUser.FullName
                                            </span>
                                        }

                                        @if (subject.Teachers.Count > 3)
                                        {
                                            <span class="text-muted small">
                                                +@(subject.Teachers.Count - 3)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No teachers
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@subject.Id"
                                           class="action-btn action-details">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@subject.Id"
                                           class="action-btn action-edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@subject.Id"
                                           class="action-btn action-delete">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                Showing @Model.Count() subject(s)
            </div>
        }

    </div>

</div>