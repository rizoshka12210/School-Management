@model SchoolManagementSystem.Web.Models.Entities.Subject

@{
    ViewData["Title"] = Localizer["Subject Details"];
}

<link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />

<div class="entity-details-page">
    <a asp-action="Index" class="entity-details-back">
        <i class="bi bi-arrow-left"></i>
        @Localizer["Subjects"]
    </a>

    <section class="entity-details-hero">
        <div class="entity-details-identity">
            <div class="entity-details-icon entity-icon-orange">
                <i class="bi bi-book-fill"></i>
            </div>
            <div>
                <span class="entity-details-eyebrow">@Localizer["Subject Details"]</span>
                <h1 class="entity-details-title">@Model.Name</h1>
                <p class="entity-details-subtitle">@Localizer["Teachers"]</p>
                <div class="entity-details-meta">
                    <span class="entity-meta-badge"><i class="bi bi-hash"></i>ID @Model.Id</span>
                    <span class="entity-meta-badge"><i class="bi bi-person-workspace"></i>@Model.Teachers.Count @Localizer["Teachers"]</span>
                </div>
            </div>
        </div>

        <div class="entity-details-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                @Localizer["Edit"]
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                @Localizer["Back"]
            </a>
        </div>
    </section>

    <div class="entity-details-grid entity-details-grid-wide">
        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-person-workspace"></i>@Localizer["Teachers"]</h2>
                    <p class="entity-panel-subtitle">@Model.Name</p>
                </div>
                <span class="entity-panel-count">@Model.Teachers.Count</span>
            </div>
            <div class="entity-panel-body">
                @if (Model.Teachers.Any())
                {
                    <div class="entity-list">
                        @foreach (var teacher in Model.Teachers.OrderBy(t => t.ApplicationUser.FullName))
                        {
                            <a asp-area="Admin" asp-controller="Teachers" asp-action="Details" asp-route-id="@teacher.Id" class="entity-list-row">
                                <div class="entity-list-avatar teacher"><i class="bi bi-person-workspace"></i></div>
                                <div class="entity-list-main">
                                    <strong>@teacher.ApplicationUser.FullName</strong>
                                    <span>@(teacher.ApplicationUser.Email ?? "—")</span>
                                </div>
                                <span class="entity-list-side">@Localizer["View"] <i class="bi bi-chevron-right"></i></span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="entity-empty"><div><i class="bi bi-person-x"></i>@Localizer["No teachers assigned."]</div></div>
                }
            </div>
        </section>

        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-info-circle-fill"></i>@Localizer["Subject Details"]</h2>
                </div>
            </div>
            <div class="entity-panel-body">
                <div class="entity-facts">
                    <div class="entity-fact">
                        <span>ID</span>
                        <strong>#@Model.Id</strong>
                    </div>
                    <div class="entity-fact">
                        <span>@Localizer["Subject"]</span>
                        <strong>@Model.Name</strong>
                    </div>
                    <div class="entity-fact">
                        <span>@Localizer["Teachers"]</span>
                        <strong>@Model.Teachers.Count</strong>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
