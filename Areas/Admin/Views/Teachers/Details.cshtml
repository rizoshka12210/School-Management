@model SchoolManagementSystem.Web.Models.Entities.Teacher

@{
    ViewData["Title"] = "Teacher Details";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        @Model.ApplicationUser.FullName
                    </h2>

                    <p class="text-muted">
                        @Model.ApplicationUser.Email
                    </p>

                    <hr />

                    <p>
                        <strong>Hourly Rate:</strong>
                        @Model.HourlyRate
                    </p>

                    <h5 class="mt-4">
                        Groups
                    </h5>

                    @if (Model.Groups.Any())
                    {
                        <ul>
                            @foreach (var group in Model.Groups)
                            {
                                <li>@group.Name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">
                            No groups assigned.
                        </p>
                    }

                    <h5 class="mt-4">
                        Subjects
                    </h5>

                    @if (Model.Subjects.Any())
                    {
                        <ul>
                            @foreach (var subject in Model.Subjects)
                            {
                                <li>@subject.Name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">
                            No subjects assigned.
                        </p>
                    }

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Edit
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>