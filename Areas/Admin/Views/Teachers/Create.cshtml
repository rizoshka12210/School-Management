@model SchoolManagementSystem.Web.ViewModels.Admin.TeacherFormViewModel

@{
    ViewData["Title"] = "Add Teacher";
}

<div class="form-page-header">

    <a asp-action="Index"
       class="back-link">
        ← Teachers
    </a>

    <h1 class="page-title mt-2">
        Add Teacher
    </h1>

    <p class="page-subtitle">
        Create a teacher account and assign groups and subjects
    </p>

</div>


<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <partial name="_Form"
             model="Model" />


    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-primary">
            Create Teacher
        </button>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}