@model SchoolManagementSystem.Web.ViewModels.Admin.TeacherFormViewModel

@{
    ViewData["Title"] = "Edit Teacher";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">
                        Edit Teacher
                    </h2>

                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                New Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Leave empty to keep current password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Leave empty if you don't want to change the password.
                            </small>

                        </div>

                        <div class="mb-3">

                            <label asp-for="HourlyRate"
                                   class="form-label">
                                Hourly Rate
                            </label>

                            <input asp-for="HourlyRate"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0" />

                            <span asp-validation-for="HourlyRate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="GroupIds"
                                   class="form-label">
                                Groups
                            </label>

                            <select asp-for="GroupIds"
                                    asp-items="ViewBag.Groups"
                                    class="form-select"
                                    multiple
                                    size="5">
                            </select>

                            <small class="text-muted">
                                Hold Command on Mac to select multiple groups.
                            </small>

                        </div>

                        <div class="mb-4">

                            <label asp-for="SubjectIds"
                                   class="form-label">
                                Subjects
                            </label>

                            <select asp-for="SubjectIds"
                                    asp-items="ViewBag.Subjects"
                                    class="form-select"
                                    multiple
                                    size="5">
                            </select>

                            <small class="text-muted">
                                Hold Command on Mac to select multiple subjects.
                            </small>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}