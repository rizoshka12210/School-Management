@model SchoolManagementSystem.Web.Models.Entities.TeacherNotice

@{
    ViewData["Title"] = Localizer["Delete Message"];
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        @Localizer["Delete Message"]
                    </h2>

                    <p class="mt-3">
                        @Localizer["Are you sure you want to delete this message?"]
                    </p>

                    <hr />

                    <p>
                        <strong>@Localizer["Teacher"]:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <p>
                        <strong>@Localizer["Date"]:</strong>
                        @Model.CreatedAt.ToString("g")
                    </p>

                    <p>
                        <strong>@Localizer["Message"]:</strong>
                        @Model.Message
                    </p>

                    <form asp-action="DeleteNotice"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Yes, Delete"]
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.TeacherId"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
