@model SchoolManagementSystem.Web.ViewModels.Admin.TeacherFormViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>


<div class="teacher-form-grid">

    <!-- ACCOUNT -->

    <div class="form-card">

        <div class="form-card-header">

            <h5>
                @Localizer["Teacher Information"]
            </h5>

            <p>
                @Localizer["Account and salary information"]
            </p>

        </div>


        <div class="form-card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="FullName"
                           class="form-label">
                        @Localizer["Full Name"]
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="@Localizer["Example: John Smith"]" />

                    <span asp-validation-for="FullName"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="PhoneNumber"
                           class="form-label">
                        @Localizer["Phone Number"]
                    </label>

                    <input asp-for="PhoneNumber"
                           type="tel"
                           class="form-control"
                           placeholder="+992 00 000 0000" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Email"
                           class="form-label">

                        @Localizer["Email"]

                        <span class="text-muted fw-normal">
                            (@Localizer["optional"])
                        </span>

                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="teacher@school.com" />

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="HourlyRate"
                           class="form-label">
                        @Localizer["Hourly Rate"]
                    </label>

                    <input asp-for="HourlyRate"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="50" />

                    <span asp-validation-for="HourlyRate"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Password"
                           class="form-label">

                        @Localizer["Password"]

                        @if (Model.Id != 0)
                        {
                            <span class="text-muted fw-normal">
                                (@Localizer["optional"])
                            </span>
                        }

                    </label>

                    <div class="password-field">
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="@Localizer["Enter password"]" />

                        <partial name="_PasswordToggle" />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>


                    @if (Model.Id != 0)
                    {
                        <div class="form-hint">
                            @Localizer["Leave empty to keep the current password."]
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- GROUPS -->

    <div class="form-card">

        <div class="form-card-header">

            <h5>
                @Localizer["Groups"]
            </h5>

            <p>
                @Localizer["Select groups assigned to this teacher"]
            </p>

        </div>


        <div class="form-card-body">

            <div class="relation-selector">

                @foreach (var group in ViewBag.Groups)
                {
                    var selected =
                        Model.GroupIds != null &&
                        Model.GroupIds.Contains(group.Id);

                    <label class="relation-option">

                        <input type="checkbox"
                               name="GroupIds"
                               value="@group.Id"
                               checked="@selected" />

                        <div class="relation-icon">
                            <i class="bi bi-collection-fill"></i>
                        </div>

                        <div class="relation-info">

                            <strong>
                                @group.Name
                            </strong>

                            <span>
                                @Localizer["School group"]
                            </span>

                        </div>

                    </label>
                }

            </div>

        </div>

    </div>


    <!-- SUBJECTS -->

    <div class="form-card">

        <div class="form-card-header">

            <h5>
                @Localizer["Subjects"]
            </h5>

            <p>
                @Localizer["Select subjects taught by this teacher"]
            </p>

        </div>


        <div class="form-card-body">

            <div class="relation-selector">

                @foreach (var subject in ViewBag.Subjects)
                {
                    var selected =
                        Model.SubjectIds != null &&
                        Model.SubjectIds.Contains(
                            subject.Id);

                    <label class="relation-option">

                        <input type="checkbox"
                               name="SubjectIds"
                               value="@subject.Id"
                               checked="@selected" />

                        <div class="relation-icon subject-icon">
                            <i class="bi bi-book-fill"></i>
                        </div>

                        <div class="relation-info">

                            <strong>
                                @subject.Name
                            </strong>

                            <span>
                                @Localizer["Subject"]
                            </span>

                        </div>

                    </label>
                }

            </div>

        </div>

    </div>

</div>
