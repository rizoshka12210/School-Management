@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Teacher>

@{
    ViewData["Title"] = Localizer["Teachers"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Teachers"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage teachers, subjects and assigned groups"]
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + @Localizer["Add Teacher"]
        </a>
    }

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search teacher or email..."]" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Search"]
            </button>

            @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    @Localizer["Clear"]
                </a>
            }

        </form>


        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon"><i class="bi bi-person-workspace"></i></div>

                <h5>
                    @Localizer["No teachers found"]
                </h5>

                <p>
                    @Localizer["No teachers match your search."]
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create"
                       class="btn btn-primary">
                        + @Localizer["Add Teacher"]
                    </a>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>

                        <tr>
                            <th>@Localizer["Teacher"]</th>
                            <th>@Localizer["Groups"]</th>
                            <th>@Localizer["Subjects"]</th>
                            <th>@Localizer["Hourly Rate"]</th>
                            <th class="text-end">
                                @Localizer["Actions"]
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var teacher in Model)
                        {
                            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = teacher.Id })">

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar">

                                            @(string.IsNullOrWhiteSpace(
                                                teacher.ApplicationUser.FullName)
                                                ? "T"
                                                : teacher.ApplicationUser.FullName
                                                    .Substring(0, 1)
                                                    .ToUpper())

                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @teacher.ApplicationUser.FullName
                                            </div>

                                            <div class="person-id">
                                                @teacher.ApplicationUser.Email
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    @if (teacher.Groups.Any())
                                    {
                                        @foreach (var group in
                                            teacher.Groups.Take(2))
                                        {
                                            <span class="group-badge me-1">
                                                @group.Name
                                            </span>
                                        }

                                        @if (teacher.Groups.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                +@(teacher.Groups.Count - 2)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No groups"]
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (teacher.Subjects.Any())
                                    {
                                        @foreach (var subject in
                                            teacher.Subjects.Take(2))
                                        {
                                            <span class="subject-badge me-1">
                                                @subject.Name
                                            </span>
                                        }

                                        @if (teacher.Subjects.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                +@(teacher.Subjects.Count - 2)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No subjects"]
                                        </span>
                                    }

                                </td>


                                <td>
                                    <strong>
                                        @teacher.HourlyRate.ToString("0.##")
                                    </strong>

                                    <span class="text-muted small">
                                        / @Localizer["hour"]
                                    </span>
                                </td>


                                <td class="text-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="action-buttons">

                                            <a asp-action="Edit"
                                               asp-route-id="@teacher.Id"
                                               class="action-btn action-edit">
                                                @Localizer["Edit"]
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@teacher.Id"
                                               class="action-btn action-delete">
                                                @Localizer["Delete"]
                                            </a>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="table-footer">
                @Localizer["Showing {0} teacher(s)", Model.Count()]
            </div>
        }

    </div>

</div>
