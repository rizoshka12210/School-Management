@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Teachers</h1>
            <p class="text-muted mb-0">
                Manage teacher accounts
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Teacher
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No teachers yet</h5>

                    <a asp-action="Create"
                       class="btn btn-primary mt-2">
                        Add Teacher
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Rate</th>
                                <th>Groups</th>
                                <th>Subjects</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var teacher in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @teacher.ApplicationUser.FullName
                                </td>

                                <td>
                                    @teacher.ApplicationUser.Email
                                </td>

                                <td>
                                    @teacher.HourlyRate
                                </td>

                                <td>
                                    @if (teacher.Groups.Any())
                                    {
                                        @string.Join(
                                            ", ",
                                            teacher.Groups.Select(g => g.Name))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            None
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (teacher.Subjects.Any())
                                    {
                                        @string.Join(
                                            ", ",
                                            teacher.Subjects.Select(s => s.Name))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            None
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@teacher.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>
</div>