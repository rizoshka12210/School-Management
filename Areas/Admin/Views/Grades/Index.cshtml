@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Grade>
@using SchoolManagementSystem.Web.Models.Entities

@{
    ViewData["Title"] = Localizer["Grades"];

    var average = Model.Any()
        ? Model.Average(g => g.Value)
        : 0;

    var examGradeHistory = ViewBag.ExamGradeHistory as List<ExamGrade> ?? new List<ExamGrade>();
    var currentExamGradeIds = ViewBag.CurrentExamGradeIds as HashSet<int> ?? new HashSet<int>();

    string GradeClass(decimal? value) => value switch
    {
        null => string.Empty,
        >= 90 => "grade-high",
        >= 75 => "grade-good",
        _ => "grade-low"
    };
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            @Localizer["Grades"]
        </h1>

        <p class="page-subtitle">
            @Localizer["View and correct grades recorded by teachers"]
        </p>

    </div>

</div>

<div class="grade-stats">

    <div class="grade-stat">

        <div class="grade-stat-value">
            @Model.Count()
        </div>

        <div class="grade-stat-label">
            @Localizer["Total Grades"]
        </div>

    </div>

    <div class="grade-stat">

        <div class="grade-stat-value">
            @average.ToString("0.00")
        </div>

        <div class="grade-stat-label">
            @Localizer["Average Grade"]
        </div>

    </div>

    <div class="grade-stat">

        <div class="grade-stat-value">
            @(Model.Any() ? Model.Max(g => g.Value) : 0)
        </div>

        <div class="grade-stat-label">
            @Localizer["Highest Grade"]
        </div>

    </div>

    <div class="grade-stat">

        <div class="grade-stat-value">
            @Model.Select(g => g.StudentId).Distinct().Count()
        </div>

        <div class="grade-stat-label">
            @Localizer["Students Graded"]
        </div>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="grade-filters">

            <div class="record-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search student, subject or teacher..."]" />

            </div>

            <div>

                <select name="subjectId"
                        class="form-select">

                    <option value="">
                        @Localizer["All subjects"]
                    </option>

                    @foreach (var subject in ViewBag.Subjects)
                    {
                        if (ViewBag.SubjectId != null &&
                            (int)ViewBag.SubjectId == subject.Id)
                        {
                            <option value="@subject.Id" selected>
                                @subject.Name
                            </option>
                        }
                        else
                        {
                            <option value="@subject.Id">
                                @subject.Name
                            </option>
                        }
                    }

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Filter"]
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                @Localizer["Clear"]
            </a>

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon"><i class="bi bi-journal-check"></i></div>

                <h5>
                    @Localizer["No grades found"]
                </h5>

                <p>
                    @Localizer["There are no grades matching the selected filters."]
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Teacher"]</th>
                            <th>@Localizer["Grade"]</th>
                            <th>@Localizer["Comment"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var grade in Model)
                        {
                            <tr>

                                <td>

                                    <div class="record-date">
                                        @grade.Date.ToString("dd MMM yyyy")
                                    </div>

                                </td>

                                <td>

                                    <div class="person-cell">

                                        <div class="mini-avatar">
                                            @grade.Student.FirstName.Substring(0, 1).ToUpper()
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @grade.Student.FirstName
                                                @grade.Student.LastName
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Student #{0}", grade.StudentId]
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="subject-badge">
                                        @grade.Subject.Name
                                    </span>

                                </td>

                                <td>
                                    @grade.Teacher.ApplicationUser.FullName
                                </td>

                                <td>

                                    @if (grade.Value >= 90)
                                    {
                                        <span class="grade-badge grade-high">
                                            @grade.Value.ToString("0.##")
                                        </span>
                                    }
                                    else if (grade.Value >= 75)
                                    {
                                        <span class="grade-badge grade-good">
                                            @grade.Value.ToString("0.##")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grade-badge grade-low">
                                            @grade.Value.ToString("0.##")
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        grade.Comment))
                                    {
                                        @grade.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="action-buttons">

                                            <a asp-action="Edit"
                                               asp-route-id="@grade.Id"
                                               class="action-btn action-edit"
                                               title="@Localizer["Edit"]">
                                                @Localizer["Edit"]
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@grade.Id"
                                               class="action-btn action-delete"
                                               title="@Localizer["Delete"]">
                                                @Localizer["Delete"]
                                            </a>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                @Localizer["Showing {0} grade(s)", Model.Count()]
            </div>
        }

    </div>

</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Exam Grade History"]</h5>
                <p class="section-subtitle">@Localizer["Every exam result ever saved across the school, kept permanently. The current result for each student and subject is highlighted."]</p>
            </div>
        </div>

        @if (!examGradeHistory.Any())
        {
            <div class="management-empty">
                <div class="management-empty-icon"><i class="bi bi-journal-check"></i></div>
                <h5>@Localizer["No exam grades found"]</h5>
                <p>@Localizer["There are no exam grades matching the selected filters."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Teacher"]</th>
                            <th>@Localizer["Exam 1"]</th>
                            <th>@Localizer["Exam 2"]</th>
                            <th>@Localizer["Average"]</th>
                            <th>@Localizer["Comment"]</th>
                            <th>@Localizer["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in examGradeHistory)
                        {
                            bool isCurrent = currentExamGradeIds.Contains(exam.Id);
                            <tr class="@(isCurrent ? "" : "text-muted")">
                                <td><div class="record-date">@exam.UpdatedAt.ToString("dd MMM yyyy HH:mm")</div></td>
                                <td>
                                    <div class="person-cell">
                                        <div class="mini-avatar">@exam.Student.FirstName.Substring(0, 1).ToUpper()</div>
                                        <div>
                                            <div class="person-name">@exam.Student.FirstName @exam.Student.LastName</div>
                                            <div class="person-id">@Localizer["Student #{0}", exam.StudentId]</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="subject-badge">@exam.Subject.Name</span></td>
                                <td>@exam.Teacher.ApplicationUser.FullName</td>
                                <td>@(exam.Exam1?.ToString("0.##") ?? "—")</td>
                                <td>@(exam.Exam2?.ToString("0.##") ?? "—")</td>
                                <td><span class="grade-badge @GradeClass(exam.Average)">@(exam.Average?.ToString("0.##") ?? "—")</span></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(exam.Comment))
                                    {
                                        @exam.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (isCurrent)
                                    {
                                        <span class="badge bg-success">@Localizer["Current"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["History"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                @Localizer["Showing {0} grade(s)", examGradeHistory.Count]
            </div>
        }
    </div>
</div>