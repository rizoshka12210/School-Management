@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Grade>

@{
    ViewData["Title"] = Localizer["Grades"];

    var average = Model.Any()
        ? Model.Average(g => g.Value)
        : 0;
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            @Localizer["Grades"]
        </h1>

        <p class="page-subtitle">
            @Localizer["View and correct grades recorded by teachers"]
        </p>

    </div>

</div>

<div class="grade-stats">

    <div class="grade-stat">

        <div class="grade-stat-value">
            @Model.Count()
        </div>

        <div class="grade-stat-label">
            @Localizer["Total Grades"]
        </div>

    </div>

    <div class="grade-stat">

        <div class="grade-stat-value">
            @average.ToString("0.00")
        </div>

        <div class="grade-stat-label">
            @Localizer["Average Grade"]
        </div>

    </div>

    <div class="grade-stat">

        <div class="grade-stat-value">
            @(Model.Any() ? Model.Max(g => g.Value) : 0)
        </div>

        <div class="grade-stat-label">
            @Localizer["Highest Grade"]
        </div>

    </div>

    <div class="grade-stat">

        <div class="grade-stat-value">
            @Model.Select(g => g.StudentId).Distinct().Count()
        </div>

        <div class="grade-stat-label">
            @Localizer["Students Graded"]
        </div>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="grade-filters">

            <div class="record-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search student, subject or teacher..."]" />

            </div>

            <div>

                <select name="subjectId"
                        class="form-select">

                    <option value="">
                        @Localizer["All subjects"]
                    </option>

                    @foreach (var subject in ViewBag.Subjects)
                    {
                        if (ViewBag.SubjectId != null &&
                            (int)ViewBag.SubjectId == subject.Id)
                        {
                            <option value="@subject.Id" selected>
                                @subject.Name
                            </option>
                        }
                        else
                        {
                            <option value="@subject.Id">
                                @subject.Name
                            </option>
                        }
                    }

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Filter"]
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                @Localizer["Clear"]
            </a>

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon"><i class="bi bi-journal-check"></i></div>

                <h5>
                    @Localizer["No grades found"]
                </h5>

                <p>
                    @Localizer["There are no grades matching the selected filters."]
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Teacher"]</th>
                            <th>@Localizer["Grade"]</th>
                            <th>@Localizer["Comment"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var grade in Model)
                        {
                            <tr>

                                <td>

                                    <div class="record-date">
                                        @grade.Date.ToString("dd MMM yyyy")
                                    </div>

                                </td>

                                <td>

                                    <div class="person-cell">

                                        <div class="mini-avatar">
                                            @grade.Student.FirstName.Substring(0, 1).ToUpper()
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @grade.Student.FirstName
                                                @grade.Student.LastName
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Student #{0}", grade.StudentId]
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="subject-badge">
                                        @grade.Subject.Name
                                    </span>

                                </td>

                                <td>
                                    @grade.Teacher.ApplicationUser.FullName
                                </td>

                                <td>

                                    @if (grade.Value >= 5)
                                    {
                                        <span class="grade-badge grade-high">
                                            @grade.Value
                                        </span>
                                    }
                                    else if (grade.Value >= 4)
                                    {
                                        <span class="grade-badge grade-good">
                                            @grade.Value
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grade-badge grade-low">
                                            @grade.Value
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        grade.Comment))
                                    {
                                        @grade.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="action-buttons">

                                            <a asp-action="Edit"
                                               asp-route-id="@grade.Id"
                                               class="action-btn action-edit"
                                               title="@Localizer["Edit"]">
                                                @Localizer["Edit"]
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@grade.Id"
                                               class="action-btn action-delete"
                                               title="@Localizer["Delete"]">
                                                @Localizer["Delete"]
                                            </a>

                                        </div>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                @Localizer["Showing {0} grade(s)", Model.Count()]
            </div>
        }

    </div>

</div>