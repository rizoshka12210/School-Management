@model SchoolManagementSystem.Web.Models.Entities.Grade

@{
    ViewData["Title"] = Localizer["Delete Grade"];
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        @Localizer["Delete Grade"]
                    </h2>

                    <p class="mt-3">
                        @Localizer["Are you sure you want to delete this grade?"]
                    </p>

                    <hr />

                    <p>
                        <strong>@Localizer["Student"]:</strong>
                        @Model.Student.FirstName @Model.Student.LastName
                    </p>

                    <p>
                        <strong>@Localizer["Subject"]:</strong>
                        @Model.Subject.Name
                    </p>

                    <p>
                        <strong>@Localizer["Teacher"]:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <p>
                        <strong>@Localizer["Date"]:</strong>
                        @Model.Date.ToString("dd.MM.yyyy")
                    </p>

                    <p>
                        <strong>@Localizer["Grade"]:</strong>
                        @Model.Value.ToString("0.##")
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Yes, Delete"]
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
