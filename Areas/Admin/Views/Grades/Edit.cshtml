@model SchoolManagementSystem.Web.ViewModels.Admin.GradeFormViewModel

@{
    ViewData["Title"] = Localizer["Edit Grade"];
}

<div class="form-page-header">

    <a asp-action="Index"
       class="back-link">
        ← @Localizer["Grades"]
    </a>

    <h1 class="page-title mt-2">
        @Localizer["Edit Grade"]
    </h1>

    <p class="page-subtitle">
        @Localizer["Correct the grade for {0}", Model.StudentName]
    </p>

</div>

<form asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="form-card">

        <div class="form-card-header">

            <h5>@Localizer["Grade"]</h5>

            <p>
                @Model.SubjectName • @Model.TeacherName •
                @Model.Date.ToString("dd MMM yyyy")
            </p>

        </div>

        <div class="form-card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="Value"
                           class="form-label">
                        @Localizer["Grade"]
                    </label>

                    <input asp-for="Value"
                           type="number"
                           min="0"
                           max="100"
                           class="form-control" />

                    <span asp-validation-for="Value"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="Comment"
                           class="form-label">
                        @Localizer["Comment"]
                    </label>

                    <input asp-for="Comment"
                           class="form-control"
                           placeholder="@Localizer["Optional comment"]" />

                    <span asp-validation-for="Comment"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            @Localizer["Cancel"]
        </a>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["Save Changes"]
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
