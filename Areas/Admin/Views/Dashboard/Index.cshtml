@model SchoolManagementSystem.Web.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = Localizer["Dashboard"];
}

<style>
    .main-wrapper {
        width: calc(100% - 250px);
        max-width: calc(100% - 250px);
        min-width: 0;
    }

    .page-content {
        min-width: 0;
        max-width: 100%;
        overflow-x: hidden;
    }

    .attendance-trend-column,
    .attendance-trend-column > .card,
    .attendance-trend-column > .card > .card-body {
        min-width: 0;
        max-width: 100%;
    }

    .attendance-chart-viewport {
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: .85rem;
        overscroll-behavior-x: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(79, 70, 229, .45) rgba(148, 163, 184, .12);
    }

    .attendance-chart-viewport .attendance-chart {
        margin: 0;
        padding-bottom: 0;
    }

    .attendance-chart-month {
        width: max-content;
        min-width: 100%;
        max-width: none;
        overflow: visible;
    }

    .attendance-chart-month .attendance-bar-column {
        flex: 0 0 46px;
        width: 46px;
        min-width: 46px;
        max-width: 46px;
    }

    .attendance-chart-viewport::-webkit-scrollbar {
        height: 8px;
    }

    .attendance-chart-viewport::-webkit-scrollbar-track {
        background: rgba(148, 163, 184, .12);
        border-radius: 999px;
    }

    .attendance-chart-viewport::-webkit-scrollbar-thumb {
        background: rgba(79, 70, 229, .45);
        border-radius: 999px;
    }

    .attendance-chart-viewport::-webkit-scrollbar-thumb:hover {
        background: rgba(79, 70, 229, .65);
    }

    html[data-theme="dark"] .attendance-chart-viewport {
        scrollbar-color: rgba(129, 140, 248, .65) rgba(51, 65, 85, .55);
    }

    html[data-theme="dark"] .attendance-chart-viewport::-webkit-scrollbar-track {
        background: rgba(51, 65, 85, .55);
    }

    html[data-theme="dark"] .attendance-chart-viewport::-webkit-scrollbar-thumb {
        background: rgba(129, 140, 248, .65);
    }

    @media (max-width: 992px) {
        .main-wrapper {
            width: calc(100% - 210px);
            max-width: calc(100% - 210px);
        }
    }

    @media (max-width: 768px) {
        .main-wrapper {
            width: 100%;
            max-width: 100%;
        }
    }
</style>

<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">@Localizer["Smart School Dashboard"]</h1>
        <p class="dashboard-subtitle">@Localizer["Live academic performance, attendance and student risk analytics."]</p>
    </div>
    <div class="dashboard-date"><i class="bi bi-calendar3 me-2"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
</div>

<div class="analytics-grid mb-4">
    <div class="analytics-card">
        <div class="analytics-icon analytics-icon-grade"><i class="bi bi-award-fill"></i></div>
        <div>
            <span>@Localizer["Average Grade"]</span>
            <strong>@Model.AverageGrade.ToString("0.00")</strong>
            <small>@Localizer["School-wide average"]</small>
        </div>
    </div>

    <div class="analytics-card">
        <div class="analytics-icon analytics-icon-attendance"><i class="bi bi-clipboard2-check-fill"></i></div>
        <div>
            <span>@Localizer["Attendance"]</span>
            <strong>@Model.AttendanceRate.ToString("0.0")%</strong>
            <small>@Localizer["All attendance records"]</small>
        </div>
    </div>

    <div class="analytics-card analytics-danger">
        <div class="analytics-icon analytics-icon-absent"><i class="bi bi-person-fill-x"></i></div>
        <div>
            <span>@Localizer["Students Absent Today"]</span>
            <strong>@Model.StudentsAbsentToday</strong>
            <small>@Localizer["Unique students"]</small>
        </div>
    </div>

    <div class="analytics-card">
        <div class="analytics-icon analytics-icon-lessons"><i class="bi bi-journal-bookmark-fill"></i></div>
        <div>
            <span>@Localizer["Lessons Today"]</span>
            <strong>@Model.TodayLessonsCount</strong>
            <small>@Localizer["Scheduled lessons"]</small>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-8 attendance-trend-column">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title"><i class="bi bi-graph-up-arrow section-title-icon"></i>@Localizer["Attendance Trend"]</h5>
                        <p class="section-subtitle">@Localizer["Daily attendance percentage"]</p>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Index" asp-route-period="week"
                           class="btn @(Model.TrendPeriod == "week" ? "btn-primary" : "btn-outline-primary")">@Localizer["Week"]</a>
                        <a asp-action="Index" asp-route-period="month"
                           class="btn @(Model.TrendPeriod == "month" ? "btn-primary" : "btn-outline-primary")">@Localizer["Month"]</a>
                    </div>
                </div>

                <div class="attendance-chart-viewport">
                    <div class="attendance-chart @(Model.TrendPeriod == "month" ? "attendance-chart-month" : "")">
                        @foreach (var point in Model.AttendanceTrend)
                        {
                            <div class="attendance-bar-column" title="@point.Label: @point.Rate.ToString("0.0")%">
                                <div class="attendance-bar-value">@point.Rate.ToString("0")%</div>
                                <div class="attendance-bar-track">
                                    <div class="attendance-bar" style="height:@Math.Max(3, point.Rate).ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <div class="attendance-bar-label">@point.Label</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title"><i class="bi bi-building section-title-icon"></i>@Localizer["School Overview"]</h5>
                        <p class="section-subtitle">@Localizer["Current system totals"]</p>
                    </div>
                </div>
                <div class="overview-mini-grid">
                    <div><span><i class="bi bi-people-fill me-1"></i>@Localizer["Students"]</span><strong>@Model.StudentsCount</strong></div>
                    <div><span><i class="bi bi-person-workspace me-1"></i>@Localizer["Teachers"]</span><strong>@Model.TeachersCount</strong></div>
                    <div><span><i class="bi bi-collection-fill me-1"></i>@Localizer["Groups"]</span><strong>@Model.GroupsCount</strong></div>
                    <div><span><i class="bi bi-book-fill me-1"></i>@Localizer["Subjects"]</span><strong>@Model.SubjectsCount</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title"><i class="bi bi-trophy-fill section-title-icon section-title-icon-gold"></i>@Localizer["Top 5 Students"]</h5>
                        <p class="section-subtitle">@Localizer["Best average grades with attendance as tie-breaker"]</p>
                    </div>
                </div>

                @if (!Model.TopStudents.Any())
                {
                    <div class="dashboard-empty"><p>@Localizer["No grade data yet."]</p></div>
                }
                else
                {
                    <div class="performance-list">
                        @for (var i = 0; i < Model.TopStudents.Count; i++)
                        {
                            var student = Model.TopStudents[i];
                            <a asp-area="Admin" asp-controller="Students" asp-action="Details" asp-route-id="@student.StudentId" class="performance-item">
                                <span class="performance-rank">#@(i + 1)</span>
                                <div class="performance-main">
                                    <strong>@student.FullName</strong>
                                    <small>@student.GroupName</small>
                                </div>
                                <div class="performance-score">
                                    <strong>@student.AverageGrade.ToString("0.00")</strong>
                                    <small>@student.AttendanceRate.ToString("0")% @Localizer["att."]</small>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title"><i class="bi bi-shield-fill-exclamation section-title-icon section-title-icon-danger"></i>@Localizer["Early Warning System"]</h5>
                        <p class="section-subtitle">@Localizer["Students who need attention right now"]</p>
                    </div>
                </div>

                @if (!Model.StudentsNeedingAttention.Any())
                {
                    <div class="dashboard-empty"><p>@Localizer["All students are currently in the good zone."]</p></div>
                }
                else
                {
                    <div class="risk-list">
                        @foreach (var student in Model.StudentsNeedingAttention)
                        {
                            var riskIcon = student.RiskCssClass == "risk-danger"
                                ? "bi-exclamation-octagon-fill"
                                : "bi-exclamation-triangle-fill";
                            <a asp-area="Admin" asp-controller="Students" asp-action="Details" asp-route-id="@student.StudentId" class="risk-item @student.RiskCssClass">
                                <div class="risk-icon"><i class="bi @riskIcon"></i></div>
                                <div class="risk-main">
                                    <strong>@student.FullName</strong>
                                    <span>@Localizer[student.RiskLabel]</span>
                                    <small>@string.Join(" · ", student.RiskReasons.Take(2).Select(r => Localizer[r].Value))</small>
                                </div>
                                <div class="risk-metrics">
                                    <span>@Localizer["Grade"] @student.AverageGrade.ToString("0.0")</span>
                                    <span>@Localizer["Attendance"] @student.AttendanceRate.ToString("0")%</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div>
                        <h5 class="section-title"><i class="bi bi-easel2-fill section-title-icon"></i>@Localizer["Today's Lessons"]</h5>
                        <p class="section-subtitle">@Localizer["{0} lesson(s) today", Model.TodayLessonsCount]</p>
                    </div>
                    <a asp-area="Admin" asp-controller="Lessons" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["View All"]</a>
                </div>

                @if (!Model.TodayLessons.Any())
                {
                    <div class="dashboard-empty"><p>@Localizer["No lessons today"]</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle dashboard-table">
                            <thead><tr><th>@Localizer["Time"]</th><th>@Localizer["Group"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Teacher"]</th><th>@Localizer["Topic"]</th></tr></thead>
                            <tbody>
                            @foreach (var lesson in Model.TodayLessons)
                            {
                                <tr>
                                    <td><strong>@lesson.StartTime.ToString("HH:mm")</strong> <span class="text-muted">- @lesson.EndTime.ToString("HH:mm")</span></td>
                                    <td><span class="dashboard-badge">@lesson.Group.Name</span></td>
                                    <td class="fw-semibold">@lesson.Subject.Name</td>
                                    <td>@lesson.Teacher.ApplicationUser.FullName</td>
                                    <td>@(string.IsNullOrWhiteSpace(lesson.Topic) ? "—" : lesson.Topic)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="section-header">
                    <div><h5 class="section-title"><i class="bi bi-person-plus-fill section-title-icon"></i>@Localizer["Recent Students"]</h5><p class="section-subtitle">@Localizer["Recently added students"]</p></div>
                </div>
                <div class="recent-list">
                    @foreach (var student in Model.RecentStudents)
                    {
                        <a asp-area="Admin" asp-controller="Students" asp-action="Details" asp-route-id="@student.Id" class="recent-item">
                            <div class="recent-avatar">@(student.FirstName.Substring(0, 1).ToUpper())</div>
                            <div class="recent-info"><strong>@student.FirstName @student.LastName</strong><span>@(student.Group?.Name ?? Localizer["No group"].Value)</span></div>
                            <div class="recent-arrow"><i class="bi bi-chevron-right"></i></div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="section-header">
                    <div><h5 class="section-title"><i class="bi bi-calendar-event-fill section-title-icon"></i>@Localizer["Upcoming Events"]</h5><p class="section-subtitle">@Localizer["From the school calendar"]</p></div>
                    <a asp-area="Admin" asp-controller="Calendar" asp-action="Index" class="btn btn-sm btn-outline-primary">@Localizer["View All"]</a>
                </div>

                @if (!Model.UpcomingEvents.Any())
                {
                    <div class="dashboard-empty"><p>@Localizer["No upcoming events."]</p></div>
                }
                else
                {
                    <div class="performance-list">
                        @foreach (var evt in Model.UpcomingEvents)
                        {
                            <div class="performance-item">
                                <span class="performance-rank">@evt.Date.ToString("dd MMM")</span>
                                <div class="performance-main">
                                    <strong>@evt.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(evt.Description))
                                    {
                                        <small>@evt.Description</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
