@model SchoolManagementSystem.Web.ViewModels.Admin.CalendarEventFormViewModel

@{
    ViewData["Title"] = Localizer["Edit Event"];
}

<div class="form-page-header">
    <a asp-action="Index" class="back-link">← @Localizer["School Calendar"]</a>

    <h1 class="page-title mt-2">@Localizer["Edit Event"]</h1>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <partial name="_Form" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light">@Localizer["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@Localizer["Save Changes"]</button>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
