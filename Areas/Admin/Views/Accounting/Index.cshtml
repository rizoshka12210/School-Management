@model SchoolManagementSystem.Web.ViewModels.Admin.StudentAccountingViewModel

@{
    ViewData["Title"] = Localizer["Student Accounting"];

    string[] monthNames =
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };

    string StatusText(string status) => status switch
    {
        "paid" => Localizer["Paid"],
        "partial" => Localizer["Partial"],
        "unpaid" => Localizer["Not paid"],
        _ => Localizer["Fee not assigned"]
    };

    string StatusClass(string status) => status switch
    {
        "paid" => "accounting-status accounting-status-paid",
        "partial" => "accounting-status accounting-status-partial",
        "unpaid" => "accounting-status accounting-status-unpaid",
        _ => "accounting-status accounting-status-notset"
    };
}

<div class="accounting-page">
    <section class="accounting-hero">
        <div>
            <div class="accounting-eyebrow">@Localizer["SCHOOL FINANCE"]</div>
            <h1>@Localizer["Student Accounting"]</h1>
            <p>@Localizer["Payments for {0} {1} — charges, receipts and outstanding balance of students.", Localizer[monthNames[Model.Month - 1]], Model.Year]</p>
        </div>
        <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-light accounting-students-btn">
            <i class="bi bi-people-fill"></i>
            @Localizer["Students"]
        </a>
    </section>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <section class="accounting-panel accounting-filter-panel">
        <div class="accounting-panel-title">
            <div>
                <h2>@Localizer["Filters"]</h2>
                <p>@Localizer["Find a student or choose the period."]</p>
            </div>
            <i class="bi bi-funnel"></i>
        </div>

        <form method="get" asp-action="Index" class="accounting-filter-grid">
            <div class="accounting-field accounting-search-field">
                <label>@Localizer["Search"]</label>
                <div class="accounting-input-icon">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Student name or group"]" />
                </div>
            </div>

            <div class="accounting-field">
                <label>@Localizer["Group"]</label>
                <select name="groupId" class="form-select">
                    <option value="">@Localizer["All groups"]</option>
                    @foreach (var group in Model.Groups)
                    {
                        if (Model.GroupId == group.Id)
                        {
                            <option value="@group.Id" selected>@group.Name</option>
                        }
                        else
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="accounting-field">
                <label>@Localizer["Status"]</label>
                <select name="status" class="form-select">
                    <option value="">@Localizer["All statuses"]</option>
                    @if (Model.Status == "paid") { <option value="paid" selected>@Localizer["Paid"]</option> } else { <option value="paid">@Localizer["Paid"]</option> }
                    @if (Model.Status == "partial") { <option value="partial" selected>@Localizer["Partial"]</option> } else { <option value="partial">@Localizer["Partial"]</option> }
                    @if (Model.Status == "unpaid") { <option value="unpaid" selected>@Localizer["Not paid"]</option> } else { <option value="unpaid">@Localizer["Not paid"]</option> }
                    @if (Model.Status == "not-set") { <option value="not-set" selected>@Localizer["Fee not assigned"]</option> } else { <option value="not-set">@Localizer["Fee not assigned"]</option> }
                </select>
            </div>

            <div class="accounting-field">
                <label>@Localizer["Month"]</label>
                <select name="month" class="form-select">
                    @for (var i = 1; i <= 12; i++)
                    {
                        if (i == Model.Month)
                        {
                            <option value="@i" selected>@Localizer[monthNames[i - 1]]</option>
                        }
                        else
                        {
                            <option value="@i">@Localizer[monthNames[i - 1]]</option>
                        }
                    }
                </select>
            </div>

            <div class="accounting-field accounting-year-field">
                <label>@Localizer["Year"]</label>
                <select name="year" class="form-select">
                    @for (var y = DateTime.UtcNow.Year - 3; y <= DateTime.UtcNow.Year + 1; y++)
                    {
                        if (y == Model.Year)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>

            <div class="accounting-filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2-circle"></i>
                    @Localizer["Apply"]
                </button>
                <a asp-action="Index" class="btn btn-light">@Localizer["Clear"]</a>
            </div>
        </form>
    </section>

    <section class="accounting-stats-grid">
        <div class="accounting-stat-card">
            <div class="accounting-stat-icon accounting-stat-purple"><i class="bi bi-receipt"></i></div>
            <div>
                <span>@Localizer["Charged"]</span>
                <strong>@Model.TotalExpected.ToString("0.00")</strong>
            </div>
        </div>
        <div class="accounting-stat-card">
            <div class="accounting-stat-icon accounting-stat-green"><i class="bi bi-wallet2"></i></div>
            <div>
                <span>@Localizer["Collected"]</span>
                <strong>@Model.TotalPaid.ToString("0.00")</strong>
            </div>
        </div>
        <div class="accounting-stat-card">
            <div class="accounting-stat-icon accounting-stat-red"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <span>@Localizer["Remaining to collect"]</span>
                <strong>@Model.TotalDebt.ToString("0.00")</strong>
            </div>
        </div>
        <div class="accounting-stat-card">
            <div class="accounting-stat-icon accounting-stat-blue"><i class="bi bi-check-circle"></i></div>
            <div>
                <span>@Localizer["Fully paid"]</span>
                <strong>@Model.PaidCount</strong>
            </div>
        </div>
    </section>

    <section class="accounting-summary-grid">
        <div class="accounting-panel">
            <div class="accounting-panel-title compact">
                <div>
                    <h2>@Localizer["Statuses for the month"]</h2>
                    <p>@Localizer["Payment status for the selected period."]</p>
                </div>
            </div>
            <div class="accounting-status-list">
                <div class="accounting-status-item paid"><span class="dot"></span><span>@Localizer["Paid"]</span><strong>@Model.PaidCount</strong></div>
                <div class="accounting-status-item partial"><span class="dot"></span><span>@Localizer["Partial"]</span><strong>@Model.PartialCount</strong></div>
                <div class="accounting-status-item unpaid"><span class="dot"></span><span>@Localizer["Not paid"]</span><strong>@Model.UnpaidCount</strong></div>
                <div class="accounting-status-item notset"><span class="dot"></span><span>@Localizer["Fee not assigned"]</span><strong>@Model.NotSetCount</strong></div>
            </div>
        </div>

        <div class="accounting-panel">
            <div class="accounting-panel-title compact">
                <div>
                    <h2>@Localizer["Assign monthly fee"]</h2>
                    <p>
                        @if (Model.GroupId.HasValue)
                        {
                            @Localizer["Set the amount for the selected group. Entered payments are kept."]
                        }
                        else
                        {
                            @Localizer["Set the amount for all students. Entered payments are kept."]
                        }
                    </p>
                </div>
            </div>
            <form asp-action="SetMonthlyFee" method="post" class="accounting-fee-form">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                @if (Model.GroupId.HasValue)
                {
                    <input type="hidden" name="groupId" value="@Model.GroupId.Value" />
                }
                <div class="accounting-input-icon">
                    <i class="bi bi-cash-stack"></i>
                    <input type="number" name="amount" min="0" step="0.01" class="form-control" placeholder="@Localizer["Amount"]" required />
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    @Localizer["Assign to all"]
                </button>
            </form>
        </div>
    </section>

    <section class="accounting-panel accounting-register-panel">
        <div class="accounting-register-header">
            <div>
                <h2>@Localizer["Payment Register"]</h2>
                <p>@Localizer["Showing {0} student(s)", Model.Rows.Count]</p>
            </div>
            <div class="accounting-period-chip">
                <i class="bi bi-calendar3"></i>
                @Localizer[monthNames[Model.Month - 1]] @Model.Year
            </div>
        </div>

        @if (!Model.Rows.Any())
        {
            <div class="accounting-empty">
                <div class="accounting-empty-icon"><i class="bi bi-search"></i></div>
                <h3>@Localizer["No students match the selected filters"]</h3>
                <p>@Localizer["Change the group, status, month or search text."]</p>
            </div>
        }
        else
        {
            <div class="accounting-payment-list">
                @foreach (var row in Model.Rows)
                {
                    var formId = $"payment-{row.StudentId}";
                    <article class="accounting-payment-card">
                        <div class="accounting-student-block">
                            <div class="accounting-avatar">
                                @(string.IsNullOrWhiteSpace(row.StudentName) ? "S" : row.StudentName.Substring(0, 1).ToUpper())
                            </div>
                            <div class="accounting-student-info">
                                <strong>@row.StudentName</strong>
                                <span>@Localizer["Student #{0}", row.StudentId]</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(row.GroupName))
                            {
                                <span class="accounting-group-chip">@row.GroupName</span>
                            }
                            else
                            {
                                <span class="accounting-group-chip muted">@Localizer["No group"]</span>
                            }
                        </div>

                        <div class="accounting-payment-status">
                            <span class="@StatusClass(row.Status)">@StatusText(row.Status)</span>
                            <div class="accounting-balance">
                                <span>@Localizer["Balance"]</span>
                                <strong>@row.Balance.ToString("0.00")</strong>
                            </div>
                        </div>

                        <div class="accounting-payment-fields">
                            <div class="accounting-field">
                                <label>@Localizer["Charged"]</label>
                                <input form="@formId" type="number" name="expectedAmount" min="0" step="0.01"
                                       value="@row.ExpectedAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control" />
                            </div>
                            <div class="accounting-field">
                                <label>@Localizer["Paid"]</label>
                                <input form="@formId" type="number" name="paidAmount" min="0" step="0.01"
                                       value="@row.PaidAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control" />
                            </div>
                            <div class="accounting-field">
                                <label>@Localizer["Payment Date"]</label>
                                <input form="@formId" type="date" name="paidAt" value="@(row.PaidAt?.ToString("yyyy-MM-dd"))" class="form-control" />
                            </div>
                            <div class="accounting-field accounting-note-field">
                                <label>@Localizer["Comment"]</label>
                                <input form="@formId" type="text" name="note" value="@row.Note" maxlength="500"
                                       class="form-control" placeholder="@Localizer["e.g. cash"]" />
                            </div>
                        </div>

                        <div class="accounting-payment-actions">
                            <form id="@formId" asp-action="Update" method="post">
                                <input type="hidden" name="studentId" value="@row.StudentId" />
                                <input type="hidden" name="year" value="@Model.Year" />
                                <input type="hidden" name="month" value="@Model.Month" />
                                @if (Model.GroupId.HasValue)
                                {
                                    <input type="hidden" name="groupId" value="@Model.GroupId.Value" />
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Status))
                                {
                                    <input type="hidden" name="status" value="@Model.Status" />
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Search))
                                {
                                    <input type="hidden" name="search" value="@Model.Search" />
                                }
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-floppy"></i>
                                    @Localizer["Save"]
                                </button>
                            </form>

                            @if (row.ExpectedAmount > 0 && row.PaidAmount < row.ExpectedAmount)
                            {
                                <form asp-action="MarkPaid" method="post">
                                    <input type="hidden" name="studentId" value="@row.StudentId" />
                                    <input type="hidden" name="year" value="@Model.Year" />
                                    <input type="hidden" name="month" value="@Model.Month" />
                                    @if (Model.GroupId.HasValue)
                                    {
                                        <input type="hidden" name="groupId" value="@Model.GroupId.Value" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Status))
                                    {
                                        <input type="hidden" name="status" value="@Model.Status" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                                    {
                                        <input type="hidden" name="search" value="@Model.Search" />
                                    }
                                    <button type="submit"
                                            class="btn btn-outline-success accounting-mark-paid-btn"
                                            title="@Localizer["Mark this student as fully paid"]">
                                        <i class="bi bi-check-circle-fill"></i>
                                        @Localizer["Paid in full"]
                                    </button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
