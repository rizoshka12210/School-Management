@model SchoolManagementSystem.Web.Models.Entities.Lesson

@{
    ViewData["Title"] = Localizer["Lesson Details"];
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        @Localizer["Lesson Details"]
                    </h2>

                    <hr />

                    <p>
                        <strong>@Localizer["Date"]:</strong>
                        @Model.StartTime.ToString("dd.MM.yyyy")
                    </p>

                    <p>
                        <strong>@Localizer["Time"]:</strong>

                        @Model.StartTime.ToString("HH:mm")
                        -
                        @Model.EndTime.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>@Localizer["Group"]:</strong>
                        @Model.Group.Name
                    </p>

                    <p>
                        <strong>@Localizer["Subject"]:</strong>
                        @Model.Subject.Name
                    </p>

                    <p>
                        <strong>@Localizer["Teacher"]:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <p>
                        <strong>@Localizer["Topic"]:</strong>
                        @(Model.Topic ?? Localizer["No topic"].Value)
                    </p>

                    <hr />

                    <p>
                        <strong>@Localizer["Attendance records"]:</strong>
                        @Model.Attendances.Count
                    </p>

                    <p>
                        <strong>@Localizer["Grades"]:</strong>
                        @Model.Grades.Count
                    </p>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        @Localizer["Edit"]
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        @Localizer["Back"]
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
