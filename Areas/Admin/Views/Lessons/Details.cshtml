@model SchoolManagementSystem.Web.Models.Entities.Lesson

@{
    ViewData["Title"] = Localizer["Lesson Details"];
    var duration = Model.EndTime - Model.StartTime;
}

<link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />

<div class="entity-details-page">
    <a asp-action="Index" class="entity-details-back">
        <i class="bi bi-arrow-left"></i>
        @Localizer["Lessons"]
    </a>

    <section class="entity-details-hero">
        <div class="entity-details-identity">
            <div class="entity-details-icon">
                <i class="bi bi-easel2-fill"></i>
            </div>
            <div>
                <span class="entity-details-eyebrow">@Localizer["Lesson Details"]</span>
                <h1 class="entity-details-title">@Model.Subject.Name</h1>
                <p class="entity-details-subtitle">@Model.Group.Name · @Model.StartTime.ToString("dd MMM yyyy")</p>
                <div class="entity-details-meta">
                    <span class="entity-meta-badge"><i class="bi bi-clock-fill"></i>@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</span>
                    <span class="entity-meta-badge"><i class="bi bi-person-workspace"></i>@Model.Teacher.ApplicationUser.FullName</span>
                    <span class="entity-meta-badge"><i class="bi bi-hash"></i>ID @Model.Id</span>
                </div>
            </div>
        </div>

        <div class="entity-details-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i>
                @Localizer["Edit"]
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                @Localizer["Back"]
            </a>
        </div>
    </section>

    <div class="entity-kpi-grid entity-kpi-grid-3">
        <div class="entity-kpi-card">
            <div class="entity-kpi-icon blue"><i class="bi bi-clipboard2-check-fill"></i></div>
            <div class="entity-kpi-content">
                <span>@Localizer["Attendance records"]</span>
                <strong>@Model.Attendances.Count</strong>
                <small>@Localizer["Attendance"]</small>
            </div>
        </div>
        <div class="entity-kpi-card">
            <div class="entity-kpi-icon orange"><i class="bi bi-journal-check"></i></div>
            <div class="entity-kpi-content">
                <span>@Localizer["Grades"]</span>
                <strong>@Model.Grades.Count</strong>
                <small>@Localizer["Grades"]</small>
            </div>
        </div>
        <div class="entity-kpi-card">
            <div class="entity-kpi-icon green"><i class="bi bi-hourglass-split"></i></div>
            <div class="entity-kpi-content">
                <span>@Localizer["Time"]</span>
                <strong>@duration.TotalMinutes.ToString("0") min</strong>
                <small>@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</small>
            </div>
        </div>
    </div>

    <div class="entity-details-grid entity-details-grid-wide">
        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-info-circle-fill"></i>@Localizer["Lesson Details"]</h2>
                </div>
            </div>
            <div class="entity-panel-body">
                <div class="entity-facts">
                    <div class="entity-fact"><span>@Localizer["Date"]</span><strong>@Model.StartTime.ToString("dd MMMM yyyy")</strong></div>
                    <div class="entity-fact"><span>@Localizer["Time"]</span><strong>@Model.StartTime.ToString("HH:mm") - @Model.EndTime.ToString("HH:mm")</strong></div>
                    <div class="entity-fact">
                        <span>@Localizer["Group"]</span>
                        <a asp-area="Admin" asp-controller="Groups" asp-action="Details" asp-route-id="@Model.GroupId">@Model.Group.Name</a>
                    </div>
                    <div class="entity-fact">
                        <span>@Localizer["Subject"]</span>
                        <a asp-area="Admin" asp-controller="Subjects" asp-action="Details" asp-route-id="@Model.SubjectId">@Model.Subject.Name</a>
                    </div>
                    <div class="entity-fact">
                        <span>@Localizer["Teacher"]</span>
                        <a asp-area="Admin" asp-controller="Teachers" asp-action="Details" asp-route-id="@Model.TeacherId">@Model.Teacher.ApplicationUser.FullName</a>
                    </div>
                    <div class="entity-fact"><span>ID</span><strong>#@Model.Id</strong></div>
                </div>
            </div>
        </section>

        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-book-half"></i>@Localizer["Topic"]</h2>
                </div>
            </div>
            <div class="entity-panel-body">
                @if (!string.IsNullOrWhiteSpace(Model.Topic))
                {
                    <div class="entity-topic-box">@Model.Topic</div>
                }
                else
                {
                    <div class="entity-empty"><div><i class="bi bi-journal-x"></i>@Localizer["No topic"]</div></div>
                }
            </div>
        </section>
    </div>
</div>
