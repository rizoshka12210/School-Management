@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Lesson>

@{
    ViewData["Title"] = "Lessons";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Lessons
            </h1>

            <p class="text-muted mb-0">
                Manage school lessons
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Lesson
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No lessons yet</h5>

                    <p class="text-muted">
                        Create your first lesson.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Lesson
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Group</th>
                                <th>Subject</th>
                                <th>Teacher</th>
                                <th>Topic</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var lesson in Model)
                        {
                            <tr>

                                <td>
                                    @lesson.StartTime.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @lesson.StartTime.ToString("HH:mm")
                                    -
                                    @lesson.EndTime.ToString("HH:mm")
                                </td>

                                <td>
                                    @lesson.Group.Name
                                </td>

                                <td>
                                    @lesson.Subject.Name
                                </td>

                                <td>
                                    @lesson.Teacher.ApplicationUser.FullName
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(lesson.Topic))
                                    {
                                        @lesson.Topic
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No topic
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@lesson.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@lesson.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@lesson.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>