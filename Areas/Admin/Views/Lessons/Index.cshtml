@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Lesson>

@{
    ViewData["Title"] = "Lessons";
}

<div class="page-header">

    <div>
        <h1 class="page-title">Lessons</h1>

        <p class="page-subtitle">
            Manage lessons, teachers, subjects and lesson topics
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Lesson
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="lesson-filters">

            <div class="lesson-search">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search subject, teacher, group or topic..." />
            </div>

            <div>
                <input type="date"
                       name="date"
                       value="@ViewBag.Date"
                       class="form-control" />
            </div>

            <div>
                <select name="groupId"
                        class="form-select">

                    <option value="">
                        All groups
                    </option>

                    @foreach (var group in ViewBag.Groups)
                    {
                        if (ViewBag.GroupId != null &&
                            (int)ViewBag.GroupId == group.Id)
                        {
                            <option value="@group.Id" selected>
                                @group.Name
                            </option>
                        }
                        else
                        {
                            <option value="@group.Id">
                                @group.Name
                            </option>
                        }
                    }

                </select>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Filter
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                Clear
            </a>

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    LS
                </div>

                <h5>No lessons found</h5>

                <p>
                    There are no lessons matching the selected filters.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add Lesson
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Group</th>
                            <th>Subject</th>
                            <th>Teacher</th>
                            <th>Topic</th>
                            <th class="text-end">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var lesson in Model)
                        {
                            <tr>

                                <td>

                                    <div class="lesson-date">
                                        @lesson.StartTime.ToString("dd MMM yyyy")
                                    </div>

                                    <div class="lesson-time-range">
                                        @lesson.StartTime.ToString("HH:mm")
                                        –
                                        @lesson.EndTime.ToString("HH:mm")
                                    </div>

                                </td>

                                <td>
                                    <span class="group-badge">
                                        @lesson.Group.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="subject-badge">
                                        @lesson.Subject.Name
                                    </span>
                                </td>

                                <td>

                                    <div class="person-cell">

                                        <div class="mini-avatar">
                                            @(string.IsNullOrWhiteSpace(
                                                lesson.Teacher.ApplicationUser.FullName)
                                                ? "T"
                                                : lesson.Teacher.ApplicationUser.FullName
                                                    .Substring(0, 1)
                                                    .ToUpper())
                                        </div>

                                        <span class="fw-semibold">
                                            @lesson.Teacher.ApplicationUser.FullName
                                        </span>

                                    </div>

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        lesson.Topic))
                                    {
                                        <span>
                                            @lesson.Topic
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No topic
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@lesson.Id"
                                           class="action-btn action-details">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@lesson.Id"
                                           class="action-btn action-edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@lesson.Id"
                                           class="action-btn action-delete">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                Showing @Model.Count() lesson(s)
            </div>
        }

    </div>

</div>