@model SchoolManagementSystem.Web.ViewModels.Admin.LessonFormViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>

<div class="lesson-form-grid">

    <div class="form-card">

        <div class="form-card-header">

            <h5>@Localizer["Lesson Information"]</h5>

            <p>
                @Localizer["Set lesson date, time and topic"]
            </p>

        </div>

        <div class="form-card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="StartTime"
                           class="form-label">
                        @Localizer["Start Time"]
                    </label>

                    <input asp-for="StartTime"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           type="datetime-local"
                           step="60"
                           class="form-control" />

                    <span asp-validation-for="StartTime"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="EndTime"
                           class="form-label">
                        @Localizer["End Time"]
                    </label>

                    <input asp-for="EndTime"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           type="datetime-local"
                           step="60"
                           class="form-control" />

                    <span asp-validation-for="EndTime"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="Topic"
                           class="form-label">
                        @Localizer["Topic"]
                    </label>

                    <input asp-for="Topic"
                           class="form-control"
                           placeholder="@Localizer["Example: Linear equations"]" />

                    <span asp-validation-for="Topic"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div class="form-card">

        <div class="form-card-header">

            <h5>@Localizer["Assignment"]</h5>

            <p>
                @Localizer["Select group, teacher and subject"]
            </p>

        </div>

        <div class="form-card-body">

            <div class="mb-4">

                <label asp-for="GroupId"
                       class="form-label">
                    @Localizer["Group"]
                </label>

                <select asp-for="GroupId"
                        class="form-select">

                    <option value="">
                        @Localizer["Select group"]
                    </option>

                    @foreach (var group in ViewBag.Groups)
                    {
                        <option value="@group.Id">
                            @group.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="GroupId"
                      class="text-danger small">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="TeacherId"
                       class="form-label">
                    @Localizer["Teacher"]
                </label>

                <select asp-for="TeacherId"
                        class="form-select">

                    <option value="">
                        @Localizer["Select teacher"]
                    </option>

                    @foreach (var teacher in ViewBag.Teachers)
                    {
                        <option value="@teacher.Id">
                            @teacher.ApplicationUser.FullName
                        </option>
                    }

                </select>

                <span asp-validation-for="TeacherId"
                      class="text-danger small">
                </span>

            </div>

            <div>

                <label asp-for="SubjectId"
                       class="form-label">
                    @Localizer["Subject"]
                </label>

                <select asp-for="SubjectId"
                        class="form-select">

                    <option value="">
                        @Localizer["Select subject"]
                    </option>

                    @foreach (var subject in ViewBag.Subjects)
                    {
                        <option value="@subject.Id">
                            @subject.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="SubjectId"
                      class="text-danger small">
                </span>

            </div>

        </div>

    </div>

</div>
