@using SchoolManagementSystem.Web.Models.Enums
@model SchoolManagementSystem.Web.ViewModels.Shared.AttendanceJournalViewModel

@{
    ViewData["Title"] = Localizer["Attendance Journal"];

    string StatusAbbr(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "P",
        AttendanceStatus.Absent => "A",
        AttendanceStatus.Late => "L",
        AttendanceStatus.Excused => "E",
        _ => "—"
    };

    string StatusClass(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "status-present",
        AttendanceStatus.Absent => "status-absent",
        AttendanceStatus.Late => "status-late",
        AttendanceStatus.Excused => "status-excused",
        _ => "journal-cell-empty"
    };
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Attendance Journal"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Students × lesson dates, at a glance"]
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-light">
        ← @Localizer["Flat list"]
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Journal"
              class="journal-filters">

            <div>
                <label class="form-label">@Localizer["Group"]</label>

                <select name="groupId"
                        class="form-select"
                        required>

                    <option value="">@Localizer["Select group"]</option>

                    @foreach (var group in ViewBag.Groups)
                    {
                        if (ViewBag.GroupId != null &&
                            (int)ViewBag.GroupId == group.Id)
                        {
                            <option value="@group.Id" selected>
                                @group.Name
                            </option>
                        }
                        else
                        {
                            <option value="@group.Id">
                                @group.Name
                            </option>
                        }
                    }

                </select>
            </div>

            <div>
                <label class="form-label">@Localizer["Subject"]</label>

                <select name="subjectId"
                        class="form-select">

                    <option value="">@Localizer["All subjects"]</option>

                    @foreach (var subject in ViewBag.Subjects)
                    {
                        if (ViewBag.SubjectId != null &&
                            (int)ViewBag.SubjectId == subject.Id)
                        {
                            <option value="@subject.Id" selected>
                                @subject.Name
                            </option>
                        }
                        else
                        {
                            <option value="@subject.Id">
                                @subject.Name
                            </option>
                        }
                    }

                </select>
            </div>

            <div>
                <label class="form-label">@Localizer["From"]</label>

                <input type="date"
                       name="from"
                       value="@(Model?.From.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div>
                <label class="form-label">@Localizer["To"]</label>

                <input type="date"
                       name="to"
                       value="@(Model?.To.AddDays(-1).ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Show"]
            </button>

        </form>

        @if (Model == null)
        {
            <div class="management-empty">

                <div class="management-empty-icon"><i class="bi bi-clipboard2-check-fill"></i></div>

                <h5>
                    @Localizer["Select a group"]
                </h5>

                <p>
                    @Localizer["Choose a group above to view its attendance journal."]
                </p>

            </div>
        }
        else if (!Model.Columns.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon"><i class="bi bi-clipboard2-check-fill"></i></div>

                <h5>
                    @Localizer["No lessons in this range"]
                </h5>

                <p>
                    @Localizer["There are no lessons for {0} in the selected date range.", Model.GroupName]
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive journal-table-wrap">

                <table class="table table-hover management-table journal-table">

                    <thead>
                        <tr>
                            <th class="journal-sticky-col">@Localizer["Student"]</th>

                            @foreach (var col in Model.Columns)
                            {
                                <th class="journal-date-col"
                                    title="@col.SubjectName@(col.Topic != null ? " — " + col.Topic : "")">
                                    @col.Date.ToString("dd MMM")
                                </th>
                            }

                            <th>@Localizer["Rate"]</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var row in Model.Rows)
                        {
                            <tr>

                                <td class="journal-sticky-col">
                                    @row.StudentName
                                </td>

                                @foreach (var cell in row.Cells)
                                {
                                    <td class="journal-cell">

                                        @if (cell.AttendanceId.HasValue && User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@cell.AttendanceId"
                                               class="status-badge journal-status-badge @StatusClass(cell.Status)"
                                               title="@Localizer["Edit"]">
                                                @StatusAbbr(cell.Status)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="status-badge journal-status-badge @(cell.AttendanceId.HasValue ? StatusClass(cell.Status) : "journal-cell-empty")">
                                                @StatusAbbr(cell.Status)
                                            </span>
                                        }

                                    </td>
                                }

                                <td>
                                    @row.AttendanceRate.ToString(
                                        "0.#",
                                        System.Globalization.CultureInfo.InvariantCulture)%
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
