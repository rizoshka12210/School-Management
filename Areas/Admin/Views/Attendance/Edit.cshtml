@model SchoolManagementSystem.Web.ViewModels.Admin.AttendanceFormViewModel
@using SchoolManagementSystem.Web.Models.Enums

@{
    ViewData["Title"] = Localizer["Edit Attendance"];
}

<div class="form-page-header">

    <a asp-action="Index"
       class="back-link">
        ← @Localizer["Attendance"]
    </a>

    <h1 class="page-title mt-2">
        @Localizer["Edit Attendance"]
    </h1>

    <p class="page-subtitle">
        @Localizer["Correct the attendance record for {0}", Model.StudentName]
    </p>

</div>

<form asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="form-card">

        <div class="form-card-header">

            <h5>@Localizer["Lesson"]</h5>

            <p>
                @Model.SubjectName • @Model.GroupName •
                @Model.LessonDate.ToString("dd MMM yyyy HH:mm")
            </p>

        </div>

        <div class="form-card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="Status"
                           class="form-label">
                        @Localizer["Status"]
                    </label>

                    <select asp-for="Status"
                            class="form-select">
                        @foreach (var status in Enum.GetValues<AttendanceStatus>())
                        {
                            <option value="@status" selected="@(Model.Status == status)">
                                @Localizer[status.ToString()]
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger small">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="Note"
                           class="form-label">
                        @Localizer["Note"]
                    </label>

                    <input asp-for="Note"
                           class="form-control"
                           placeholder="@Localizer["Optional note"]" />

                    <span asp-validation-for="Note"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            @Localizer["Cancel"]
        </a>

        <button type="submit"
                class="btn btn-primary">
            @Localizer["Save Changes"]
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
