@using SchoolManagementSystem.Web.Models.Enums
@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Attendance>

@{
    ViewData["Title"] = Localizer["Attendance"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Attendance"]
        </h1>

        <p class="page-subtitle">
            @Localizer["View and correct student attendance records across the school"]
        </p>
    </div>

    <a asp-action="Journal"
       class="btn btn-light">
        @Localizer["Journal View"]
    </a>

</div>

<div class="attendance-stats">

    <div class="attendance-stat">

        <div class="attendance-stat-value">
            @Model.Count()
        </div>

        <div class="attendance-stat-label">
            @Localizer["Total Records"]
        </div>

    </div>

    <div class="attendance-stat attendance-present">

        <div class="attendance-stat-value">
            @Model.Count(a => a.Status == AttendanceStatus.Present)
        </div>

        <div class="attendance-stat-label">
            @Localizer["Present"]
        </div>

    </div>

    <div class="attendance-stat attendance-late">

        <div class="attendance-stat-value">
            @Model.Count(a => a.Status == AttendanceStatus.Late)
        </div>

        <div class="attendance-stat-label">
            @Localizer["Late"]
        </div>

    </div>

    <div class="attendance-stat attendance-absent">

        <div class="attendance-stat-value">
            @Model.Count(a => a.Status == AttendanceStatus.Absent)
        </div>

        <div class="attendance-stat-label">
            @Localizer["Absent"]
        </div>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="record-filters">

            <div class="record-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search student, group, subject or teacher..."]" />

            </div>

            <div>

                <select name="status"
                        class="form-select">

                    <option value="">
                        @Localizer["All statuses"]
                    </option>

                    @foreach (var item in Enum.GetValues<AttendanceStatus>())
                    {
                        if ((ViewBag.Status as string) == item.ToString())
                        {
                            <option value="@item" selected>
                                @Localizer[item.ToString()]
                            </option>
                        }
                        else
                        {
                            <option value="@item">
                                @Localizer[item.ToString()]
                            </option>
                        }
                    }

                </select>

            </div>

            <div>

                <input type="date"
                       name="date"
                       value="@ViewBag.Date"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Filter"]
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                @Localizer["Clear"]
            </a>

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    AT
                </div>

                <h5>
                    @Localizer["No attendance records"]
                </h5>

                <p>
                    @Localizer["There are no attendance records matching the selected filters."]
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Group"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Teacher"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Note"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var attendance in Model)
                        {
                            <tr>

                                <td>

                                    <div class="record-date">
                                        @attendance.Lesson.StartTime.ToString("dd MMM yyyy")
                                    </div>

                                    <div class="record-time">
                                        @attendance.Lesson.StartTime.ToString("HH:mm")
                                    </div>

                                </td>

                                <td>

                                    <div class="person-cell">

                                        <div class="mini-avatar">
                                            @attendance.Student.FirstName.Substring(0, 1).ToUpper()
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @attendance.Student.FirstName
                                                @attendance.Student.LastName
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Student #{0}", attendance.Student.Id]
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="group-badge">
                                        @attendance.Lesson.Group.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="subject-badge">
                                        @attendance.Lesson.Subject.Name
                                    </span>
                                </td>

                                <td>
                                    @attendance.Lesson.Teacher.ApplicationUser.FullName
                                </td>

                                <td>

                                    @switch (attendance.Status)
                                    {
                                        case AttendanceStatus.Present:
                                            <span class="status-badge status-present">
                                                @Localizer["Present"]
                                            </span>
                                            break;

                                        case AttendanceStatus.Absent:
                                            <span class="status-badge status-absent">
                                                @Localizer["Absent"]
                                            </span>
                                            break;

                                        case AttendanceStatus.Late:
                                            <span class="status-badge status-late">
                                                @Localizer["Late"]
                                            </span>
                                            break;

                                        case AttendanceStatus.Excused:
                                            <span class="status-badge status-excused">
                                                @Localizer["Excused"]
                                            </span>
                                            break;
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(attendance.Note))
                                    {
                                        <span>
                                            @attendance.Note
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Edit"
                                           asp-route-id="@attendance.Id"
                                           class="action-btn action-edit"
                                           title="@Localizer["Edit"]">
                                            @Localizer["Edit"]
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@attendance.Id"
                                           class="action-btn action-delete"
                                           title="@Localizer["Delete"]">
                                            @Localizer["Delete"]
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                @Localizer["Showing {0} attendance record(s)", Model.Count()]
            </div>
        }

    </div>

</div>