@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">
            Attendance
        </h1>

        <p class="text-muted mb-0">
            Read-only attendance records
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No attendance records</h5>

                    <p class="text-muted">
                        Attendance recorded by teachers will appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Student</th>
                                <th>Group</th>
                                <th>Subject</th>
                                <th>Teacher</th>
                                <th>Status</th>
                                <th>Note</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var attendance in Model)
                            {
                                <tr>

                                    <td>
                                        @(attendance.Lesson.StartTime.ToString("dd.MM.yyyy"))
                                    </td>

                                    <td class="fw-semibold">
                                        @attendance.Student.FirstName
                                        @attendance.Student.LastName
                                    </td>

                                    <td>
                                        @attendance.Lesson.Group.Name
                                    </td>

                                    <td>
                                        @attendance.Lesson.Subject.Name
                                    </td>

                                    <td>
                                        @attendance.Lesson.Teacher.ApplicationUser.FullName
                                    </td>

                                    <td>
                                        @switch (attendance.Status)
                                        {
                                            case SchoolManagementSystem.Web.Models.Enums.AttendanceStatus.Present:
                                                <span class="badge bg-success">
                                                    Present
                                                </span>
                                                break;

                                            case SchoolManagementSystem.Web.Models.Enums.AttendanceStatus.Absent:
                                                <span class="badge bg-danger">
                                                    Absent
                                                </span>
                                                break;

                                            case SchoolManagementSystem.Web.Models.Enums.AttendanceStatus.Late:
                                                <span class="badge bg-warning text-dark">
                                                    Late
                                                </span>
                                                break;

                                            case SchoolManagementSystem.Web.Models.Enums.AttendanceStatus.Excused:
                                                <span class="badge bg-info text-dark">
                                                    Excused
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(attendance.Note))
                                        {
                                            @attendance.Note
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>