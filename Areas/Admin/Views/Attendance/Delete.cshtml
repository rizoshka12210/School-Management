@model SchoolManagementSystem.Web.Models.Entities.Attendance

@{
    ViewData["Title"] = "Delete Attendance";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        Delete Attendance Record
                    </h2>

                    <p class="mt-3">
                        Are you sure you want to delete this attendance record?
                    </p>

                    <hr />

                    <p>
                        <strong>Student:</strong>
                        @Model.Student.FirstName @Model.Student.LastName
                    </p>

                    <p>
                        <strong>Subject:</strong>
                        @Model.Lesson.Subject.Name
                    </p>

                    <p>
                        <strong>Group:</strong>
                        @Model.Lesson.Group.Name
                    </p>

                    <p>
                        <strong>Date:</strong>
                        @Model.Lesson.StartTime.ToString("dd.MM.yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Status:</strong>
                        @Model.Status
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
