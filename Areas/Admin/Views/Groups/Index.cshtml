@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Group>

@{
    ViewData["Title"] = Localizer["Groups"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Groups"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage school groups, students and teachers"]
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + @Localizer["Add Group"]
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="@Localizer["Search group..."]" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Search"]
            </button>

            @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    @Localizer["Clear"]
                </a>
            }

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    GR
                </div>

                <h5>
                    @Localizer["No groups found"]
                </h5>

                <p>
                    @Localizer["Create a group to organize students and teachers."]
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + @Localizer["Add Group"]
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>@Localizer["Group"]</th>
                            <th>@Localizer["Students"]</th>
                            <th>@Localizer["Teachers"]</th>
                            <th class="text-end">
                                @Localizer["Actions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var group in Model)
                        {
                            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = group.Id })">

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar group-avatar">
                                            GR
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @group.Name
                                            </div>

                                            <div class="person-id">
                                                @Localizer["Group #{0}", group.Id]
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="count-badge">
                                        @group.Students.Count
                                    </span>

                                    <span class="text-muted small">
                                        @Localizer["Students"]
                                    </span>

                                </td>

                                <td>

                                    @if (group.Teachers.Any())
                                    {
                                        @foreach (var teacher in
                                            group.Teachers.Take(2))
                                        {
                                            <div class="small fw-semibold mb-1">
                                                @teacher.ApplicationUser.FullName
                                            </div>
                                        }

                                        @if (group.Teachers.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                @Localizer["+{0} more", group.Teachers.Count - 2]
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @Localizer["No teachers"]
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Edit"
                                           asp-route-id="@group.Id"
                                           class="action-btn action-edit">
                                            @Localizer["Edit"]
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@group.Id"
                                           class="action-btn action-delete">
                                            @Localizer["Delete"]
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                @Localizer["Showing {0} group(s)", Model.Count()]
            </div>
        }

    </div>

</div>
