@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Group>

@{
    ViewData["Title"] = "Groups";
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            Groups
        </h1>

        <p class="page-subtitle">
            Manage school groups, students and teachers
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Group
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="management-toolbar">

            <div class="management-search">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search group..." />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Search as string))
            {
                <a asp-action="Index"
                   class="btn btn-light">
                    Clear
                </a>
            }

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    GR
                </div>

                <h5>
                    No groups found
                </h5>

                <p>
                    Create a group to organize students and teachers.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add Group
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover management-table">

                    <thead>
                        <tr>
                            <th>Group</th>
                            <th>Students</th>
                            <th>Teachers</th>
                            <th class="text-end">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var group in Model)
                        {
                            <tr>

                                <td>

                                    <div class="person-cell">

                                        <div class="person-avatar group-avatar">
                                            GR
                                        </div>

                                        <div>

                                            <div class="person-name">
                                                @group.Name
                                            </div>

                                            <div class="person-id">
                                                Group #@group.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="count-badge">
                                        @group.Students.Count
                                    </span>

                                    <span class="text-muted small">
                                        students
                                    </span>

                                </td>

                                <td>

                                    @if (group.Teachers.Any())
                                    {
                                        @foreach (var teacher in
                                            group.Teachers.Take(2))
                                        {
                                            <div class="small fw-semibold mb-1">
                                                @teacher.ApplicationUser.FullName
                                            </div>
                                        }

                                        @if (group.Teachers.Count > 2)
                                        {
                                            <span class="text-muted small">
                                                +@(group.Teachers.Count - 2) more
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No teachers
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@group.Id"
                                           class="action-btn action-details">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@group.Id"
                                           class="action-btn action-edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@group.Id"
                                           class="action-btn action-delete">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">
                Showing @Model.Count() group(s)
            </div>
        }

    </div>

</div>