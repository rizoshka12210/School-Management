@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Group>

@{
    ViewData["Title"] = "Groups";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Groups</h1>
            <p class="text-muted mb-0">
                Manage school groups
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Group
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>No groups yet</h5>

                    <p class="text-muted">
                        Create your first group.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Group
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Students</th>
                                <th>Teachers</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var group in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @group.Name
                                </td>

                                <td>
                                    @group.Students.Count
                                </td>

                                <td>
                                    @if (group.Teachers.Any())
                                    {
                                        @string.Join(
                                            ", ",
                                            group.Teachers.Select(
                                                t => t.ApplicationUser.FullName))
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No teachers
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@group.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@group.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@group.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>