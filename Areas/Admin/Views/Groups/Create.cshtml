@model SchoolManagementSystem.Web.ViewModels.Admin.GroupFormViewModel

@{
    ViewData["Title"] = "Add Group";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">
                        Add Group
                    </h2>

                    <form asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Group Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Example: Group A" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="TeacherIds"
                                   class="form-label">
                                Teachers
                            </label>

                            <select asp-for="TeacherIds"
                                    asp-items="ViewBag.Teachers"
                                    class="form-select"
                                    multiple
                                    size="5">
                            </select>

                            <small class="text-muted">
                                Hold Command on Mac to select multiple teachers.
                            </small>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Create
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}