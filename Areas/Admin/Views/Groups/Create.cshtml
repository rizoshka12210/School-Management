@model SchoolManagementSystem.Web.ViewModels.Admin.GroupFormViewModel

@{
    ViewData["Title"] = "Add Group";
}

<div class="form-page-header">

    <a asp-action="Index"
       class="back-link">
        ← Groups
    </a>

    <h1 class="page-title mt-2">
        Add Group
    </h1>

    <p class="page-subtitle">
        Create a new school group and assign teachers
    </p>

</div>

<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <partial name="_Form"
             model="Model" />

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-primary">
            Create Group
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}