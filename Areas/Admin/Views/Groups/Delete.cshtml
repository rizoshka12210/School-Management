@model SchoolManagementSystem.Web.Models.Entities.Group

@{
    ViewData["Title"] = Localizer["Delete Group"];
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold text-danger">
                        @Localizer["Delete Group"]
                    </h2>

                    <p class="mt-3">
                        @Localizer["Are you sure you want to delete"]
                        <strong>@Model.Name</strong>?
                    </p>

                    <p>
                        @Localizer["Students"]:
                        <strong>@Model.Students.Count</strong>
                    </p>

                    <p>
                        @Localizer["Teachers"]:
                        <strong>@Model.Teachers.Count</strong>
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Yes, Delete"]
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
