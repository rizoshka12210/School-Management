@model SchoolManagementSystem.Web.ViewModels.Admin.ScheduleFormViewModel

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>

<div class="mb-3">

    <label asp-for="DayOfWeek"
           class="form-label">
        Day
    </label>

    <select asp-for="DayOfWeek"
            class="form-select">

        @foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>())
        {
            <option value="@day">
                @day
            </option>
        }

    </select>

</div>

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="StartTime"
               class="form-label">
            Start Time
        </label>

        <input asp-for="StartTime"
               type="time"
               class="form-control" />

        <span asp-validation-for="StartTime"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="EndTime"
               class="form-label">
            End Time
        </label>

        <input asp-for="EndTime"
               type="time"
               class="form-control" />

        <span asp-validation-for="EndTime"
              class="text-danger">
        </span>

    </div>

</div>

<div class="mb-3">

    <label asp-for="GroupId"
           class="form-label">
        Group
    </label>

    <select asp-for="GroupId"
            asp-items="ViewBag.Groups"
            class="form-select">

        <option value="0">
            -- Select Group --
        </option>

    </select>

    <span asp-validation-for="GroupId"
          class="text-danger">
    </span>

</div>

<div class="mb-3">

    <label asp-for="TeacherId"
           class="form-label">
        Teacher
    </label>

    <select asp-for="TeacherId"
            asp-items="ViewBag.Teachers"
            class="form-select">

        <option value="0">
            -- Select Teacher --
        </option>

    </select>

    <span asp-validation-for="TeacherId"
          class="text-danger">
    </span>

</div>

<div class="mb-4">

    <label asp-for="SubjectId"
           class="form-label">
        Subject
    </label>

    <select asp-for="SubjectId"
            asp-items="ViewBag.Subjects"
            class="form-select">

        <option value="0">
            -- Select Subject --
        </option>

    </select>

    <span asp-validation-for="SubjectId"
          class="text-danger">
    </span>

</div>