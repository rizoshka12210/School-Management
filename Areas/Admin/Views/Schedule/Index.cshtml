@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Schedule>

@{
    ViewData["Title"] = Localizer["Schedule"];
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            @Localizer["Schedule"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Manage the weekly school timetable"]
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + @Localizer["Add Schedule"]
    </a>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="schedule-filters">

            <div>

                <select name="day"
                        class="form-select">

                    <option value="">
                        @Localizer["All days"]
                    </option>

                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                    {
                        if ((ViewBag.Day as string) == day.ToString())
                        {
                            <option value="@day" selected>
                                @Localizer[day.ToString()]
                            </option>
                        }
                        else
                        {
                            <option value="@day">
                                @Localizer[day.ToString()]
                            </option>
                        }
                    }

                </select>

            </div>

            <div>

                <select name="groupId"
                        class="form-select">

                    <option value="">
                        @Localizer["All groups"]
                    </option>

                    @foreach (var group in ViewBag.Groups)
                    {
                        if (ViewBag.GroupId != null &&
                            (int)ViewBag.GroupId == group.Id)
                        {
                            <option value="@group.Id" selected>
                                @group.Name
                            </option>
                        }
                        else
                        {
                            <option value="@group.Id">
                                @group.Name
                            </option>
                        }
                    }

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["Filter"]
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                @Localizer["Clear"]
            </a>

        </form>

        @if (!Model.Any())
        {
            <div class="management-empty">

                <div class="management-empty-icon">
                    SC
                </div>

                <h5>
                    @Localizer["No schedule entries found"]
                </h5>

                <p>
                    @Localizer["Create a schedule entry or change the filters."]
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    + @Localizer["Add Schedule"]
                </a>

            </div>
        }
        else
        {
            <div class="schedule-list">

                @foreach (var dayGroup in
                    Model.GroupBy(s => s.DayOfWeek))
                {
                    <div class="schedule-day">

                        <div class="schedule-day-header">

                            <div>
                                <span class="schedule-day-name">
                                    @Localizer[dayGroup.Key.ToString()]
                                </span>

                                <span class="schedule-day-count">
                                    @Localizer["{0} lesson(s)", dayGroup.Count()]
                                </span>
                            </div>

                        </div>

                        @foreach (var item in
                            dayGroup.OrderBy(s => s.StartTime))
                        {
                            <div class="schedule-row">

                                <div class="schedule-time">

                                    <strong>
                                        @item.StartTime.ToString("HH:mm")
                                    </strong>

                                    <span>
                                        @item.EndTime.ToString("HH:mm")
                                    </span>

                                </div>

                                <div class="schedule-subject">

                                    <strong>
                                        @item.Subject.Name
                                    </strong>

                                    <span>
                                        @item.Group.Name
                                    </span>

                                </div>

                                <div class="schedule-teacher">

                                    <div class="mini-avatar">

                                        @(string.IsNullOrWhiteSpace(
                                            item.Teacher.ApplicationUser.FullName)
                                            ? "T"
                                            : item.Teacher.ApplicationUser.FullName
                                                .Substring(0, 1)
                                                .ToUpper())

                                    </div>

                                    <span>
                                        @item.Teacher.ApplicationUser.FullName
                                    </span>

                                </div>

                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn action-details">
                                        @Localizer["View"]
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-btn action-edit">
                                        @Localizer["Edit"]
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn action-delete">
                                        @Localizer["Delete"]
                                    </a>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        }

    </div>

</div>
