@model SchoolManagementSystem.Web.Models.Entities.Schedule

@{
    ViewData["Title"] = Localizer["Delete Schedule"];
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        @Localizer["Delete Schedule"]
                    </h2>

                    <p class="mt-3">
                        @Localizer["Are you sure you want to delete this schedule entry?"]
                    </p>

                    <hr />

                    <p>
                        <strong>@Localizer["Day"]:</strong>
                        @Model.DayOfWeek
                    </p>

                    <p>
                        <strong>@Localizer["Time"]:</strong>
                        @Model.StartTime.ToString("HH:mm")
                        -
                        @Model.EndTime.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>@Localizer["Group"]:</strong>
                        @Model.Group.Name
                    </p>

                    <p>
                        <strong>@Localizer["Subject"]:</strong>
                        @Model.Subject.Name
                    </p>

                    <p>
                        <strong>@Localizer["Teacher"]:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Yes, Delete"]
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
