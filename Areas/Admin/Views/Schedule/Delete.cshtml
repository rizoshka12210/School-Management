@model SchoolManagementSystem.Web.Models.Entities.Schedule

@{
    ViewData["Title"] = "Delete Schedule";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-danger shadow-sm">

                <div class="card-body p-4">

                    <h2 class="text-danger fw-bold">
                        Delete Schedule
                    </h2>

                    <p class="mt-3">
                        Are you sure you want to delete this schedule entry?
                    </p>

                    <hr />

                    <p>
                        <strong>Day:</strong>
                        @Model.DayOfWeek
                    </p>

                    <p>
                        <strong>Time:</strong>
                        @Model.StartTime.ToString("HH:mm")
                        -
                        @Model.EndTime.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>Group:</strong>
                        @Model.Group.Name
                    </p>

                    <p>
                        <strong>Subject:</strong>
                        @Model.Subject.Name
                    </p>

                    <p>
                        <strong>Teacher:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>