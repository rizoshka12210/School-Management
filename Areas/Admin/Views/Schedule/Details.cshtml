@model SchoolManagementSystem.Web.Models.Entities.Schedule

@{
    ViewData["Title"] = "Schedule Details";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        Schedule Details
                    </h2>

                    <hr />

                    <p>
                        <strong>Day:</strong>
                        @Model.DayOfWeek
                    </p>

                    <p>
                        <strong>Time:</strong>

                        @Model.StartTime.ToString("HH:mm")
                        -
                        @Model.EndTime.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>Group:</strong>
                        @Model.Group.Name
                    </p>

                    <p>
                        <strong>Subject:</strong>
                        @Model.Subject.Name
                    </p>

                    <p>
                        <strong>Teacher:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Edit
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>