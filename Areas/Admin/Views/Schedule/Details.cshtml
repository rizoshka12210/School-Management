@model SchoolManagementSystem.Web.Models.Entities.Schedule

@{
    ViewData["Title"] = Localizer["Schedule Details"];
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold">
                        @Localizer["Schedule Details"]
                    </h2>

                    <hr />

                    <p>
                        <strong>@Localizer["Day"]:</strong>
                        @Localizer[Model.DayOfWeek.ToString()]
                    </p>

                    <p>
                        <strong>@Localizer["Time"]:</strong>

                        @Model.StartTime.ToString("HH:mm")
                        -
                        @Model.EndTime.ToString("HH:mm")
                    </p>

                    <p>
                        <strong>@Localizer["Group"]:</strong>
                        @Model.Group.Name
                    </p>

                    <p>
                        <strong>@Localizer["Subject"]:</strong>
                        @Model.Subject.Name
                    </p>

                    <p>
                        <strong>@Localizer["Teacher"]:</strong>
                        @Model.Teacher.ApplicationUser.FullName
                    </p>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        @Localizer["Edit"]
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        @Localizer["Back"]
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
