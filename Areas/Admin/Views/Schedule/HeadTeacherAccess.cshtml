@model List<SchoolManagementSystem.Web.Models.Entities.Subject>
@using SchoolManagementSystem.Web.Models.Entities

@{
    ViewData["Title"] = Localizer["Head Teacher Access"];
    var teachers = ViewBag.Teachers as List<Teacher> ?? new List<Teacher>();
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link">← @Localizer["Schedule"]</a>
        <h1 class="page-title mt-2">@Localizer["Head Teacher Access"]</h1>
        <p class="page-subtitle">@Localizer["Only Admin and each subject's designated teacher can create, edit or delete that subject's schedule entries"]</p>
    </div>
</div>

<form asp-action="HeadTeacherAccess" method="post">
    @Html.AntiForgeryToken()

    <div class="form-card">
        <div class="form-card-header">
            <h5>@Localizer["Head Teacher per Subject"]</h5>
            <p>@Localizer["Choose at most one teacher per subject. Selecting a different teacher revokes access from the previous one."]</p>
        </div>

        <div class="form-card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Designated Head Teacher"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model)
                        {
                            <tr>
                                <td><strong>@subject.Name</strong></td>
                                <td>
                                    <select name="assignments[@subject.Id]" class="form-select">
                                        <option value="">@Localizer["None"]</option>
                                        @foreach (var teacher in teachers)
                                        {
                                            var selected = subject.HeadTeacherId == teacher.Id;
                                            <option value="@teacher.Id" selected="@selected">@teacher.ApplicationUser.FullName</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light">@Localizer["Cancel"]</a>
        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
    </div>
</form>
