@model SchoolManagementSystem.Web.ViewModels.Admin.ScheduleFormViewModel

@{
    ViewData["Title"] = "Add Schedule";
}

<div class="form-page-header">

    <a asp-action="Index"
       class="back-link">
        ← Schedule
    </a>

    <h1 class="page-title mt-2">
        Add Schedule
    </h1>

    <p class="page-subtitle">
        Add a lesson to the weekly timetable
    </p>

</div>

<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <partial name="_Form"
             model="Model" />

    <div class="form-actions">

        <a asp-action="Index"
           class="btn btn-light">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-primary">
            Create Schedule
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}