@model List<SchoolManagementSystem.Web.Models.Entities.ActivityLogEntry>

@{
    ViewData["Title"] = Localizer["Activity Log"];
}

<div class="page-header">
    <div>
        <h1 class="page-title">📋 @Localizer["Activity Log"]</h1>
        <p class="page-subtitle">@Localizer["Most recent 100 actions across the school"]</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="dashboard-empty"><p>@Localizer["No activity recorded yet."]</p></div>
        }
        else
        {
            <div class="activity-log-list">
                @foreach (var entry in Model)
                {
                    <div class="activity-log-row">
                        <span class="activity-log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                        <span class="activity-log-date">@entry.Timestamp.ToLocalTime().ToString("dd MMM")</span>
                        <span class="activity-log-message">@entry.Message</span>
                    </div>
                }
            </div>
        }
    </div>
</div>
