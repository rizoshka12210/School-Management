@model SchoolManagementSystem.Web.Services.TeacherSalarySummary

@{
    ViewData["Title"] = "My Salary";

    string[] monthNames =
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">My Salary</h1>
        <p class="text-muted mb-0">Calculated from lessons you conducted</p>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label class="form-label">Month</label>
            <select name="month" class="form-select">
                @for (var i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == Model.Month)">@monthNames[i - 1]</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label">Year</label>
            <select name="year" class="form-select">
                @for (var y = DateTime.UtcNow.Year - 1; y <= DateTime.UtcNow.Year + 1; y++)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">View</button>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">@monthNames[Model.Month - 1] @Model.Year</h5>

            <div class="row g-4">
                <div class="col-md-3">
                    <h6 class="text-muted">Lessons</h6>
                    <h3 class="fw-bold">@Model.LessonsCount</h3>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Worked Hours</h6>
                    <h3 class="fw-bold">@Model.WorkedHours.ToString("N1")</h3>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Hourly Rate</h6>
                    <h3 class="fw-bold">@Model.HourlyRate.ToString("N0")</h3>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Total Salary</h6>
                    <h3 class="fw-bold text-success">@Model.TotalSalary.ToString("N0")</h3>
                </div>
            </div>

            <p class="text-muted small mt-3 mb-0">
                @Model.WorkedHours.ToString("N1") &times; @Model.HourlyRate.ToString("N0") = @Model.TotalSalary.ToString("N0")
            </p>

        </div>
    </div>

</div>
