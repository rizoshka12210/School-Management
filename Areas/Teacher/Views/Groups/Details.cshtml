@model SchoolManagementSystem.Web.Models.Entities.Group

@{
    ViewData["Title"] = Model.Name;

    var subjects = ViewBag.Subjects as List<string> ?? new List<string>();
}

<div class="teacher-details-header">
    <div>
        <a asp-action="Index" class="back-link">← @Localizer["My Groups"]</a>

        <div class="d-flex align-items-center gap-3 mt-3">
            <div class="teacher-big-group-icon">GR</div>
            <div>
                <h1 class="page-title mb-1">@Model.Name</h1>
                <p class="page-subtitle">@Localizer["Group overview and students"]</p>
            </div>
        </div>
    </div>
</div>

<div class="teacher-group-stats">
    <div class="teacher-info-stat">
        <div class="teacher-info-stat-icon">ST</div>
        <div><span>@Localizer["Students"]</span><strong>@Model.Students.Count</strong></div>
    </div>

    <div class="teacher-info-stat">
        <div class="teacher-info-stat-icon subject-color">SB</div>
        <div><span>@Localizer["Subjects"]</span><strong>@subjects.Count</strong></div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Subjects"]</h5>
                <p class="section-subtitle">@Localizer["Subjects scheduled for this group"]</p>
            </div>
        </div>

        @if (!subjects.Any())
        {
            <div class="teacher-simple-empty">@Localizer["No subjects scheduled yet."]</div>
        }
        else
        {
            <div class="teacher-subject-list">
                @foreach (var subject in subjects)
                {
                    <div class="teacher-subject-chip">
                        <div class="teacher-subject-chip-icon">SB</div>
                        <span>@subject</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Students"]</h5>
                <p class="section-subtitle">@Localizer["Students enrolled in {0}", Model.Name]</p>
            </div>
        </div>

        @if (!Model.Students.Any())
        {
            <div class="teacher-empty">
                <div class="teacher-empty-icon">ST</div>
                <h5>@Localizer["No students"]</h5>
                <p>@Localizer["There are no students in this group yet."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Date of Birth"]</th>
                            <th class="text-end">@Localizer["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students.OrderBy(s => s.FirstName).ThenBy(s => s.LastName))
                        {
                            <tr>
                                <td>
                                    <div class="person-cell">
                                        <div class="person-avatar">
                                            @(string.IsNullOrWhiteSpace(student.FirstName)
                                                ? "S"
                                                : student.FirstName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="person-name">@student.FirstName @student.LastName</div>
                                            <div class="person-id">@Localizer["Student #{0}", student.Id]</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@student.DateOfBirth.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-area="Teacher"
                                       asp-controller="Students"
                                       asp-action="Details"
                                       asp-route-id="@student.Id"
                                       class="action-btn action-details">
                                        @Localizer["View"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>