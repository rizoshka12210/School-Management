@model SchoolManagementSystem.Web.Models.Entities.Group

@{
    ViewData["Title"] = $"Group - {Model.Name}";
    var subjects = ViewBag.Subjects as List<string> ?? new List<string>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">Group overview</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Groups</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Students</h6>
                    <h3 class="fw-bold">@Model.Students.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Subjects</h6>
                    @if (!subjects.Any())
                    {
                        <span class="text-muted">No subjects scheduled yet</span>
                    }
                    else
                    {
                        foreach (var subject in subjects)
                        {
                            <span class="badge bg-primary-subtle text-primary-emphasis me-1">@subject</span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">Students</h5>

            @if (!Model.Students.Any())
            {
                <p class="text-muted mb-0">No students in this group yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Full name</th>
                                <th>Date of birth</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students.OrderBy(s => s.FirstName).ThenBy(s => s.LastName))
                            {
                                <tr>
                                    <td>@student.FirstName @student.LastName</td>
                                    <td>@student.DateOfBirth.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <a asp-area="Teacher" asp-controller="Students" asp-action="Details"
                                           asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
