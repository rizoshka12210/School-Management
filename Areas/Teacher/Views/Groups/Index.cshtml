@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Group>

@{
    ViewData["Title"] = Localizer["My Groups"];
}

<div class="page-header">
    <div>
        <h1 class="page-title">@Localizer["My Groups"]</h1>
        <p class="page-subtitle">@Localizer["Groups assigned to you"]</p>
    </div>

    <div class="teacher-count-label">@Localizer["{0} group(s)", Model.Count()]</div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="teacher-empty">
            <div class="teacher-empty-icon"><i class="bi bi-collection-fill"></i></div>
            <h5>@Localizer["No groups assigned"]</h5>
            <p>@Localizer["Your assigned groups will appear here."]</p>
        </div>
    </div>
}
else
{
    <div class="teacher-groups-grid">
        @foreach (var group in Model)
        {
            <a asp-action="Details" asp-route-id="@group.Id" class="teacher-group-card">
                <div class="teacher-group-top">
                    <div class="teacher-group-icon"><i class="bi bi-collection-fill"></i></div>
                    <div class="teacher-group-arrow">→</div>
                </div>

                <div class="teacher-group-name">@group.Name</div>
                <div class="teacher-group-subtitle">@Localizer["Group"]</div>

                <div class="teacher-group-bottom">
                    <div>
                        <strong>@group.Students.Count</strong>
                        <span>@Localizer["Students"]</span>
                    </div>
                    <span class="teacher-open-label">@Localizer["Open group"]</span>
                </div>
            </a>
        }
    </div>
}