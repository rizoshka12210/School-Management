@model SchoolManagementSystem.Web.Models.Entities.Student
@using SchoolManagementSystem.Web.Models.Entities
@using SchoolManagementSystem.Web.Models.Enums

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";

    var grades = ViewBag.Grades as List<Grade> ?? new List<Grade>();
    var examGradeHistory = ViewBag.ExamGradeHistory as List<ExamGrade> ?? new List<ExamGrade>();
    var currentExamGradeIds = ViewBag.CurrentExamGradeIds as HashSet<int> ?? new HashSet<int>();
    var subjectBreakdown = ViewBag.SubjectBreakdown as List<SchoolManagementSystem.Web.ViewModels.Teacher.StudentSubjectAverageViewModel>
        ?? new List<SchoolManagementSystem.Web.ViewModels.Teacher.StudentSubjectAverageViewModel>();
    double attendanceRate = Convert.ToDouble(ViewBag.AttendanceRate);
    int presentCount = Convert.ToInt32(ViewBag.PresentCount);
    int totalLessons = Convert.ToInt32(ViewBag.TotalLessons);

    string GradeClass(decimal? value) => value switch
    {
        null => string.Empty,
        >= 90 => "grade-high",
        >= 75 => "grade-good",
        _ => "grade-low"
    };

    string RelationLabel(ParentRelation relation) => relation switch
    {
        ParentRelation.Mother => Localizer["Mother"].Value,
        ParentRelation.Father => Localizer["Father"].Value,
        ParentRelation.Guardian => Localizer["Guardian"].Value,
        _ => string.Empty
    };
}

<link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />

<div class="entity-details-page">
    <a asp-action="Index" class="entity-details-back">
        <i class="bi bi-arrow-left"></i>
        @Localizer["My Students"]
    </a>

    <section class="entity-details-hero">
        <div class="entity-details-identity">
            <div class="entity-details-icon">
                @(string.IsNullOrWhiteSpace(Model.FirstName) ? "S" : Model.FirstName.Substring(0, 1).ToUpper())
            </div>
            <div>
                <span class="entity-details-eyebrow">@Localizer["Student"]</span>
                <h1 class="entity-details-title">@Model.FirstName @Model.LastName</h1>
                <p class="entity-details-subtitle">@(Model.Group?.Name ?? Localizer["No group"].Value)</p>
                <div class="entity-details-meta">
                    <span class="entity-meta-badge"><i class="bi bi-hash"></i>@Localizer["Student #{0}", Model.Id]</span>
                    <span class="entity-meta-badge"><i class="bi bi-calendar3"></i>@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                    @if (Model.Group != null)
                    {
                        <span class="entity-meta-badge"><i class="bi bi-collection-fill"></i>@Model.Group.Name</span>
                    }
                </div>
            </div>
        </div>
        <div class="entity-details-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                @Localizer["Back"]
            </a>
        </div>
    </section>

    <div class="entity-details-grid entity-details-grid-wide mb-4">
        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-person-badge-fill"></i>@Localizer["Student Information"]</h2>
                </div>
            </div>
            <div class="entity-panel-body">
                <div class="entity-facts">
                    <div class="entity-fact"><span>ID</span><strong>#@Model.Id</strong></div>
                    <div class="entity-fact"><span>@Localizer["Date of Birth"]</span><strong>@Model.DateOfBirth.ToString("dd MMMM yyyy")</strong></div>
                    <div class="entity-fact"><span>@Localizer["Group"]</span><strong>@(Model.Group?.Name ?? Localizer["No group"].Value)</strong></div>
                    <div class="entity-fact"><span>@Localizer["Attendance"]</span><strong>@presentCount / @totalLessons</strong></div>
                </div>
            </div>
        </section>

        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-people-fill"></i>@Localizer["Parent Information"]</h2>
                </div>
            </div>
            <div class="entity-panel-body">
                @if (!Model.Parents.Any())
                {
                    <p class="text-muted mb-0">@Localizer["Not assigned"]</p>
                }
                else
                {
                    <div class="parent-contact-list">
                        @foreach (var parent in Model.Parents)
                        {
                            <div class="parent-contact-item">
                                <div class="parent-contact-name">
                                    @parent.ApplicationUser.FullName
                                    @if (parent.Relation != ParentRelation.Unspecified)
                                    {
                                        <span class="parent-relation-badge">@RelationLabel(parent.Relation)</span>
                                    }
                                </div>
                                <div class="parent-contact-details">
                                    <partial name="_PhoneActions" model="parent.ApplicationUser.PhoneNumber" />
                                    @if (!string.IsNullOrWhiteSpace(parent.ApplicationUser.Email))
                                    {
                                        <span class="parent-contact-email"><i class="bi bi-envelope-fill"></i> @parent.ApplicationUser.Email</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="entity-panel">
            <div class="entity-panel-head">
                <div>
                    <h2 class="entity-panel-title"><i class="bi bi-graph-up-arrow"></i>@Localizer["Progress"]</h2>
                </div>
            </div>
            <div class="entity-panel-body">
                <div class="entity-facts">
                    <div class="entity-fact"><span>@Localizer["Attendance"]</span><strong>@attendanceRate.ToString("0.#")%</strong></div>
                    <div class="entity-fact"><span>@Localizer["Recorded Lessons"]</span><strong>@totalLessons</strong></div>
                </div>

                @if (subjectBreakdown.Any())
                {
                    <div class="entity-subject-breakdown">
                        @foreach (var subject in subjectBreakdown)
                        {
                            <div class="entity-subject-row">
                                <span class="subject-badge">@subject.SubjectName</span>
                                <span class="grade-badge @GradeClass(subject.Average)">
                                    @(subject.Average?.ToString("0.##") ?? "—")
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mt-3 mb-0">@Localizer["No grades recorded yet"]</p>
                }
            </div>
        </section>
    </div>

    <section class="entity-panel">
        <div class="entity-panel-head">
            <div>
                <h2 class="entity-panel-title"><i class="bi bi-journal-check"></i>@Localizer["Grade History"]</h2>
                <p class="entity-panel-subtitle">@Localizer["Grades recorded by you for this student"]</p>
            </div>
            <span class="entity-panel-count">@grades.Count</span>
        </div>
        <div class="entity-panel-body">
            @if (!grades.Any())
            {
                <div class="entity-empty"><div><i class="bi bi-journal-x"></i>@Localizer["This student does not have any grades recorded by you."]</div></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover management-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Subject"]</th>
                                <th>@Localizer["Grade"]</th>
                                <th>@Localizer["Comment"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grade in grades)
                            {
                                <tr>
                                    <td><div class="record-date">@grade.Date.ToString("dd MMM yyyy")</div></td>
                                    <td><span class="subject-badge">@grade.Subject.Name</span></td>
                                    <td>
                                        <span class="grade-badge @(grade.Value >= 90 ? "grade-high" : grade.Value >= 75 ? "grade-good" : "grade-low")">@grade.Value.ToString("0.##")</span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(grade.Comment) ? "—" : grade.Comment)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="entity-panel mt-4">
        <div class="entity-panel-head">
            <div>
                <h2 class="entity-panel-title"><i class="bi bi-clock-history"></i>@Localizer["Exam Grade History"]</h2>
                <p class="entity-panel-subtitle">@Localizer["Every exam result you have ever saved for this student, kept permanently. The current result for each subject is highlighted."]</p>
            </div>
            <span class="entity-panel-count">@examGradeHistory.Count</span>
        </div>
        <div class="entity-panel-body">
            @if (!examGradeHistory.Any())
            {
                <div class="entity-empty"><div><i class="bi bi-journal-x"></i>@Localizer["This student does not have any exam grades recorded by you."]</div></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover management-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Subject"]</th>
                                <th>@Localizer["Exam 1"]</th>
                                <th>@Localizer["Exam 2"]</th>
                                <th>@Localizer["Average"]</th>
                                <th>@Localizer["Comment"]</th>
                                <th>@Localizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in examGradeHistory)
                            {
                                bool isCurrent = currentExamGradeIds.Contains(exam.Id);
                                <tr class="@(isCurrent ? "" : "text-muted")">
                                    <td><div class="record-date">@exam.UpdatedAt.ToString("dd MMM yyyy HH:mm")</div></td>
                                    <td><span class="subject-badge">@exam.Subject.Name</span></td>
                                    <td>@(exam.Exam1?.ToString("0.##") ?? "—")</td>
                                    <td>@(exam.Exam2?.ToString("0.##") ?? "—")</td>
                                    <td>
                                        <span class="grade-badge @GradeClass(exam.Average)">
                                            @(exam.Average?.ToString("0.##") ?? "—")
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(exam.Comment) ? "—" : exam.Comment)</td>
                                    <td>
                                        @if (isCurrent)
                                        {
                                            <span class="badge bg-success">@Localizer["Current"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer["History"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
