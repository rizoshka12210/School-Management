@model SchoolManagementSystem.Web.Models.Entities.Student
@using SchoolManagementSystem.Web.Models.Entities

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";

    var grades = ViewBag.Grades as List<Grade> ?? new List<Grade>();
    double attendanceRate = Convert.ToDouble(ViewBag.AttendanceRate);
    double averageGrade = Convert.ToDouble(ViewBag.AverageGrade);
    int presentCount = Convert.ToInt32(ViewBag.PresentCount);
    int totalLessons = Convert.ToInt32(ViewBag.TotalLessons);
}

<div class="teacher-details-header">
    <div>
        <a asp-action="Index" class="back-link">← @Localizer["My Students"]</a>

        <div class="teacher-student-profile mt-3">
            <div class="teacher-student-avatar">
                @(string.IsNullOrWhiteSpace(Model.FirstName)
                    ? "S"
                    : Model.FirstName.Substring(0, 1).ToUpper())
            </div>

            <div>
                <h1 class="page-title mb-1">@Model.FirstName @Model.LastName</h1>
                <div class="d-flex align-items-center gap-2">
                    @if (Model.Group != null)
                    {
                        <span class="group-badge">@Model.Group.Name</span>
                    }
                    <span class="text-muted small">@Localizer["Student #{0}", Model.Id]</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="teacher-student-stat-grid">
    <div class="teacher-student-stat">
        <div class="teacher-student-stat-icon attendance-color">AT</div>
        <div>
            <span>@Localizer["Attendance"]</span>
            <strong>@attendanceRate.ToString("0.#")%</strong>
            <small>@Localizer["{0} of {1} present", presentCount, totalLessons]</small>
        </div>
    </div>

    <div class="teacher-student-stat">
        <div class="teacher-student-stat-icon grade-color">GD</div>
        <div>
            <span>@Localizer["Average Grade"]</span>
            <strong>@averageGrade.ToString("0.##")</strong>
            <small>@Localizer["In your subjects"]</small>
        </div>
    </div>

    <div class="teacher-student-stat">
        <div class="teacher-student-stat-icon lessons-color">LS</div>
        <div>
            <span>@Localizer["Recorded Lessons"]</span>
            <strong>@totalLessons</strong>
            <small>@Localizer["Attendance records"]</small>
        </div>
    </div>

    <div class="teacher-student-stat">
        <div class="teacher-student-stat-icon subject-color">GD</div>
        <div>
            <span>@Localizer["Grades"]</span>
            <strong>@grades.Count</strong>
            <small>@Localizer["Recorded grades"]</small>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Grade History"]</h5>
                <p class="section-subtitle">@Localizer["Grades recorded by you for this student"]</p>
            </div>
        </div>

        @if (!grades.Any())
        {
            <div class="teacher-empty">
                <div class="teacher-empty-icon">GD</div>
                <h5>@Localizer["No grades yet"]</h5>
                <p>@Localizer["This student does not have any grades recorded by you."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Grade"]</th>
                            <th>@Localizer["Comment"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grade in grades)
                        {
                            <tr>
                                <td><div class="record-date">@grade.Date.ToString("dd MMM yyyy")</div></td>
                                <td><span class="subject-badge">@grade.Subject.Name</span></td>
                                <td>
                                    @if (grade.Value >= 5)
                                    {
                                        <span class="grade-badge grade-high">@grade.Value</span>
                                    }
                                    else if (grade.Value >= 4)
                                    {
                                        <span class="grade-badge grade-good">@grade.Value</span>
                                    }
                                    else
                                    {
                                        <span class="grade-badge grade-low">@grade.Value</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(grade.Comment))
                                    {
                                        @grade.Comment
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>