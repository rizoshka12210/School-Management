@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Schedule>

@{
    ViewData["Title"] = Localizer["My Schedule"];

    var totalLessons = Model.Count();

    var groupsCount = Model
        .Select(s => s.GroupId)
        .Distinct()
        .Count();

    var subjectsCount = Model
        .Select(s => s.SubjectId)
        .Distinct()
        .Count();

    var daysCount = Model
        .Select(s => s.DayOfWeek)
        .Distinct()
        .Count();

    var orderedDays = new[]
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };

    var today = DateTime.Today;
    var daysSinceMonday = ((int)today.DayOfWeek + 6) % 7;
    var weekStart = today.AddDays(-daysSinceMonday);
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            @Localizer["My Schedule"]
        </h1>

        <p class="page-subtitle">
            @Localizer["Your weekly teaching timetable"]
        </p>

    </div>

    <div class="teacher-count-label">
        @Localizer["{0} lesson(s)", totalLessons]
    </div>

</div>

<div class="teacher-schedule-stats">

    <div class="teacher-schedule-stat">

        <div class="teacher-schedule-stat-icon schedule-lessons">
            <i class="bi bi-easel2-fill"></i>
        </div>

        <div>
            <span>@Localizer["Weekly Lessons"]</span>
            <strong>@totalLessons</strong>
        </div>

    </div>

    <div class="teacher-schedule-stat">

        <div class="teacher-schedule-stat-icon schedule-groups">
            <i class="bi bi-collection-fill"></i>
        </div>

        <div>
            <span>@Localizer["Groups"]</span>
            <strong>@groupsCount</strong>
        </div>

    </div>

    <div class="teacher-schedule-stat">

        <div class="teacher-schedule-stat-icon schedule-subjects">
            <i class="bi bi-book-fill"></i>
        </div>

        <div>
            <span>@Localizer["Subjects"]</span>
            <strong>@subjectsCount</strong>
        </div>

    </div>

    <div class="teacher-schedule-stat">

        <div class="teacher-schedule-stat-icon schedule-days">
            <i class="bi bi-calendar3"></i>
        </div>

        <div>
            <span>@Localizer["Teaching Days"]</span>
            <strong>@daysCount</strong>
        </div>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">

        <div class="teacher-empty">

            <div class="teacher-empty-icon"><i class="bi bi-calendar3-week-fill"></i></div>

            <h5>
                @Localizer["No schedule entries"]
            </h5>

            <p>
                @Localizer["Your weekly schedule will appear here."]
            </p>

        </div>

    </div>
}
else
{
    <div class="teacher-week">

        @for (var dayIndex = 0; dayIndex < orderedDays.Length; dayIndex++)
        {
            var day = orderedDays[dayIndex];
            var dayDate = weekStart.AddDays(dayIndex);

            var lessons = Model
                .Where(s => s.DayOfWeek == day)
                .OrderBy(s => s.StartTime)
                .ToList();

            if (lessons.Any())
            {
                <div class="teacher-schedule-day">

                    <div class="teacher-schedule-day-header">

                        <div>

                            <div class="teacher-schedule-day-name">
                                @Localizer[day.ToString()]
                                <span class="teacher-schedule-day-date">
                                    @dayDate.ToString("d MMMM")
                                </span>
                            </div>

                            <div class="teacher-schedule-day-count">
                                @Localizer["{0} lesson(s)", lessons.Count]
                            </div>

                        </div>

                    </div>

                    <div class="teacher-schedule-day-body">

                        @foreach (var item in lessons)
                        {
                            <div class="teacher-schedule-item">

                                <div class="teacher-schedule-time">

                                    <strong>
                                        @item.StartTime.ToString("HH:mm")
                                    </strong>

                                    <span>
                                        @item.EndTime.ToString("HH:mm")
                                    </span>

                                </div>

                                <div class="teacher-schedule-line">
                                </div>

                                <div class="teacher-schedule-main">

                                    <div class="teacher-schedule-subject">
                                        @item.Subject.Name
                                    </div>

                                    <div class="teacher-schedule-group">
                                        @item.Group.Name
                                    </div>

                                </div>

                                <div>

                                    <span class="subject-badge">
                                        @item.Subject.Name
                                    </span>

                                </div>

                                <div>

                                    <span class="group-badge">
                                        @item.Group.Name
                                    </span>

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }
        }

    </div>
}