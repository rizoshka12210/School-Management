@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Lesson>

@{
    ViewData["Title"] = "My Lessons";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">My Lessons</h1>
        <p class="text-muted mb-0">Lessons assigned to you by the administration</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No lessons yet</h5>
                    <p class="text-muted mb-0">
                        Lessons are created by an administrator.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Group</th>
                                <th>Subject</th>
                                <th>Topic</th>
                                <th>Attendance</th>
                                <th>Grades</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lesson in Model)
                            {
                                <tr>
                                    <td>@lesson.StartTime.ToString("dd.MM.yyyy")</td>
                                    <td>@lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")</td>
                                    <td>@lesson.Group.Name</td>
                                    <td>@lesson.Subject.Name</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(lesson.Topic))
                                        {
                                            @lesson.Topic
                                        }
                                        else
                                        {
                                            <span class="text-muted">No topic</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lesson.Attendances.Any())
                                        {
                                            <span class="badge bg-success">Marked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not marked</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@lesson.Grades.Count</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@lesson.Id"
                                           class="btn btn-sm btn-outline-info">Details</a>
                                        <a asp-area="Teacher" asp-controller="Attendance" asp-action="Mark"
                                           asp-route-lessonId="@lesson.Id"
                                           class="btn btn-sm btn-outline-primary">Attendance</a>
                                        <a asp-area="Teacher" asp-controller="Grades" asp-action="Add"
                                           asp-route-lessonId="@lesson.Id"
                                           class="btn btn-sm btn-outline-primary">Grades</a>
                                        <a asp-area="Teacher" asp-controller="Topics" asp-action="Edit"
                                           asp-route-id="@lesson.Id"
                                           class="btn btn-sm btn-outline-secondary">Topic</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
