@model SchoolManagementSystem.Web.ViewModels.Teacher.TeacherDashboardViewModel

@{
    ViewData["Title"] = Localizer["Teacher Dashboard"];
}

<div class="teacher-dashboard-header">

    <div>
        <div class="teacher-welcome-label">
            @Localizer["Welcome back"]
        </div>

        <h1 class="page-title">
            @Model.TeacherName
        </h1>

        <p class="page-subtitle">
            @Localizer["Here's your teaching overview for today."]
        </p>
    </div>

    <div class="dashboard-date">
        @DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </div>

</div>

<div class="teacher-stat-grid">

    <a asp-area="Teacher"
       asp-controller="Groups"
       asp-action="Index"
       class="teacher-stat-card">

        <div class="teacher-stat-icon teacher-stat-groups">
            GR
        </div>

        <div class="teacher-stat-content">

            <span class="teacher-stat-label">
                @Localizer["My Groups"]
            </span>

            <strong class="teacher-stat-number">
                @Model.GroupsCount
            </strong>

            <span class="teacher-stat-link">
                @Localizer["View groups →"]
            </span>

        </div>

    </a>

    <a asp-area="Teacher"
       asp-controller="Students"
       asp-action="Index"
       class="teacher-stat-card">

        <div class="teacher-stat-icon teacher-stat-students">
            ST
        </div>

        <div class="teacher-stat-content">

            <span class="teacher-stat-label">
                @Localizer["My Students"]
            </span>

            <strong class="teacher-stat-number">
                @Model.StudentsCount
            </strong>

            <span class="teacher-stat-link">
                @Localizer["View students →"]
            </span>

        </div>

    </a>

    <a asp-area="Teacher"
       asp-controller="Lessons"
       asp-action="Index"
       class="teacher-stat-card">

        <div class="teacher-stat-icon teacher-stat-lessons">
            LS
        </div>

        <div class="teacher-stat-content">

            <span class="teacher-stat-label">
                @Localizer["Today's Lessons"]
            </span>

            <strong class="teacher-stat-number">
                @Model.TodayLessons.Count
            </strong>

            <span class="teacher-stat-link">
                @Localizer["View lessons →"]
            </span>

        </div>

    </a>

    <a asp-area="Teacher"
       asp-controller="Salary"
       asp-action="Index"
       class="teacher-stat-card">

        <div class="teacher-stat-icon teacher-stat-salary">
            SA
        </div>

        <div class="teacher-stat-content">

            <span class="teacher-stat-label">
                @Localizer["Monthly Salary"]
            </span>

            <strong class="teacher-stat-number teacher-salary-number">
                @Model.CurrentMonthSalary.ToString("0.##")
            </strong>

            <span class="teacher-stat-link">
                @Localizer["{0} hours worked", Model.CurrentMonthWorkedHours.ToString("0.#")]
            </span>

        </div>

    </a>

</div>

<div class="teacher-quick-card">

    <div class="section-header">

        <div>
            <h5 class="section-title">
                @Localizer["Quick Actions"]
            </h5>

            <p class="section-subtitle">
                @Localizer["Access your most common teaching tools"]
            </p>
        </div>

    </div>

    <div class="teacher-quick-grid">

        <a asp-area="Teacher"
           asp-controller="Attendance"
           asp-action="Index"
           class="teacher-quick-action">

            <div class="teacher-quick-icon">
                AT
            </div>

            <div>
                <strong>@Localizer["Attendance"]</strong>
                <span>@Localizer["Mark student attendance"]</span>
            </div>

            <div class="teacher-quick-arrow">
                →
            </div>

        </a>

        <a asp-area="Teacher"
           asp-controller="Grades"
           asp-action="Index"
           class="teacher-quick-action">

            <div class="teacher-quick-icon teacher-quick-grade">
                GD
            </div>

            <div>
                <strong>@Localizer["Grades"]</strong>
                <span>@Localizer["Manage student grades"]</span>
            </div>

            <div class="teacher-quick-arrow">
                →
            </div>

        </a>

        <a asp-area="Teacher"
           asp-controller="Topics"
           asp-action="Index"
           class="teacher-quick-action">

            <div class="teacher-quick-icon teacher-quick-topic">
                TP
            </div>

            <div>
                <strong>@Localizer["Topics"]</strong>
                <span>@Localizer["Manage lesson topics"]</span>
            </div>

            <div class="teacher-quick-arrow">
                →
            </div>

        </a>

        <a asp-area="Teacher"
           asp-controller="Schedule"
           asp-action="Index"
           class="teacher-quick-action">

            <div class="teacher-quick-icon teacher-quick-schedule">
                SC
            </div>

            <div>
                <strong>@Localizer["Schedule"]</strong>
                <span>@Localizer["View weekly schedule"]</span>
            </div>

            <div class="teacher-quick-arrow">
                →
            </div>

        </a>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        <div class="section-header">

            <div>

                <h5 class="section-title">
                    @Localizer["Today's Schedule"]
                </h5>

                <p class="section-subtitle">

                    @if (Model.TodayLessons.Count == 1)
                    {
                        @Localizer["1 lesson scheduled today"]
                    }
                    else
                    {
                        @Localizer["{0} lessons scheduled today", Model.TodayLessons.Count]
                    }

                </p>

            </div>

            <a asp-area="Teacher"
               asp-controller="Lessons"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                @Localizer["View All"]
            </a>

        </div>

        @if (!Model.TodayLessons.Any())
        {
            <div class="teacher-empty">

                <div class="teacher-empty-icon">
                    ✓
                </div>

                <h5>
                    @Localizer["No lessons today"]
                </h5>

                <p>
                    @Localizer["You don't have any lessons scheduled for today."]
                </p>

                <a asp-area="Teacher"
                   asp-controller="Schedule"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    @Localizer["Go to Weekly Schedule"]
                </a>

            </div>
        }
        else
        {
            <div class="teacher-lessons">

                @foreach (var lesson in Model.TodayLessons)
                {
                    <div class="teacher-lesson-row">

                        <div class="teacher-lesson-time">

                            <strong>
                                @lesson.StartTime.ToString("HH:mm")
                            </strong>

                            <span>
                                @lesson.EndTime.ToString("HH:mm")
                            </span>

                        </div>

                        <div class="teacher-lesson-main">

                            <div class="teacher-lesson-title">
                                @lesson.SubjectName
                            </div>

                            <div class="teacher-lesson-group">
                                @lesson.GroupName
                            </div>

                        </div>

                        <div class="teacher-lesson-topic">

                            <span class="teacher-lesson-small-label">
                                @Localizer["Topic"]
                            </span>

                            @if (!string.IsNullOrWhiteSpace(lesson.Topic))
                            {
                                <strong>
                                    @lesson.Topic
                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">
                                    @Localizer["No topic yet"]
                                </span>
                            }

                        </div>

                        <div class="teacher-lesson-attendance">

                            @if (lesson.AttendanceMarked)
                            {
                                <span class="status-badge status-present">
                                    @Localizer["Attendance marked"]
                                </span>
                            }
                            else
                            {
                                <span class="status-badge teacher-status-pending">
                                    @Localizer["Not marked"]
                                </span>
                            }

                        </div>

                        <div class="teacher-lesson-actions">

                            <a asp-area="Teacher"
                               asp-controller="Attendance"
                               asp-action="Mark"
                               asp-route-lessonId="@lesson.LessonId"
                               class="action-btn action-edit">
                                @Localizer["Attendance"]
                            </a>

                            <a asp-area="Teacher"
                               asp-controller="Grades"
                               asp-action="Add"
                               asp-route-lessonId="@lesson.LessonId"
                               class="action-btn teacher-grade-button">
                                @Localizer["Grades"]
                            </a>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

<div class="card border-0 shadow-sm mt-4">

    <div class="card-body">

        <div class="section-header">

            <div>
                <h5 class="section-title">📅 @Localizer["Upcoming Events"]</h5>
                <p class="section-subtitle">@Localizer["From the school calendar"]</p>
            </div>

            <a asp-area="Teacher"
               asp-controller="Calendar"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                @Localizer["View All"]
            </a>

        </div>

        @if (!Model.UpcomingEvents.Any())
        {
            <div class="dashboard-empty"><p>@Localizer["No upcoming events."]</p></div>
        }
        else
        {
            <div class="performance-list">
                @foreach (var evt in Model.UpcomingEvents)
                {
                    <div class="performance-item">
                        <span class="performance-rank">@evt.Date.ToString("dd MMM")</span>
                        <div class="performance-main">
                            <strong>@evt.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(evt.Description))
                            {
                                <small>@evt.Description</small>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>

</div>
