@model IEnumerable<SchoolManagementSystem.Web.Models.Entities.Lesson>

@{
    ViewData["Title"] = "Topic Calendar";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Topic Calendar</h1>
        <p class="text-muted mb-0">Topics covered in your lessons</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No lessons yet</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Group</th>
                                <th>Subject</th>
                                <th>Topic</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lesson in Model)
                            {
                                <tr>
                                    <td>@lesson.StartTime.ToString("dd.MM.yyyy")</td>
                                    <td>@lesson.Group.Name</td>
                                    <td>@lesson.Subject.Name</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(lesson.Topic))
                                        {
                                            @lesson.Topic
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@lesson.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit Topic
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
