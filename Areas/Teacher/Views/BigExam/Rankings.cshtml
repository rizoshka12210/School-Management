@model List<SchoolManagementSystem.Web.Services.BigExamRankingEntry>
@using SchoolManagementSystem.Web.Models.Entities

@{
    var exam = ViewBag.Exam as BigExam;
    var subjects = ViewBag.Subjects as List<Subject> ?? new List<Subject>();
    int? subjectId = ViewBag.SubjectId;
    ViewData["Title"] = exam?.Title;
}

<div class="page-header">
    <div>
        <a asp-action="Groups" asp-route-examId="@exam?.Id" class="back-link">← @exam?.Title</a>
        <h1 class="page-title mt-2">@Localizer["Rankings"]</h1>
        <p class="page-subtitle">@Localizer["Student's place by group and across the whole center"]</p>
    </div>
</div>

<div class="teacher-grade-subject-tabs mb-4">
    <a asp-action="Rankings" asp-route-examId="@exam?.Id" class="teacher-grade-subject-tab @(subjectId == null ? "active" : "")">
        @Localizer["Overall Total"]
    </a>
    @foreach (var subject in subjects)
    {
        <a asp-action="Rankings" asp-route-examId="@exam?.Id" asp-route-subjectId="@subject.Id" class="teacher-grade-subject-tab @(subjectId == subject.Id ? "active" : "")">
            @subject.Name
        </a>
    }
</div>

@if (ViewBag.CanEdit == true)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form asp-action="SetBlacklistThreshold" method="post" class="d-flex align-items-center flex-wrap gap-2">
                <input type="hidden" name="examId" value="@exam?.Id" />
                <input type="hidden" name="subjectId" value="@subjectId" />

                <label for="blacklistThreshold" class="form-label mb-0">
                    <i class="bi bi-flag-fill text-danger"></i>
                    @Localizer["Blacklist Threshold"]
                </label>

                <input id="blacklistThreshold"
                       name="threshold"
                       type="number"
                       step="0.01"
                       class="form-control form-control-sm"
                       style="max-width: 140px;"
                       value="@exam?.BlacklistThreshold"
                       placeholder="@Localizer["e.g. 60"]" />

                <button type="submit" class="btn btn-sm btn-primary">@Localizer["Save"]</button>

                <span class="text-muted small">
                    @Localizer["Students scoring below this value are marked in the list."]
                </span>
            </form>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <partial name="_BigExamRankingsSections" model="Model" />
    </div>
</div>
