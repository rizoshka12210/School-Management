@model List<SchoolManagementSystem.Web.Services.BigExamGroupOverview>
@using SchoolManagementSystem.Web.Models.Entities

@{
    var exam = ViewBag.Exam as BigExam;
    ViewData["Title"] = exam?.Title;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link">← @Localizer["Big Exam"]</a>
        <h1 class="page-title mt-2">@exam?.Title</h1>
        <p class="page-subtitle">@Localizer["Choose a group and subject to enter scores"]</p>
    </div>

    <a asp-action="Rankings" asp-route-examId="@exam?.Id" class="btn btn-outline-primary">
        <i class="bi bi-bar-chart-fill"></i>
        @Localizer["Rankings"]
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="teacher-empty">
            <div class="teacher-empty-icon"><i class="bi bi-collection-fill"></i></div>
            <h5>@Localizer["No groups yet"]</h5>
        </div>
    </div>
}
else
{
    <div class="teacher-groups-grid">
        @foreach (var group in Model)
        {
            <div class="teacher-group-card teacher-grade-group-card">
                <div class="teacher-group-top">
                    <div class="teacher-group-icon"><i class="bi bi-collection-fill"></i></div>
                </div>

                <div class="teacher-group-name">@group.GroupName</div>
                <div class="teacher-group-subtitle">@Localizer["{0} student(s)", group.StudentsCount]</div>

                <div class="teacher-grade-subject-list">
                    @foreach (var subject in group.Subjects)
                    {
                        <a asp-action="Group"
                           asp-route-examId="@exam?.Id"
                           asp-route-groupId="@group.GroupId"
                           asp-route-subjectId="@subject.SubjectId"
                           class="teacher-grade-subject-link">
                            <span class="subject-badge">@subject.SubjectName</span>
                            <span class="teacher-grade-subject-status">
                                @if (subject.StudentsGraded == 0)
                                {
                                    <span class="status-badge teacher-status-pending">@Localizer["No grades"]</span>
                                }
                                else
                                {
                                    <span class="status-badge status-present">@subject.StudentsGraded / @group.StudentsCount</span>
                                }
                            </span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}
