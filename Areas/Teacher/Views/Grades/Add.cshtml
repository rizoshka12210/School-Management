@model SchoolManagementSystem.Web.ViewModels.Teacher.GradeEntryViewModel
@using System.Globalization

@{
    ViewData["Title"] = Localizer["Enter Grades"];
}

<div class="form-page-header">

    <a asp-action="Index" class="back-link">← @Localizer["Grades"]</a>

    <div class="teacher-lesson-form-header mt-3">
        <div class="teacher-lesson-form-icon grade-form-icon"><i class="bi bi-journal-check"></i></div>
        <div>
            <h1 class="page-title mb-1">@Localizer["Enter Grades"]</h1>
            <div class="teacher-lesson-meta">
                <span class="subject-badge">@Model.SubjectName</span>
                <span class="group-badge">@Model.GroupName</span>
                <span>@Model.LessonDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>
    </div>

</div>

<form asp-action="Add" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LessonId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="section-header">
                <div>
                    <h5 class="section-title">@Localizer["Student Grades"]</h5>
                    <p class="section-subtitle">@Localizer["Enter two exam scores from 0 to 100 - the average is calculated automatically"]</p>
                </div>
                <div class="teacher-count-label">@Localizer["{0} student(s)", Model.Students.Count]</div>
            </div>

            @if (!Model.Students.Any())
            {
                <div class="teacher-empty">
                    <div class="teacher-empty-icon"><i class="bi bi-people-fill"></i></div>
                    <h5>@Localizer["No students"]</h5>
                    <p>@Localizer["This group does not have any students."]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover management-table exam-grades-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Student"]</th>
                                <th>@Localizer["Exam 1"]</th>
                                <th>@Localizer["Exam 2"]</th>
                                <th>@Localizer["Average"]</th>
                                <th>@Localizer["Comment"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Students.Count; i++)
                            {
                                var row = Model.Students[i];

                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Students[i].StudentId" />
                                        <input type="hidden" asp-for="Students[i].StudentName" />
                                        <div class="teacher-attendance-student">
                                            <div class="person-avatar">
                                                @(string.IsNullOrWhiteSpace(row.StudentName)
                                                    ? "S"
                                                    : row.StudentName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <strong>@row.StudentName</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text"
                                               inputmode="decimal"
                                               name="Students[@i].Exam1"
                                               class="form-control exam-input"
                                               data-row="@i"
                                               placeholder="0-100"
                                               value="@(row.Exam1?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                                        <span asp-validation-for="Students[i].Exam1" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input type="text"
                                               inputmode="decimal"
                                               name="Students[@i].Exam2"
                                               class="form-control exam-input"
                                               data-row="@i"
                                               placeholder="0-100"
                                               value="@(row.Exam2?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                                        <span asp-validation-for="Students[i].Exam2" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <strong class="exam-average" data-row="@i">
                                            @(row.Average?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")
                                        </strong>
                                    </td>
                                    <td>
                                        <input asp-for="Students[i].Comment" class="form-control" placeholder="@Localizer["Optional comment..."]" />
                                        <span asp-validation-for="Students[i].Comment" class="text-danger small"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.Students.Any())
    {
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-light">
                <i class="bi bi-x-lg"></i>
                @Localizer["Cancel"]
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle"></i>
                @Localizer["Save Grades"]
            </button>
        </div>
    }

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const parse = value => {
                if (!value) return null;
                const normalized = value.trim().replace(",", ".");
                const number = Number(normalized);
                return Number.isNaN(number) ? null : number;
            };

            const refreshRow = row => {
                const exam1 = parse(document.querySelector(`.exam-input[name="Students[${row}].Exam1"]`)?.value);
                const exam2 = parse(document.querySelector(`.exam-input[name="Students[${row}].Exam2"]`)?.value);
                const target = document.querySelector(`.exam-average[data-row="${row}"]`);

                if (!target) return;

                let average = null;
                if (exam1 !== null && exam2 !== null) average = Math.round(((exam1 + exam2) / 2) * 100) / 100;
                else if (exam1 !== null) average = exam1;
                else if (exam2 !== null) average = exam2;

                target.textContent = average === null ? "—" : average.toString();
            };

            document.querySelectorAll(".exam-input").forEach(input => {
                input.addEventListener("input", () => refreshRow(input.dataset.row));
            });
        })();
    </script>
}
