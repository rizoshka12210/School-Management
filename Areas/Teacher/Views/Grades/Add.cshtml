@model SchoolManagementSystem.Web.ViewModels.Teacher.GradeEntryViewModel

@{
    ViewData["Title"] = Localizer["Enter Grades"];
}

<div class="form-page-header">

    <a asp-action="Index" class="back-link">← @Localizer["Grades"]</a>

    <div class="teacher-lesson-form-header mt-3">
        <div class="teacher-lesson-form-icon grade-form-icon">GD</div>
        <div>
            <h1 class="page-title mb-1">@Localizer["Enter Grades"]</h1>
            <div class="teacher-lesson-meta">
                <span class="subject-badge">@Model.SubjectName</span>
                <span class="group-badge">@Model.GroupName</span>
                <span>@Model.LessonDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>
    </div>

</div>

<form asp-action="Add" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LessonId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="section-header">
                <div>
                    <h5 class="section-title">@Localizer["Student Grades"]</h5>
                    <p class="section-subtitle">@Localizer["Enter a grade from 1 to 5 and an optional comment"]</p>
                </div>
                <div class="teacher-count-label">@Localizer["{0} student(s)", Model.Students.Count]</div>
            </div>

            @if (!Model.Students.Any())
            {
                <div class="teacher-empty">
                    <div class="teacher-empty-icon">ST</div>
                    <h5>@Localizer["No students"]</h5>
                    <p>@Localizer["This group does not have any students."]</p>
                </div>
            }
            else
            {
                <div class="teacher-grade-entry-list">
                    @for (var i = 0; i < Model.Students.Count; i++)
                    {
                        <input type="hidden" asp-for="Students[i].StudentId" />
                        <input type="hidden" asp-for="Students[i].StudentName" />

                        <div class="teacher-grade-entry-row">
                            <div class="teacher-attendance-student">
                                <div class="person-avatar">
                                    @(string.IsNullOrWhiteSpace(Model.Students[i].StudentName)
                                        ? "S"
                                        : Model.Students[i].StudentName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <strong>@Model.Students[i].StudentName</strong>
                                    <span>@Localizer["Student"]</span>
                                </div>
                            </div>

                            <div class="teacher-grade-input">
                                <label asp-for="Students[i].Value">@Localizer["Grade"]</label>
                                <select asp-for="Students[i].Value" class="form-select">
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                </select>
                                <span asp-validation-for="Students[i].Value" class="text-danger small"></span>
                            </div>

                            <div class="teacher-grade-comment">
                                <label asp-for="Students[i].Comment">@Localizer["Comment"]</label>
                                <input asp-for="Students[i].Comment" class="form-control" placeholder="@Localizer["Optional comment..."]" />
                                <span asp-validation-for="Students[i].Comment" class="text-danger small"></span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.Students.Any())
    {
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-light">
                <i class="bi bi-x-lg"></i>
                @Localizer["Cancel"]
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle"></i>
                @Localizer["Save Grades"]
            </button>
        </div>
    }

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}