@model SchoolManagementSystem.Web.ViewModels.Shared.ExamSheetViewModel
@using System.Globalization
@using SchoolManagementSystem.Web.ViewModels.Teacher

@{
    ViewData["Title"] = Model.SubjectName;
    var subjects = (List<GradesSubjectViewModel>)ViewBag.Subjects;

    string GradeClass(decimal? value) => value.HasValue ? "grade-neutral" : string.Empty;

    string RowClass(decimal? average) =>
        Model.BlacklistThreshold.HasValue && average.HasValue && average.Value < Model.BlacklistThreshold.Value
            ? "exam-blacklisted"
            : string.Empty;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link">← @Localizer["Grades"]</a>
        <h1 class="page-title mt-2">@Model.GroupName</h1>
        <p class="page-subtitle">@Model.SubjectName · @Model.Date.ToString("dd MMM yyyy")</p>
    </div>
</div>

@if (subjects.Count > 1)
{
    <div class="teacher-grade-subject-tabs">
        @foreach (var subject in subjects)
        {
            <a asp-action="Group"
               asp-route-groupId="@Model.GroupId"
               asp-route-subjectId="@subject.SubjectId"
               class="teacher-grade-subject-tab @(subject.SubjectId == Model.SubjectId ? "active" : "")">
                @subject.SubjectName
            </a>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="SetBlacklistThreshold" method="post" class="d-flex align-items-center flex-wrap gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.GroupId" />
            <input type="hidden" name="subjectId" value="@Model.SubjectId" />

            <label for="blacklistThreshold" class="form-label mb-0">
                <i class="bi bi-flag-fill text-danger"></i>
                @Localizer["Blacklist Threshold"]
            </label>

            <input id="blacklistThreshold"
                   name="threshold"
                   type="number"
                   step="0.01"
                   class="form-control form-control-sm"
                   style="max-width: 140px;"
                   value="@Model.BlacklistThreshold"
                   placeholder="@Localizer["e.g. 60"]" />

            <button type="submit" class="btn btn-sm btn-primary">@Localizer["Save"]</button>

            <span class="text-muted small">
                @Localizer["Students scoring below this value are marked in the list."]
            </span>
        </form>
    </div>
</div>

<form asp-action="Group" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="GroupId" value="@Model.GroupId" />
    <input type="hidden" name="SubjectId" value="@Model.SubjectId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (!Model.Rows.Any())
            {
                <div class="teacher-empty">
                    <div class="teacher-empty-icon"><i class="bi bi-people-fill"></i></div>
                    <h5>@Localizer["No students"]</h5>
                    <p>@Localizer["This group does not have any students."]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover management-table exam-grades-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Student"]</th>
                                <th>@Localizer["Exam 1"]</th>
                                <th>@Localizer["Exam 2"]</th>
                                <th>@Localizer["Average"]</th>
                                <th>@Localizer["Comment"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];

                                <tr class="@RowClass(row.Average) exam-row" data-row="@i">
                                    <td>
                                        <input type="hidden" name="Rows[@i].StudentId" value="@row.StudentId" />
                                        <div class="teacher-attendance-student">
                                            <div class="person-avatar">
                                                @(string.IsNullOrWhiteSpace(row.StudentName)
                                                    ? "S"
                                                    : row.StudentName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <strong>@row.StudentName</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text"
                                               inputmode="decimal"
                                               name="Rows[@i].Exam1"
                                               class="form-control exam-input"
                                               data-row="@i"
                                               placeholder="0-100"
                                               value="@(row.Exam1?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                                    </td>
                                    <td>
                                        <input type="text"
                                               inputmode="decimal"
                                               name="Rows[@i].Exam2"
                                               class="form-control exam-input"
                                               data-row="@i"
                                               placeholder="0-100"
                                               value="@(row.Exam2?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                                    </td>
                                    <td>
                                        <strong class="exam-average" data-row="@i">
                                            @(row.Average?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")
                                        </strong>
                                    </td>
                                    <td>
                                        <input type="text"
                                               name="Rows[@i].Comment"
                                               class="form-control"
                                               maxlength="300"
                                               placeholder="@Localizer["Optional comment..."]"
                                               value="@row.Comment" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        @Localizer["Save Grades"]
                    </button>
                </div>
            }

        </div>
    </div>

</form>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <div class="section-header">
            <div>
                <h5 class="section-title">@Localizer["Exam Grade History"]</h5>
                <p class="section-subtitle">@Localizer["Every exam result you have ever saved for this group and subject, kept permanently. The current result for each student is highlighted."]</p>
            </div>
            <span class="entity-panel-count">@Model.History.Count</span>
        </div>

        @if (!Model.History.Any())
        {
            <div class="teacher-empty">
                <div class="teacher-empty-icon"><i class="bi bi-journal-x"></i></div>
                <h5>@Localizer["No history yet"]</h5>
                <p>@Localizer["Save grades for this group and subject to start building history."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover management-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Student"]</th>
                            <th>@Localizer["Exam 1"]</th>
                            <th>@Localizer["Exam 2"]</th>
                            <th>@Localizer["Average"]</th>
                            <th>@Localizer["Comment"]</th>
                            <th>@Localizer["Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.History)
                        {
                            <tr class="@(entry.IsCurrent ? RowClass(entry.Average) : "text-muted")">
                                <td>@entry.UpdatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@entry.StudentName</td>
                                <td>@(entry.Exam1?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td>@(entry.Exam2?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td><span class="grade-badge @GradeClass(entry.Average)">@(entry.Average?.ToString("0.##", CultureInfo.InvariantCulture) ?? "—")</span></td>
                                <td>@(string.IsNullOrWhiteSpace(entry.Comment) ? "—" : entry.Comment)</td>
                                <td>
                                    @if (entry.IsCurrent)
                                    {
                                        <span class="badge bg-success">@Localizer["Current"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["History"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const blacklistThreshold = @(Model.BlacklistThreshold.HasValue ? Model.BlacklistThreshold.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");

            const parse = value => {
                if (!value) return null;
                const normalized = value.trim().replace(",", ".");
                const number = Number(normalized);
                return Number.isNaN(number) ? null : number;
            };

            const refreshRow = row => {
                const exam1 = parse(document.querySelector(`.exam-input[name="Rows[${row}].Exam1"]`)?.value);
                const exam2 = parse(document.querySelector(`.exam-input[name="Rows[${row}].Exam2"]`)?.value);
                const target = document.querySelector(`.exam-average[data-row="${row}"]`);

                if (!target) return;

                let average = null;
                if (exam1 !== null && exam2 !== null) average = Math.round(((exam1 + exam2) / 2) * 100) / 100;
                else if (exam1 !== null) average = exam1;
                else if (exam2 !== null) average = exam2;

                target.textContent = average === null ? "—" : average.toString();

                const rowEl = document.querySelector(`tr.exam-row[data-row="${row}"]`);
                if (rowEl) {
                    const blacklisted = blacklistThreshold !== null && average !== null && average < blacklistThreshold;
                    rowEl.classList.toggle("exam-blacklisted", blacklisted);
                }
            };

            document.querySelectorAll(".exam-input").forEach(input => {
                input.addEventListener("input", () => refreshRow(input.dataset.row));
            });
        })();
    </script>
}
