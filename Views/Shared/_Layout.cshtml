@inject SchoolManagementSystem.Web.Services.NotificationService NotificationService
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var seenNotificationFingerprint = Context.Request.Cookies[
        SchoolManagementSystem.Web.Services.NotificationService.SeenCookieName];
    var requestPath = Context.Request.Path.Value ?? string.Empty;
    var isNotificationsPage = requestPath.StartsWith(
        "/Notifications",
        StringComparison.OrdinalIgnoreCase);
    var notificationCount = User.Identity?.IsAuthenticated == true
        ? (isNotificationsPage
            ? 0
            : await NotificationService.GetUnreadCountAsync(User, seenNotificationFingerprint))
        : 0;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    string Active(string targetArea, string targetController)
        => area == targetArea && controller == targetController ? "active" : "";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#111827" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="School" />
    <script>
        (() => {
            const savedTheme = localStorage.getItem("school-theme");
            document.documentElement.setAttribute("data-theme", savedTheme === "light" ? "light" : "dark");
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolManagementSystem.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/polish.css" asp-append-version="true" />
</head>
<body>
<div class="app">
@if (User.Identity?.IsAuthenticated == true)
{
    <aside id="appSidebar" class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo"><i class="bi bi-mortarboard-fill"></i></div>
            <div><div class="brand-title">@Localizer["School"]</div><div class="brand-subtitle">@Localizer["Management"]</div></div>
        </div>
        <nav class="sidebar-nav">
        @if (User.IsInRole("Admin") || User.IsInRole("Director"))
        {
            <div class="sidebar-section">@Localizer["NavSectionAdmin"]</div>
            <a class="sidebar-link @Active("Admin", "Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill sidebar-link-icon"></i><span>@Localizer["Dashboard"]</span></a>
            <a class="sidebar-link @Active("Admin", "Students")" asp-area="Admin" asp-controller="Students" asp-action="Index"><i class="bi bi-people-fill sidebar-link-icon"></i><span>@Localizer["Students"]</span></a>
            <a class="sidebar-link @Active("Admin", "Accounting")" asp-area="Admin" asp-controller="Accounting" asp-action="Index"><i class="bi bi-wallet2 sidebar-link-icon"></i><span>@Localizer["Accounting"]</span></a>
            <a class="sidebar-link @Active("Admin", "Parents")" asp-area="Admin" asp-controller="Parents" asp-action="Index"><i class="bi bi-person-hearts sidebar-link-icon"></i><span>@Localizer["Parents"]</span></a>
            <a class="sidebar-link @Active("Admin", "Teachers")" asp-area="Admin" asp-controller="Teachers" asp-action="Index"><i class="bi bi-person-workspace sidebar-link-icon"></i><span>@Localizer["Teachers"]</span></a>
            <a class="sidebar-link @Active("Admin", "Directors")" asp-area="Admin" asp-controller="Directors" asp-action="Index"><i class="bi bi-person-badge-fill sidebar-link-icon"></i><span>@Localizer["Directors"]</span></a>
            <a class="sidebar-link @Active("Admin", "Groups")" asp-area="Admin" asp-controller="Groups" asp-action="Index"><i class="bi bi-collection-fill sidebar-link-icon"></i><span>@Localizer["Groups"]</span></a>
            <a class="sidebar-link @Active("Admin", "Subjects")" asp-area="Admin" asp-controller="Subjects" asp-action="Index"><i class="bi bi-book-fill sidebar-link-icon"></i><span>@Localizer["Subjects"]</span></a>
            <div class="sidebar-section">@Localizer["NavSectionEducation"]</div>
            <a class="sidebar-link @Active("Admin", "Lessons")" asp-area="Admin" asp-controller="Lessons" asp-action="Index"><i class="bi bi-easel2-fill sidebar-link-icon"></i><span>@Localizer["Lessons"]</span></a>
            <a class="sidebar-link @Active("Admin", "Schedule")" asp-area="Admin" asp-controller="Schedule" asp-action="Index"><i class="bi bi-calendar3-week-fill sidebar-link-icon"></i><span>@Localizer["Schedule"]</span></a>
            <a class="sidebar-link @Active("Admin", "Attendance")" asp-area="Admin" asp-controller="Attendance" asp-action="Index"><i class="bi bi-clipboard2-check-fill sidebar-link-icon"></i><span>@Localizer["Attendance"]</span></a>
            <a class="sidebar-link @Active("Admin", "Grades")" asp-area="Admin" asp-controller="Grades" asp-action="Index"><i class="bi bi-journal-check sidebar-link-icon"></i><span>@Localizer["Grades"]</span></a>
            <a class="sidebar-link @Active("Admin", "Salary")" asp-area="Admin" asp-controller="Salary" asp-action="Index"><i class="bi bi-cash-stack sidebar-link-icon"></i><span>@Localizer["Salary"]</span></a>
            <a class="sidebar-link @Active("Admin", "Leaderboard")" asp-area="Admin" asp-controller="Leaderboard" asp-action="Index"><i class="bi bi-trophy-fill sidebar-link-icon"></i><span>@Localizer["Leaderboard"]</span></a>
            <a class="sidebar-link @Active("Admin", "Calendar")" asp-area="Admin" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar-event-fill sidebar-link-icon"></i><span>@Localizer["School Calendar"]</span></a>
            <a class="sidebar-link @Active("Admin", "ActivityLog")" asp-area="Admin" asp-controller="ActivityLog" asp-action="Index"><i class="bi bi-clock-history sidebar-link-icon"></i><span>@Localizer["Activity Log"]</span></a>
        }
        @if (User.IsInRole("Teacher"))
        {
            <div class="sidebar-section">@Localizer["NavSectionTeacher"]</div>
            <a class="sidebar-link @Active("Teacher", "Dashboard")" asp-area="Teacher" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill sidebar-link-icon"></i><span>@Localizer["Dashboard"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Groups")" asp-area="Teacher" asp-controller="Groups" asp-action="Index"><i class="bi bi-collection-fill sidebar-link-icon"></i><span>@Localizer["My Groups"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Students")" asp-area="Teacher" asp-controller="Students" asp-action="Index"><i class="bi bi-people-fill sidebar-link-icon"></i><span>@Localizer["Students"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Lessons")" asp-area="Teacher" asp-controller="Lessons" asp-action="Index"><i class="bi bi-easel2-fill sidebar-link-icon"></i><span>@Localizer["Lessons"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Attendance")" asp-area="Teacher" asp-controller="Attendance" asp-action="Index"><i class="bi bi-clipboard2-check-fill sidebar-link-icon"></i><span>@Localizer["Attendance"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Grades")" asp-area="Teacher" asp-controller="Grades" asp-action="Index"><i class="bi bi-journal-check sidebar-link-icon"></i><span>@Localizer["Grades"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Topics")" asp-area="Teacher" asp-controller="Topics" asp-action="Index"><i class="bi bi-book-half sidebar-link-icon"></i><span>@Localizer["Topics"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Schedule")" asp-area="Teacher" asp-controller="Schedule" asp-action="Index"><i class="bi bi-calendar3-week-fill sidebar-link-icon"></i><span>@Localizer["Schedule"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Salary")" asp-area="Teacher" asp-controller="Salary" asp-action="Index"><i class="bi bi-cash-stack sidebar-link-icon"></i><span>@Localizer["My Salary"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Leaderboard")" asp-area="Teacher" asp-controller="Leaderboard" asp-action="Index"><i class="bi bi-trophy-fill sidebar-link-icon"></i><span>@Localizer["Leaderboard"]</span></a>
            <a class="sidebar-link @Active("Teacher", "Calendar")" asp-area="Teacher" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar-event-fill sidebar-link-icon"></i><span>@Localizer["School Calendar"]</span></a>
        }
        @if (User.IsInRole("Parent"))
        {
            <div class="sidebar-section">@Localizer["NavSectionParent"]</div>
            <a class="sidebar-link @Active("Parent", "Dashboard")" asp-area="Parent" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill sidebar-link-icon"></i><span>@Localizer["Dashboard"]</span></a>
            <a class="sidebar-link @Active("Parent", "Child")" asp-area="Parent" asp-controller="Child" asp-action="Details"><i class="bi bi-person-badge-fill sidebar-link-icon"></i><span>@Localizer["My Child"]</span></a>
            <a class="sidebar-link @Active("Parent", "Schedule")" asp-area="Parent" asp-controller="Schedule" asp-action="Index"><i class="bi bi-calendar3-week-fill sidebar-link-icon"></i><span>@Localizer["Schedule"]</span></a>
            <a class="sidebar-link @Active("Parent", "Grades")" asp-area="Parent" asp-controller="Grades" asp-action="Index"><i class="bi bi-journal-check sidebar-link-icon"></i><span>@Localizer["Grades"]</span></a>
            <a class="sidebar-link @Active("Parent", "Attendance")" asp-area="Parent" asp-controller="Attendance" asp-action="Index"><i class="bi bi-clipboard2-check-fill sidebar-link-icon"></i><span>@Localizer["Attendance"]</span></a>
            <a class="sidebar-link @Active("Parent", "Subjects")" asp-area="Parent" asp-controller="Subjects" asp-action="Index"><i class="bi bi-book-fill sidebar-link-icon"></i><span>@Localizer["Subjects"]</span></a>
            <a class="sidebar-link @Active("Parent", "Topics")" asp-area="Parent" asp-controller="Topics" asp-action="Index"><i class="bi bi-book-half sidebar-link-icon"></i><span>@Localizer["Topics"]</span></a>
            <a class="sidebar-link @Active("Parent", "Progress")" asp-area="Parent" asp-controller="Progress" asp-action="Index"><i class="bi bi-graph-up-arrow sidebar-link-icon"></i><span>@Localizer["Progress"]</span></a>
            <a class="sidebar-link @Active("Parent", "Leaderboard")" asp-area="Parent" asp-controller="Leaderboard" asp-action="Index"><i class="bi bi-trophy-fill sidebar-link-icon"></i><span>@Localizer["Leaderboard"]</span></a>
            <a class="sidebar-link @Active("Parent", "Calendar")" asp-area="Parent" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar-event-fill sidebar-link-icon"></i><span>@Localizer["School Calendar"]</span></a>
        }
        </nav>
    </aside>
    <button type="button" id="sidebarBackdrop" class="sidebar-backdrop" aria-hidden="true" tabindex="-1"></button>
}
<div class="main-wrapper">
    <header class="topbar">
        <div class="topbar-title-group">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button" id="sidebarToggle" class="btn-mobile-menu" aria-label="@Localizer["Menu"]" aria-controls="appSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
            }
            <button type="button" id="backButton" class="btn-back" aria-label="@Localizer["Back"]" title="@Localizer["Back"]"><i class="bi bi-arrow-left"></i></button>
            <h5 class="topbar-title">@ViewData["Title"]</h5>
        </div>
        <div class="topbar-user">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a id="notificationBell" asp-area="" asp-controller="Notifications" asp-action="Index" class="notification-bell" title="@Localizer["Notifications"]">
                <i class="bi bi-bell-fill"></i>
                @if (notificationCount > 0)
                {
                    <span id="notificationCountBadge" class="notification-count">@(notificationCount > 99 ? "99+" : notificationCount)</span>
                }
            </a>

            <div class="lang-dropdown" id="langDropdown">
                <button type="button" id="langDropdownToggle" class="notification-bell" title="@Localizer["Language"]" aria-haspopup="true" aria-expanded="false" aria-controls="langDropdownMenu">
                    <i class="bi bi-translate"></i>
                </button>
                <div id="langDropdownMenu" class="lang-dropdown-menu" role="menu">
                    <form asp-area="" asp-controller="Home" asp-action="SetCulture" method="post">
                        <input type="hidden" name="culture" value="en-US" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" role="menuitem" class="lang-dropdown-item @(currentCulture == "en-US" ? "active" : "")">
                            <span class="lang-dropdown-code">EN</span><span>English</span>
                            @if (currentCulture == "en-US") { <i class="bi bi-check-lg"></i> }
                        </button>
                    </form>
                    <form asp-area="" asp-controller="Home" asp-action="SetCulture" method="post">
                        <input type="hidden" name="culture" value="ru-RU" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" role="menuitem" class="lang-dropdown-item @(currentCulture == "ru-RU" ? "active" : "")">
                            <span class="lang-dropdown-code">RU</span><span>Русский</span>
                            @if (currentCulture == "ru-RU") { <i class="bi bi-check-lg"></i> }
                        </button>
                    </form>
                    <form asp-area="" asp-controller="Home" asp-action="SetCulture" method="post">
                        <input type="hidden" name="culture" value="tg-TJ" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" role="menuitem" class="lang-dropdown-item @(currentCulture == "tg-TJ" ? "active" : "")">
                            <span class="lang-dropdown-code">TJ</span><span>Тоҷикӣ</span>
                            @if (currentCulture == "tg-TJ") { <i class="bi bi-check-lg"></i> }
                        </button>
                    </form>
                </div>
            </div>

            <div class="user-info">
                <div class="user-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper())</div>
                <div class="user-details">
                    <span class="user-email">@User.Identity.Name</span>
                    <span class="user-role">
                        @if (User.IsInRole("Admin")) { <text>@Localizer["Administrator"]</text> }
                        else if (User.IsInRole("Director")) { <text>@Localizer["Director"]</text> }
                        else if (User.IsInRole("Teacher")) { <text>@Localizer["Teacher"]</text> }
                        else if (User.IsInRole("Parent")) { <text>@Localizer["Parent"]</text> }
                    </span>
                </div>
            </div>

            <button type="button" id="themeToggle" class="btn-theme" aria-label="@Localizer["Toggle dark mode"]"><i id="themeIcon" class="bi bi-moon-stars-fill"></i></button>
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post"><button type="submit" class="btn-logout"><i class="bi bi-box-arrow-right"></i><span>@Localizer["Logout"]</span></button></form>
        }
        else
        {
            <a asp-area="" asp-controller="Auth" asp-action="Login" class="btn btn-primary">@Localizer["Login"]</a>
        }
        </div>
    </header>

    <main class="page-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </main>
</div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <partial name="_AiAssistantWidget" />
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/pwa.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
    const themeToggle = document.getElementById("themeToggle");
    const themeIcon = document.getElementById("themeIcon");
    function applyTheme(theme) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("school-theme", theme);
        if (themeIcon) {
            themeIcon.className = theme === "dark"
                ? "bi bi-sun-fill"
                : "bi bi-moon-stars-fill";
        }
    }
    applyTheme(localStorage.getItem("school-theme") || "dark");
    if (themeToggle) themeToggle.onclick = () => applyTheme(document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark");

    const backButton = document.getElementById("backButton");
    if (backButton) backButton.onclick = () => history.back();

    const notificationBell = document.getElementById("notificationBell");
    if (notificationBell) {
        notificationBell.addEventListener("click", () => {
            document.getElementById("notificationCountBadge")?.remove();
        });
    }

    if (window.location.pathname.toLowerCase().startsWith("/notifications")) {
        document.getElementById("notificationCountBadge")?.remove();
    }

    const langDropdown = document.getElementById("langDropdown");
    const langDropdownToggle = document.getElementById("langDropdownToggle");
    if (langDropdown && langDropdownToggle) {
        const closeLangDropdown = () => {
            langDropdown.classList.remove("open");
            langDropdownToggle.setAttribute("aria-expanded", "false");
        };
        langDropdownToggle.addEventListener("click", (event) => {
            event.stopPropagation();
            const isOpen = langDropdown.classList.toggle("open");
            langDropdownToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
        });
        document.addEventListener("click", (event) => {
            if (!langDropdown.contains(event.target)) closeLangDropdown();
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeLangDropdown();
        });
    }
</script>
</body>
</html>