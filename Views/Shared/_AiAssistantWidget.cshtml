<div id="aiAssistant" class="ai-assistant">
    <button type="button" id="aiAssistantToggle" class="ai-assistant-toggle" aria-label="@Localizer["AI Assistant"]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4z"></path>
            <path d="M6 12h12M6 12a6 6 0 0 0-2 4.5V20h16v-3.5A6 6 0 0 0 18 12"></path>
        </svg>
        <span id="aiAssistantBadge" class="ai-assistant-badge" hidden>1</span>
    </button>

    <div id="aiAssistantPanel" class="ai-assistant-panel" hidden>
        <div class="ai-assistant-header">
            <div class="ai-assistant-header-info">
                <div class="ai-assistant-avatar">AI</div>
                <div>
                    <div class="ai-assistant-title">@Localizer["AI Assistant"]</div>
                    <div class="ai-assistant-subtitle">@Localizer["Ask about your data or how to use the portal"]</div>
                </div>
            </div>
            <button type="button" id="aiAssistantClose" class="ai-assistant-close" aria-label="@Localizer["Close"]">&times;</button>
        </div>

        <div id="aiAssistantMessages" class="ai-assistant-messages"></div>

        <form id="aiAssistantForm" class="ai-assistant-input-row" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="text" id="aiAssistantInput" class="ai-assistant-input" placeholder="@Localizer["Type your question..."]" maxlength="1000" />
            <button type="submit" class="ai-assistant-send" aria-label="@Localizer["Send"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 2L11 13"></path>
                    <path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
                </svg>
            </button>
        </form>
    </div>
</div>

<script src="~/js/assistant.js" asp-append-version="true"
        data-greeting="@Localizer["Hi! I can answer questions about your data or help you find your way around the portal. What would you like to know?"]"
        data-error="@Localizer["Something went wrong. Please try again."]">
</script>
