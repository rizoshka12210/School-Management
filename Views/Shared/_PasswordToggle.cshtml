@{
    /* Wraps a sibling <input asp-for="Password"> - see .password-field usage
       in Teachers/_Form.cshtml and Parents/_Form.cshtml. Auto-wired by the
       generic .password-toggle handler in site.js, no id coordination needed. */
}
<button type="button"
        class="password-toggle"
        aria-label="@Localizer["Show password"]"
        aria-pressed="false"
        data-show-label="@Localizer["Show password"]"
        data-hide-label="@Localizer["Hide password"]">
    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path>
        <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a20.3 20.3 0 0 1 5.06-6.06M9.9 4.24A10.4 10.4 0 0 1 12 4c7 0 11 8 11 8a20.3 20.3 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
        <line x1="1" y1="1" x2="23" y2="23"></line>
    </svg>
</button>
