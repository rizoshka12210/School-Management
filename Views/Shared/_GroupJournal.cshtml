@using SchoolManagementSystem.Web.Models.Enums
@model SchoolManagementSystem.Web.ViewModels.Shared.GroupJournalViewModel

@{
    var isRussian = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var isTeacher = string.Equals(area, "Teacher", StringComparison.OrdinalIgnoreCase);
    string T(string english, string russian) => isRussian ? russian : Localizer[english].Value;

    ViewData["Title"] = $"{T("Journal", "Журнал")} · {Model.GroupName}";
    var entryIndex = 0;
    var weekIndex = 0;
    var attendanceHeader = isRussian ? "Пос." : "Att";
    var lateMark = isRussian ? "О" : "L";
    var excusedMark = isRussian ? "У" : "E";

    string AttendanceClass(AttendanceStatus? status) => status switch
    {
        AttendanceStatus.Present => "status-present",
        AttendanceStatus.Absent => "status-absent",
        AttendanceStatus.Late => "status-late",
        AttendanceStatus.Excused => "status-excused",
        _ => string.Empty
    };

    string GradeClass(int? value) => value.HasValue
        ? $"grade-{value.Value}"
        : string.Empty;
}

<link rel="stylesheet" href="~/css/group-journal.css" asp-append-version="true" />

<div class="group-journal-page">
    <div class="journal-page-head">
        <div class="journal-page-head-left">
            <a asp-action="Details" asp-route-id="@Model.GroupId" class="journal-back">
                <i class="bi bi-arrow-left"></i>
                @T("Back to group", "Назад к группе")
            </a>

            <h1 class="journal-title">@T("Journal", "Журнал") · @Model.GroupName</h1>
            <p class="journal-subtitle">
                @if (isTeacher)
                {
                    @T("Attendance and grades in one place. Each column is one of your lessons for this group.", "Посещаемость и оценки в одном месте. Каждый столбец — один из ваших уроков для этой группы.")
                }
                else
                {
                    @T("Attendance and grades in one place. Each column is a real lesson from the schedule.", "Посещаемость и оценки в одном месте. Каждый столбец — реальный урок из расписания.")
                }
            </p>
        </div>

        <form method="get" asp-action="Journal" class="journal-range-form">
            <input type="hidden" name="id" value="@Model.GroupId" />
            <label for="journalWeeks">@Localizer["Show"]</label>
            <select id="journalWeeks" name="weeks" class="form-select" onchange="this.form.submit()">
                <option value="4" selected="@(Model.WeeksRequested == 4 ? "selected" : null)">4 @T("weeks", "нед.")</option>
                <option value="8" selected="@(Model.WeeksRequested == 8 ? "selected" : null)">8 @T("weeks", "нед.")</option>
                <option value="12" selected="@(Model.WeeksRequested == 12 ? "selected" : null)">12 @T("weeks", "нед.")</option>
                <option value="16" selected="@(Model.WeeksRequested == 16 ? "selected" : null)">16 @T("weeks", "нед.")</option>
            </select>
        </form>
    </div>

    <div class="journal-stats">
        <div class="journal-stat">
            <div class="journal-stat-icon students"><i class="bi bi-people-fill"></i></div>
            <div class="journal-stat-copy">
                <span>@Localizer["Students"]</span>
                <strong>@Model.TotalStudents</strong>
                <small>@Model.GroupName</small>
            </div>
        </div>

        <div class="journal-stat">
            <div class="journal-stat-icon lessons"><i class="bi bi-easel2-fill"></i></div>
            <div class="journal-stat-copy">
                <span>@Localizer["Lessons"]</span>
                <strong>@Model.TotalLessons</strong>
                <small>
                    @(isTeacher
                        ? T("Your lessons shown here", "Здесь показаны ваши уроки")
                        : T("Shown in this journal", "Показано в журнале"))
                </small>
            </div>
        </div>

        <div class="journal-stat">
            <div class="journal-stat-icon attendance"><i class="bi bi-clipboard2-check-fill"></i></div>
            <div class="journal-stat-copy">
                <span>@Localizer["Attendance"]</span>
                <strong>@Model.AttendanceRate.ToString("0.#")%</strong>
                <small>@Model.MarkedAttendanceCount @T("marked entries", "отмечено")</small>
            </div>
        </div>

        <div class="journal-stat">
            <div class="journal-stat-icon grade"><i class="bi bi-star-fill"></i></div>
            <div class="journal-stat-copy">
                <span>@Localizer["Average Grade"]</span>
                <strong>@(Model.AverageGrade?.ToString("0.00") ?? "—")</strong>
                <small>@Model.GradedEntriesCount @T("grades", "оценок")</small>
            </div>
        </div>
    </div>

    <div class="journal-legend">
        <span><i class="present"></i>@Localizer["Present"]</span>
        <span><i class="absent"></i>@Localizer["Absent"]</span>
        <span><i class="late"></i>@Localizer["Late"]</span>
        <span><i class="excused"></i>@Localizer["Excused"]</span>
    </div>

    @if (!Model.Weeks.Any())
    {
        <div class="journal-empty">
            <div class="journal-empty-icon"><i class="bi bi-journal-x"></i></div>
            <h3>@Localizer["No lessons yet"]</h3>
            <p>
                @if (isTeacher)
                {
                    @T("When lessons are created for this group, they will automatically appear here as journal columns.", "Когда для этой группы будут созданы уроки, они автоматически появятся здесь как столбцы журнала.")
                }
                else
                {
                    @T("Create lessons for this group first. The journal will automatically build columns from lesson dates.", "Сначала создайте уроки для этой группы. Журнал автоматически сформирует столбцы по датам уроков.")
                }
            </p>
        </div>
    }
    else
    {
        <form asp-action="Journal" method="post" id="groupJournalForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="GroupId" value="@Model.GroupId" />
            <input type="hidden" name="Weeks" value="@Model.WeeksRequested" />

            <div class="journal-week-list">
                @foreach (var week in Model.Weeks)
                {
                    var isOpen = week.IsCurrentWeek || weekIndex == 0;

                    <details class="journal-week @(week.IsCurrentWeek ? "current-week" : "")" open="@(isOpen ? "open" : null)">
                        <summary class="journal-week-summary">
                            <div class="journal-week-summary-main">
                                <span class="journal-week-chevron"><i class="bi bi-chevron-down"></i></span>
                                <span class="journal-week-name">
                                    @week.StartDate.ToString("dd.MM.yyyy") — @week.EndDate.ToString("dd.MM.yyyy")
                                </span>
                            </div>

                            <div class="journal-week-badges">
                                @if (week.IsCurrentWeek)
                                {
                                    <span class="journal-week-badge journal-current-badge">
                                        <i class="bi bi-lightning-charge-fill"></i>@T("Current week", "Текущая неделя")
                                    </span>
                                }
                                <span class="journal-week-badge">
                                    <i class="bi bi-easel2"></i>@week.Lessons.Count @T("lessons", "уроков")
                                </span>
                                <span class="journal-week-badge">
                                    <i class="bi bi-people"></i>@week.Students.Count @T("students", "учеников")
                                </span>
                            </div>
                        </summary>

                        <div class="journal-table-scroll">
                            <table class="journal-table">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="journal-student-col">@Localizer["Student"]</th>

                                        @foreach (var lesson in week.Lessons)
                                        {
                                            <th colspan="2" class="journal-lesson-head" title="@lesson.TeacherName@(string.IsNullOrWhiteSpace(lesson.Topic) ? "" : " · " + lesson.Topic)">
                                                <span class="journal-lesson-date">@lesson.StartTime.ToString("dd.MM · HH:mm")</span>
                                                <span class="journal-lesson-subject">@lesson.SubjectName</span>
                                            </th>
                                        }

                                        <th rowspan="2" class="journal-summary-col">@T("Average", "Среднее")</th>
                                    </tr>
                                    <tr>
                                        @foreach (var lesson in week.Lessons)
                                        {
                                            <th class="journal-subhead-att">@attendanceHeader</th>
                                            <th class="journal-subhead-grade">@Localizer["Grade"]</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in week.Students)
                                    {
                                        <tr>
                                            <td class="journal-student-col journal-student-cell">
                                                <div class="journal-student-main">
                                                    <span class="journal-student-avatar">
                                                        @(string.IsNullOrWhiteSpace(row.StudentName) ? "S" : row.StudentName.Substring(0, 1).ToUpper())
                                                    </span>
                                                    <span>
                                                        <span class="journal-student-name">@row.StudentName</span>
                                                        <span class="journal-student-id">ID @row.StudentId</span>
                                                    </span>
                                                </div>
                                            </td>

                                            @foreach (var cell in row.Cells)
                                            {
                                                var currentIndex = entryIndex++;

                                                <td>
                                                    <input type="hidden" name="Entries[@currentIndex].StudentId" value="@cell.StudentId" />
                                                    <input type="hidden" name="Entries[@currentIndex].LessonId" value="@cell.LessonId" />

                                                    <select name="Entries[@currentIndex].AttendanceStatus"
                                                            class="journal-select journal-attendance-select @AttendanceClass(cell.AttendanceStatus)"
                                                            aria-label="@Localizer["Attendance"]">
                                                        <option value="" selected="@(!cell.AttendanceStatus.HasValue ? "selected" : null)">—</option>
                                                        <option value="@((int)AttendanceStatus.Present)" selected="@(cell.AttendanceStatus == AttendanceStatus.Present ? "selected" : null)">✓</option>
                                                        <option value="@((int)AttendanceStatus.Absent)" selected="@(cell.AttendanceStatus == AttendanceStatus.Absent ? "selected" : null)">✕</option>
                                                        <option value="@((int)AttendanceStatus.Late)" selected="@(cell.AttendanceStatus == AttendanceStatus.Late ? "selected" : null)">@lateMark</option>
                                                        <option value="@((int)AttendanceStatus.Excused)" selected="@(cell.AttendanceStatus == AttendanceStatus.Excused ? "selected" : null)">@excusedMark</option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select name="Entries[@currentIndex].GradeValue"
                                                            class="journal-select journal-grade-select @GradeClass(cell.GradeValue)"
                                                            aria-label="@Localizer["Grade"]">
                                                        <option value="" selected="@(!cell.GradeValue.HasValue ? "selected" : null)">—</option>
                                                        @for (var grade = 5; grade >= 1; grade--)
                                                        {
                                                            <option value="@grade" selected="@(cell.GradeValue == grade ? "selected" : null)">@grade</option>
                                                        }
                                                    </select>
                                                </td>
                                            }

                                            <td class="journal-summary-col">
                                                <div class="journal-row-summary">
                                                    <strong>@(row.AverageGrade?.ToString("0.00") ?? "—")</strong>
                                                    <span>@row.AttendanceRate.ToString("0.#")% @T("attendance", "посещаемость")</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>

                    weekIndex++;
                }
            </div>

            <div class="journal-save-bar" id="journalSaveBar">
                <div class="journal-save-copy">
                    <strong>
                        <span class="journal-unsaved-dot"></span>
                        <span id="journalSaveTitle">@T("Journal is ready", "Журнал готов")</span>
                    </strong>
                    <span id="journalSaveHint">@T("Change attendance or a grade, then save all changes at once.", "Измените посещаемость или оценку, затем сохраните все изменения одной кнопкой.")</span>
                </div>

                <button type="submit" class="btn btn-primary journal-save-button">
                    <i class="bi bi-check2-circle"></i>
                    @T("Save journal", "Сохранить журнал")
                </button>
            </div>
        </form>
    }
</div>

<script>
    (() => {
        const form = document.getElementById("groupJournalForm");
        if (!form) return;

        const saveBar = document.getElementById("journalSaveBar");
        const saveTitle = document.getElementById("journalSaveTitle");
        const saveHint = document.getElementById("journalSaveHint");

        const attendanceClasses = [
            "status-present",
            "status-absent",
            "status-late",
            "status-excused"
        ];

        const gradeClasses = ["grade-1", "grade-2", "grade-3", "grade-4", "grade-5"];

        const refreshAttendanceStyle = select => {
            attendanceClasses.forEach(value => select.classList.remove(value));

            const className = {
                "1": "status-present",
                "2": "status-absent",
                "3": "status-late",
                "4": "status-excused"
            }[select.value];

            if (className) select.classList.add(className);
        };

        const refreshGradeStyle = select => {
            gradeClasses.forEach(value => select.classList.remove(value));
            if (select.value) select.classList.add(`grade-${select.value}`);
        };

        const markDirty = () => {
            saveBar?.classList.add("is-dirty");
            if (saveTitle) saveTitle.textContent = "@T("Unsaved changes", "Несохранённые изменения")";
            if (saveHint) saveHint.textContent = "@T("Save the journal so attendance and grades are written to the database.", "Сохраните журнал, чтобы посещаемость и оценки были записаны в базу данных.")";
        };

        form.querySelectorAll(".journal-attendance-select").forEach(select => {
            refreshAttendanceStyle(select);
            select.addEventListener("change", () => {
                refreshAttendanceStyle(select);
                markDirty();
            });
        });

        form.querySelectorAll(".journal-grade-select").forEach(select => {
            refreshGradeStyle(select);
            select.addEventListener("change", () => {
                refreshGradeStyle(select);
                markDirty();
            });
        });
    })();
</script>
