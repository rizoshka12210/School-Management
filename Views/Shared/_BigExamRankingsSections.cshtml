@using SchoolManagementSystem.Web.Services
@using SchoolManagementSystem.Web.Models.Entities
@model List<BigExamRankingEntry>

@{
    var blacklistThreshold = (ViewBag.Exam as BigExam)?.BlacklistThreshold;

    string RowClass(decimal score) =>
        blacklistThreshold.HasValue && score < blacklistThreshold.Value
            ? "big-exam-blacklisted"
            : string.Empty;

    var byGroup = Model
        .GroupBy(e => new { e.GroupId, e.GroupName })
        .OrderBy(g => g.Key.GroupName)
        .ToList();

    // Subject columns are only populated on Overall Total entries -
    // collect the distinct set (any entry's breakdown has them all)
    // so every row renders the same columns in the same order.
    var subjectColumns = Model
        .SelectMany(e => e.SubjectBreakdown)
        .GroupBy(s => new { s.SubjectId, s.SubjectName })
        .Select(g => g.Key)
        .OrderBy(s => s.SubjectName)
        .ToList();

    string ScoreClass(decimal? score) => score switch
    {
        null => string.Empty,
        >= 90 => "grade-high",
        >= 75 => "grade-good",
        _ => "grade-low"
    };

    string Band(int index) => index % 2 == 0 ? "big-exam-band-a" : "big-exam-band-b";

    var sectionId = Guid.NewGuid().ToString("N");
}

<div class="big-exam-rankings">
@if (!Model.Any())
{
    <div class="management-empty">
        <div class="management-empty-icon"><i class="bi bi-bar-chart"></i></div>
        <h5>@Localizer["No scores yet"]</h5>
        <p>@Localizer["Rankings will appear once grades are entered."]</p>
    </div>
}
else
{
    <div class="teacher-grade-subject-tabs mb-4" data-big-exam-scope="@sectionId">
        <button type="button" class="teacher-grade-subject-tab active" data-scope-target="center">
            <i class="bi bi-globe-americas"></i>
            @Localizer["Whole Center"]
        </button>
        <button type="button" class="teacher-grade-subject-tab" data-scope-target="group">
            <i class="bi bi-collection-fill"></i>
            @Localizer["By Group"]
        </button>
    </div>

    <div data-scope-panel="center" data-scope-id="@sectionId">
        <div class="table-responsive big-exam-table-wrap">
            <table class="table table-hover management-table big-exam-table">
                <thead>
                    <tr>
                        <th rowspan="2" class="big-exam-rank-col">@Localizer["Overall Rank"]</th>
                        <th rowspan="2">@Localizer["Student"]</th>
                        <th rowspan="2">@Localizer["Group"]</th>
                        @for (var i = 0; i < subjectColumns.Count; i++)
                        {
                            <th colspan="2" class="big-exam-subject-header @Band(i)">@subjectColumns[i].SubjectName</th>
                        }
                        <th rowspan="2" class="big-exam-total-col">@Localizer["Score"]</th>
                    </tr>
                    @if (subjectColumns.Any())
                    {
                        <tr>
                            @for (var i = 0; i < subjectColumns.Count; i++)
                            {
                                <th class="big-exam-subcol @Band(i)">@Localizer["Raw"]</th>
                                <th class="big-exam-subcol big-exam-subcol-last @Band(i)">@Localizer["Score"]</th>
                            }
                        </tr>
                    }
                </thead>
                <tbody>
                    @foreach (var entry in Model.OrderBy(e => e.OverallRank).ThenBy(e => e.StudentName))
                    {
                        var bySubject = entry.SubjectBreakdown.ToDictionary(s => s.SubjectId);

                        <tr class="@RowClass(entry.Score)">
                            <td class="big-exam-rank-col"><span class="big-exam-rank-badge @(entry.OverallRank == 1 ? "is-first" : "")">#@entry.OverallRank</span> <span class="text-muted small">@Localizer["of {0}", entry.OverallSize]</span></td>
                            <td>
                                <strong>@entry.StudentName</strong>
                                @if (!string.IsNullOrEmpty(RowClass(entry.Score)))
                                {
                                    <span class="big-exam-blacklist-badge" title="@Localizer["Below the blacklist threshold"]">
                                        <i class="bi bi-flag-fill"></i>
                                    </span>
                                }
                            </td>
                            <td><span class="subject-badge">@entry.GroupName</span></td>
                            @for (var i = 0; i < subjectColumns.Count; i++)
                            {
                                bySubject.TryGetValue(subjectColumns[i].SubjectId, out var s);
                                <td class="big-exam-subcol text-center @Band(i)">
                                    <span class="big-exam-raw">@(s?.RawScore?.ToString("0.##") ?? "—")</span>
                                </td>
                                <td class="big-exam-subcol big-exam-subcol-last text-center @Band(i)">
                                    @if (s?.WeightedScore.HasValue == true)
                                    {
                                        <span class="grade-badge @ScoreClass(s.WeightedScore)">@s.WeightedScore.Value.ToString("0.###")</span>
                                    }
                                    else
                                    {
                                        <span class="big-exam-raw">—</span>
                                    }
                                </td>
                            }
                            <td class="big-exam-total-col">
                                <span class="grade-badge big-exam-total-badge @ScoreClass(entry.Score)">
                                    @entry.Score.ToString("0.##")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div data-scope-panel="group" data-scope-id="@sectionId" hidden>
        @foreach (var group in byGroup)
        {
            <div class="card border-0 shadow-sm mb-3 big-exam-group-card">
                <div class="card-body">
                    <h6 class="section-title mb-3"><i class="bi bi-collection-fill"></i> @group.Key.GroupName</h6>
                    <div class="table-responsive big-exam-table-wrap">
                        <table class="table table-hover management-table big-exam-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="big-exam-rank-col">@Localizer["Group Rank"]</th>
                                    <th rowspan="2">@Localizer["Student"]</th>
                                    @for (var i = 0; i < subjectColumns.Count; i++)
                                    {
                                        <th colspan="2" class="big-exam-subject-header @Band(i)">@subjectColumns[i].SubjectName</th>
                                    }
                                    <th rowspan="2" class="big-exam-total-col">@Localizer["Score"]</th>
                                </tr>
                                @if (subjectColumns.Any())
                                {
                                    <tr>
                                        @for (var i = 0; i < subjectColumns.Count; i++)
                                        {
                                            <th class="big-exam-subcol @Band(i)">@Localizer["Raw"]</th>
                                            <th class="big-exam-subcol big-exam-subcol-last @Band(i)">@Localizer["Score"]</th>
                                        }
                                    </tr>
                                }
                            </thead>
                            <tbody>
                                @foreach (var entry in group.OrderBy(e => e.GroupRank).ThenBy(e => e.StudentName))
                                {
                                    var bySubject = entry.SubjectBreakdown.ToDictionary(s => s.SubjectId);

                                    <tr class="@RowClass(entry.Score)">
                                        <td class="big-exam-rank-col"><span class="big-exam-rank-badge @(entry.GroupRank == 1 ? "is-first" : "")">#@entry.GroupRank</span> <span class="text-muted small">@Localizer["of {0}", entry.GroupSize]</span></td>
                                        <td>
                                            <strong>@entry.StudentName</strong>
                                            @if (!string.IsNullOrEmpty(RowClass(entry.Score)))
                                            {
                                                <span class="big-exam-blacklist-badge" title="@Localizer["Below the blacklist threshold"]">
                                                    <i class="bi bi-flag-fill"></i>
                                                </span>
                                            }
                                        </td>
                                        @for (var i = 0; i < subjectColumns.Count; i++)
                                        {
                                            bySubject.TryGetValue(subjectColumns[i].SubjectId, out var s);
                                            <td class="big-exam-subcol text-center @Band(i)">
                                                <span class="big-exam-raw">@(s?.RawScore?.ToString("0.##") ?? "—")</span>
                                            </td>
                                            <td class="big-exam-subcol big-exam-subcol-last text-center @Band(i)">
                                                @if (s?.WeightedScore.HasValue == true)
                                                {
                                                    <span class="grade-badge @ScoreClass(s.WeightedScore)">@s.WeightedScore.Value.ToString("0.###")</span>
                                                }
                                                else
                                                {
                                                    <span class="big-exam-raw">—</span>
                                                }
                                            </td>
                                        }
                                        <td class="big-exam-total-col">
                                            <span class="grade-badge big-exam-total-badge @ScoreClass(entry.Score)">
                                                @entry.Score.ToString("0.##")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>

@if (Model.Any() && !ViewData.ContainsKey("BigExamRankingsScriptRendered"))
{
    ViewData["BigExamRankingsScriptRendered"] = true;

    <script>
        (() => {
            document.querySelectorAll('[data-big-exam-scope]').forEach(tabs => {
                const scopeId = tabs.dataset.bigExamScope;

                tabs.querySelectorAll('.teacher-grade-subject-tab').forEach(btn => {
                    btn.addEventListener('click', () => {
                        tabs.querySelectorAll('.teacher-grade-subject-tab').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');

                        const target = btn.dataset.scopeTarget;
                        document.querySelectorAll(`[data-scope-id="${scopeId}"]`).forEach(panel => {
                            panel.hidden = panel.dataset.scopePanel !== target;
                        });
                    });
                });
            });
        })();
    </script>
}

@if (!ViewData.ContainsKey("BigExamRankingsStyleRendered"))
{
    ViewData["BigExamRankingsStyleRendered"] = true;

    <style>
        .big-exam-rankings .big-exam-table thead tr:first-child th {
            font-size: 12.5px;
        }

        .big-exam-rankings .big-exam-subject-header {
            text-align: center;
            font-weight: 700;
            border-bottom: none;
            letter-spacing: .03em;
        }

        .big-exam-rankings .big-exam-subcol {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .02em;
            padding-top: 6px;
            padding-bottom: 10px;
        }

        .big-exam-rankings .big-exam-band-a {
            background: #f5f7ff;
        }

        .big-exam-rankings .big-exam-band-b {
            background: #f8fafc;
        }

        .big-exam-rankings td.big-exam-band-a,
        .big-exam-rankings td.big-exam-band-b {
            border-bottom: 1px solid #eef1f6;
        }

        .big-exam-rankings .big-exam-subcol-last {
            border-right: 1px solid #e2e8f0;
        }

        .big-exam-rankings .big-exam-raw {
            color: #94a3b8;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .big-exam-rankings .big-exam-total-col {
            background: #eef2ff;
            text-align: center;
            border-left: 2px solid #c7d2fe;
        }

        .big-exam-rankings th.big-exam-total-col {
            color: #4338ca;
            font-weight: 800;
        }

        .big-exam-rankings .big-exam-total-badge {
            width: auto;
            min-width: 56px;
            padding: 0 10px;
            font-size: 15px;
        }

        .big-exam-rankings .big-exam-rank-col {
            white-space: nowrap;
        }

        .big-exam-rankings .big-exam-rank-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 30px;
            padding: 3px 8px;
            border-radius: 999px;
            background: #f1f5f9;
            color: #475569;
            font-weight: 800;
            font-size: 12.5px;
        }

        .big-exam-rankings .big-exam-rank-badge.is-first {
            background: linear-gradient(135deg, #fde68a, #f59e0b);
            color: #78350f;
        }

        .big-exam-rankings .big-exam-group-card .section-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .big-exam-rankings tr.big-exam-blacklisted td {
            background: #1f2430 !important;
            color: #cbd5e1;
        }

        .big-exam-rankings tr.big-exam-blacklisted .big-exam-raw {
            color: #94a3b8;
        }

        .big-exam-rankings tr.big-exam-blacklisted td.big-exam-total-col {
            border-left: 2px solid #475569;
        }

        .big-exam-blacklist-badge {
            display: inline-flex;
            align-items: center;
            margin-left: 6px;
            color: #f87171;
            font-size: 12px;
        }

        html[data-theme="dark"] .big-exam-rankings tr.big-exam-blacklisted td {
            background: #05070c !important;
            color: #94a3b8;
        }

        html[data-theme="dark"] .big-exam-rankings tr.big-exam-blacklisted td.big-exam-total-col {
            border-left: 2px solid #334155;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-band-a {
            background: #131b2e;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-band-b {
            background: #0f1626;
        }

        html[data-theme="dark"] .big-exam-rankings td.big-exam-band-a,
        html[data-theme="dark"] .big-exam-rankings td.big-exam-band-b {
            border-bottom: 1px solid #1e293b;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-subcol-last {
            border-right: 1px solid #253047;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-raw {
            color: #64748b;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-total-col {
            background: #1e1b4b;
            border-left: 2px solid #4338ca;
        }

        html[data-theme="dark"] .big-exam-rankings th.big-exam-total-col {
            color: #c7d2fe;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-rank-badge {
            background: #1e293b;
            color: #cbd5e1;
        }

        html[data-theme="dark"] .big-exam-rankings .big-exam-rank-badge.is-first {
            background: linear-gradient(135deg, #fbbf24, #d97706);
            color: #451a03;
        }
    </style>
}
