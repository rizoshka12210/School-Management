@using SchoolManagementSystem.Web.ViewModels.Shared
@model List<ExamRankingEntry>

@{
    var blacklistThresholds = ViewBag.ExamBlacklistThresholds as Dictionary<(int GroupId, int SubjectId), decimal>
        ?? new Dictionary<(int, int), decimal>();
    var myStudentIds = ViewBag.MyStudentIds as HashSet<int> ?? new HashSet<int>();

    string RowClass(ExamRankingEntry entry)
    {
        var classes = new List<string>();

        if (blacklistThresholds.TryGetValue((entry.GroupId, entry.SubjectId), out var threshold) &&
            entry.Score < threshold)
        {
            classes.Add("exam-blacklisted");
        }

        if (myStudentIds.Contains(entry.StudentId))
        {
            classes.Add("exam-row-mine");
        }

        return string.Join(" ", classes);
    }

    string RankBadgeClass(int rank) => rank switch
    {
        1 => "leaderboard-rank-1",
        2 => "leaderboard-rank-2",
        3 => "leaderboard-rank-3",
        _ => "leaderboard-rank-other"
    };

    var byGroup = Model
        .GroupBy(e => new { e.GroupId, e.GroupName })
        .OrderBy(g => g.Key.GroupName)
        .ToList();

    var sectionId = Guid.NewGuid().ToString("N");
}

<div class="exam-rankings">
@if (!Model.Any())
{
    <div class="management-empty">
        <div class="management-empty-icon"><i class="bi bi-bar-chart"></i></div>
        <h5>@Localizer["No scores yet"]</h5>
        <p>@Localizer["Rankings will appear once grades are entered."]</p>
    </div>
}
else
{
    <div class="teacher-grade-subject-tabs mb-4" data-exam-rankings-scope="@sectionId">
        <button type="button" class="teacher-grade-subject-tab active" data-scope-target="center">
            <i class="bi bi-globe-americas"></i>
            @Localizer["Whole Center"]
        </button>
        <button type="button" class="teacher-grade-subject-tab" data-scope-target="group">
            <i class="bi bi-collection-fill"></i>
            @Localizer["By Group"]
        </button>
    </div>

    <div data-scope-panel="center" data-scope-id="@sectionId">
        <div class="table-responsive">
            <table class="table table-hover management-table">
                <thead>
                    <tr>
                        <th>@Localizer["Overall Rank"]</th>
                        <th>@Localizer["Student"]</th>
                        <th>@Localizer["Group"]</th>
                        <th>@Localizer["Score"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.OrderBy(e => e.OverallRank).ThenBy(e => e.StudentName))
                    {
                        <tr class="@RowClass(entry)">
                            <td class="text-nowrap">
                                <span class="leaderboard-rank @RankBadgeClass(entry.OverallRank)">@entry.OverallRank</span>
                                <span class="text-muted small">@Localizer["of {0}", entry.OverallSize]</span>
                            </td>
                            <td>
                                <strong>@entry.StudentName</strong>
                                @if (myStudentIds.Contains(entry.StudentId))
                                {
                                    <span class="my-child-badge"><i class="bi bi-star-fill"></i> @Localizer["Your child"]</span>
                                }
                            </td>
                            <td><span class="subject-badge">@entry.GroupName</span></td>
                            <td><span class="grade-badge grade-neutral">@entry.Score.ToString("0.##")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div data-scope-panel="group" data-scope-id="@sectionId" hidden>
        @foreach (var group in byGroup)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="section-title mb-3"><i class="bi bi-collection-fill"></i> @group.Key.GroupName</h6>
                    <div class="table-responsive">
                        <table class="table table-hover management-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Group Rank"]</th>
                                    <th>@Localizer["Student"]</th>
                                    <th>@Localizer["Score"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in group.OrderBy(e => e.GroupRank).ThenBy(e => e.StudentName))
                                {
                                    <tr class="@RowClass(entry)">
                                        <td class="text-nowrap">
                                            <span class="leaderboard-rank @RankBadgeClass(entry.GroupRank)">@entry.GroupRank</span>
                                            <span class="text-muted small">@Localizer["of {0}", entry.GroupSize]</span>
                                        </td>
                                        <td>
                                            <strong>@entry.StudentName</strong>
                                            @if (myStudentIds.Contains(entry.StudentId))
                                            {
                                                <span class="my-child-badge"><i class="bi bi-star-fill"></i> @Localizer["Your child"]</span>
                                            }
                                        </td>
                                        <td><span class="grade-badge grade-neutral">@entry.Score.ToString("0.##")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>

@if (Model.Any() && !ViewData.ContainsKey("ExamRankingsScriptRendered"))
{
    ViewData["ExamRankingsScriptRendered"] = true;

    <script>
        (() => {
            document.querySelectorAll('[data-exam-rankings-scope]').forEach(tabs => {
                const scopeId = tabs.dataset.examRankingsScope;

                tabs.querySelectorAll('.teacher-grade-subject-tab').forEach(btn => {
                    btn.addEventListener('click', () => {
                        tabs.querySelectorAll('.teacher-grade-subject-tab').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');

                        const target = btn.dataset.scopeTarget;
                        document.querySelectorAll(`[data-scope-id="${scopeId}"]`).forEach(panel => {
                            panel.hidden = panel.dataset.scopePanel !== target;
                        });
                    });
                });
            });
        })();
    </script>
}
